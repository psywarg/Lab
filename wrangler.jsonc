{
  "name": "projectst",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/index", "/index/", "/api/contact"],
  },
  "observability": {
    "enabled": true,
  },
}
