{
  "name": "projectst",
  "type": "module",
  "version": "3.0.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "imports": {
    "#app.css": "./src/styles/global.css"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "check:build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "preview:cloudflare": "astro build && wrangler dev",
    "lint": "eslint .",
    "test:unit": "vitest run --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "3.7.3",
