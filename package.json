    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "fontace": "^0.4.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true,
    "sharp@0.35.5": true,
    "workerd@1.20261001.1": true
  }
