# Cloudflare Workers static assets: header rules for asset responses.
# Script and style rules live in the per-page <meta> CSP that Astro builds
# (security.csp in astro.config.ts). This header adds what a <meta> policy
# cannot set; browsers enforce both policies.

/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Permissions-Policy: microphone=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), camera=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
