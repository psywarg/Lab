---
// src/components/site/Footer.astro

import Icons from "@/assets/icons/site-sprites.svg?url";

const socialLinks = [
  { name: "YouTube", icon: "social-youtube", href: "https://www.youtube.com/@SortedTechHQ" },
  { name: "Instagram", icon: "social-instagram", href: "https://www.instagram.com/SortedTechHQ" },
  { name: "X", icon: "social-x", href: "https://x.com/SortedTechHQ" },
  { name: "Telegram", icon: "social-telegram", href: "https://t.me/SortedTechHQ" },
];
---

<footer
  class="text-small from-custom-100 to-custom-300 dark:from-custom-700 dark:to-custom-900 border-accent-500 relative z-20 w-full border-t bg-linear-to-b px-4 py-4 text-center md:px-6"
>
  <div
    class="flex flex-col items-center justify-center gap-x-2 gap-y-0.5 sm:flex-row"
  >
    <span class="font-medium">
      © <span data-footer-year>{new Date().getFullYear()}</span> Sorted Tech
    </span>
    <span aria-hidden="true" class="hidden sm:inline">•</span>
    <span>Insights Beyond Influence</span>
  </div>

  <hr class="bg-custom-500 mx-auto mt-4 h-px w-60 border-none opacity-50" />

  <div
    class="text-small mt-4 flex flex-col items-center justify-center gap-x-2 gap-y-1 sm:flex-row"
  >
    <div class="flex items-center gap-2">
      <a
        href="/about"
        class="relative inline-block after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-right after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out hover:after:origin-bottom-left hover:after:scale-x-100 active:after:origin-bottom-left active:after:scale-x-100"
        >About</a
      >
      <span aria-hidden="true">•</span>
      <a
        href="/contact"
        class="relative inline-block after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-right after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out hover:after:origin-bottom-left hover:after:scale-x-100 active:after:origin-bottom-left active:after:scale-x-100"
        >Contact</a
      >
      <span aria-hidden="true">•</span>
      <a
        href="/editorial"
        class="relative inline-block after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-right after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out hover:after:origin-bottom-left hover:after:scale-x-100 active:after:origin-bottom-left active:after:scale-x-100"
        >Editorial Standards</a
      >
    </div>
    <span aria-hidden="true" class="hidden sm:inline">•</span>
    <div class="flex items-center gap-2">
      <a
        href="/privacy"
        class="relative inline-block after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-right after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out hover:after:origin-bottom-left hover:after:scale-x-100 active:after:origin-bottom-left active:after:scale-x-100"
        >Privacy Policy</a
      >
      <span aria-hidden="true">•</span>
      <a
        href="/terms"
        class="relative inline-block after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-right after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out hover:after:origin-bottom-left hover:after:scale-x-100 active:after:origin-bottom-left active:after:scale-x-100"
        >Terms of Service</a
      >
      <span aria-hidden="true">•</span>
      <button
        type="button"
        data-consent-open
        class="relative inline-block cursor-pointer text-blue-600 dark:text-blue-400 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-right after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out hover:after:origin-bottom-left hover:after:scale-x-100 active:after:origin-bottom-left active:after:scale-x-100"
        >Cookie settings</button
      >
    </div>
  </div>

  <ul class="mt-4 flex items-center justify-center gap-3" aria-label="Sorted Tech on social media">
    {
      socialLinks.map(({ name, icon, href }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="me noopener"
            aria-label={`Sorted Tech on ${name} (opens in a new tab)`}
            class="bg-accent-500/15 text-accent-ink hover:border-accent-600 hover:bg-accent-500 grid size-10 place-items-center rounded-xl border border-transparent transition ease-in-out hover:text-white active:scale-95"
          >
            <svg class="size-5.5" aria-hidden="true">
              <use href={`${Icons}#${icon}`} />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>

  <div
    class="text-xsmall text-custom-500 mt-2 px-4 leading-relaxed"
  >
    Our content is independent, backed by data, and fueled by late-night coffee.
    <a
      href="/disclaimer"
      class="text-custom-500 hover:text-accent-500 hover:decoration-accent-500 underline decoration-dotted"
      aria-label="Read full disclaimer"
    >
      View Disclaimer.
    </a>
  </div>
</footer>

<script>
  // The build-time year goes stale until the next deploy.
  const year = String(new Date().getFullYear());
  document.querySelectorAll("[data-footer-year]").forEach((el) => {
    if (el.textContent !== year) el.textContent = year;
  });

  document
    .querySelector("[data-consent-open]")
    ?.addEventListener("click", () =>
      // Opens the consent banner (listener in BaseLayout).
      document.dispatchEvent(new CustomEvent("consent:open")),
    );
</script>
