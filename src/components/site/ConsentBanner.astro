---
// src/components/site/ConsentBanner.astro
// Opt-in for Google Analytics. Shown until the visitor chooses, and again
// from "Cookie settings" in the footer.
---

<section
  id="consent-banner"
  aria-labelledby="consent-banner-title"
  hidden
  class="bg-surface border-accent-line shadow-accent-glow text-small fixed inset-x-2 bottom-2 z-50 rounded-2xl border p-4 shadow-lg sm:inset-x-auto sm:right-4 sm:bottom-4 sm:max-w-md"
>
  <h2 id="consent-banner-title" class="text-body m-0 mb-1 font-semibold">
    Analytics cookies
  </h2>
  <p class="m-0 mb-3">
    Can we use Google Analytics to count visits? It sets cookies and helps us
    see which pages are useful. Nothing is loaded unless you accept. See the
    <a href="/privacy" class="underline">Privacy Policy</a>.
  </p>
  <div class="flex justify-end gap-2">
    <button type="button" class="btn-base" data-consent-choice="denied">
      Reject
    </button>
    <button
      type="button"
      class="btn-base bg-accent-500 hover:bg-accent-600 text-white"
      data-consent-choice="granted"
    >
      Accept
    </button>
  </div>
</section>

<script>
  import {
    CONSENT_OPEN_EVENT,
    loadAnalytics,
    readConsent,
    revokeAnalytics,
    writeConsent,
    type ConsentState,
  } from "@/utils/site/analytics";

  const banner = document.getElementById("consent-banner");
  const consent = readConsent();

  if (consent === "granted") loadAnalytics();
  if (banner && consent === null) banner.hidden = false;

  banner
    ?.querySelectorAll<HTMLButtonElement>("[data-consent-choice]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const choice = button.dataset.consentChoice as ConsentState;
        writeConsent(choice);
        if (choice === "granted") loadAnalytics();
        else revokeAnalytics();
        banner.hidden = true;
      });
    });

  document.addEventListener(CONSENT_OPEN_EVENT, () => {
    if (!banner) return;
    banner.hidden = false;
    banner
      .querySelector<HTMLButtonElement>(
        `[data-consent-choice="${readConsent() ?? "granted"}"]`,
      )
      ?.focus();
  });
</script>
