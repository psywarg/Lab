---
// src/pages/index.astro

export const prerender = true;

import socImage from "@/assets/images/phones/explainers/soc/soc.avif";
import screenToolImage from "@/assets/images/phones/tools/screen-test.avif";
import SortoHome from "@/assets/images/sorto/sorto-home.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { IMAGE_PRESETS } from "@/utils/site/imagePresets";
import { DEFAULT_OG_IMAGE } from "@/utils/site/ogImage";
import { ORGANIZATION_ID, SITE_ORIGIN, WEBSITE_ID } from "@/utils/site/schema";
import { Picture } from "astro:assets";

const title = "Sorted Tech - Insights Beyond Influence";
const metaDescription =
  "Your source for independent insights that bring clarity to the latest in tech, grounded in real understanding and built to help you see beyond the hype.";
const ogImage = DEFAULT_OG_IMAGE;
const spotlightCards = [
  {
    hubLabel: "Explainers",
    heading: "Smartphone System on Chip Explained",
    href: "/phones/explainers/soc",
    description:
      "It begins with one of the most common materials on Earth: sand. Find out how a tiny chip powers everything.",
    image: socImage,
    imageAlt: "Smartphone System on Chip Explained",
    hubHref: "/phones/explainers",
    hubPrefix: "Read ",
    hubAnchor: "our smartphone explainers",
    hubSuffix: " for clear, in-depth insights.",
    accent: "explainers" as const,
  },
  {
    hubLabel: "Tools",
    heading: "Online Display Testing Tool",
    href: "/phones/tools/screen-test",
    description:
      "Run an online screen test with full-screen color, grayscale, gradient, banding, sharpness, black and white level, motion, image retention, and gamma patterns.",
    image: screenToolImage,
    imageAlt: "Display and pixel testing tool",
    hubHref: "/phones/tools",
    hubPrefix: "Try ",
    hubAnchor: "our browser-based tools",
    hubSuffix: " designed to evaluate device without installing anything.",
    accent: "tools" as const,
  },
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${SITE_ORIGIN}/#home`,
  name: title,
  description: metaDescription,
  url: `${SITE_ORIGIN}/`,
  isPartOf: { "@id": WEBSITE_ID },
  about: { "@id": ORGANIZATION_ID },
  publisher: { "@id": ORGANIZATION_ID },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: spotlightCards.length,
    itemListElement: spotlightCards.map((card, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: card.heading,
      url: `${SITE_ORIGIN}${card.href}`,
    })),
  },
};
---

<BaseLayout
  {title}
  {metaDescription}
  {ogImage}
  {structuredData}
  robots="index, follow"
>
  <section class="w-full py-2 md:py-4 lg:py-6">
    <article
      class="from-custom-200 to-custom-100 dark:from-custom-800 dark:to-custom-700 bg-linear-to-b px-6 py-4 shadow-md will-change-auto sm:px-12 md:py-8 lg:py-12"
    >
      <div class="grid grid-cols-1 items-center gap-8 sm:grid-cols-[3fr_1fr]">
        <div class="text-center sm:text-left">
          <h1>
            <span class="sr-only">Sorted Tech - </span>
            <span
              class="bg-linear-to-b from-[#8EC5FF] to-[#EFF6FF] bg-clip-text pb-2 text-[48px] [--stroke-color:#2B7FFF] [--stroke-width:1.2px] sm:[--stroke-width:1.5px] md:text-[64px] font-[family-name:var(--font-sorted-logo)] [font-variant-ligatures:none] [-webkit-text-fill-color:transparent] [-webkit-text-stroke:var(--stroke-width)_var(--stroke-color)]"
            >
              Insights Beyond Influence
            </span>
          </h1>
          <p class="font-medium">
            Your source for independent insights that bring clarity to the
            latest in tech, grounded in real understanding and built to help you
            see beyond the hype.
          </p>
        </div>

        <div
          class="mx-auto flex w-45 justify-center sm:w-50 sm:justify-end md:w-55 lg:w-60 xl:w-65"
        >
          <SortoHome
            class="block h-auto w-full"
            role="img"
            aria-label="Sorto, Keeper of the Code"
          />
        </div>
      </div>
    </article>
  </section>

  <section aria-labelledby="spotlight" class="w-full py-2 md:py-4 lg:py-6">
    <article
      class="bg-custom-100 dark:bg-custom-700 border-custom-300/50 dark:border-custom-700/50 relative w-full border p-2 shadow-md sm:p-6 md:p-8"
    >
      <header id="spotlight" class="mb-6">
        <h2>Spotlight</h2>
      </header>

      <div class="flex w-full flex-col gap-6">
        {
          spotlightCards.map((card) => (
            <article
              data-accent={card.accent}
              class="bg-custom-200/50 dark:bg-custom-800/50 border-custom-300 dark:border-custom-900 relative w-full rounded-xl border p-2 shadow-md sm:p-4 md:p-8"
            >
              <div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-3">
                <a
                  href={card.href}
                  data-astro-prefetch="viewport"
                  class="group w-30 touch-manipulation self-start overflow-hidden rounded-lg sm:row-span-3 sm:w-40 sm:rounded-xl lg:w-50"
                  aria-label={card.heading}
                >
                  <Picture
                    src={card.image}
                    alt={card.imageAlt}
                    formats={["avif"]}
                    fallbackFormat="jpeg"
                    layout={IMAGE_PRESETS["spotlight-thumbnail"].layout}
                    sizes={IMAGE_PRESETS["spotlight-thumbnail"].sizes}
                    widths={IMAGE_PRESETS["spotlight-thumbnail"].widths}
                    class="transition-transform duration-300 ease-out group-hover:scale-105"
                  />
                </a>
                <div class="self-start text-left">
                  <p class="text-accent-ink text-xsmall mb-1 font-semibold tracking-wider uppercase">
                    {card.hubLabel}
                  </p>
                  <h3>
                    <a
                      href={card.href}
                      data-astro-prefetch="viewport"
                      class="touch-manipulation hover:text-blue-500"
                    >
                      {card.heading}
                    </a>
                  </h3>
                </div>
                <p class="text-small col-span-2 sm:col-span-1">
                  {card.description}
                </p>
                <p class="text-xsmall dark:text-custom-300 col-span-2 text-slate-700 sm:col-span-1">
                  {card.hubPrefix}{" "}
                  <a href={card.hubHref} class="font-bold hover:underline">
                    {card.hubAnchor}
                  </a>
                  {card.hubSuffix}{" "}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </article>
  </section>

  <section class="w-full py-2 md:py-4 lg:py-6">
    <article
      class="from-custom-100 to-custom-200 dark:from-custom-700 dark:to-custom-800 relative w-full bg-linear-to-b p-2 shadow-md sm:p-4 md:p-8"
    >
      <div class="text-center lg:text-left">
        <header class="mb-6">
          <h2>On the Horizon</h2>
          <p>Concepts and features in early exploration</p>
        </header>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div
            class="bg-custom-200/50 dark:bg-custom-800/50 border-custom-300 dark:border-custom-900 border p-2 sm:p-6 md:p-8"
          >
            <h3 class="text-body">Byte-Sized</h3>
            <p class="text-small italic">
              Short explainers for smarter buying decisions.
            </p>
          </div>
          <div
            class="bg-custom-200/50 dark:bg-custom-800/50 border-custom-300 dark:border-custom-900 border p-2 sm:p-6 md:p-8"
          >
            <h3 class="text-body">Reviews</h3>
            <p class="text-small italic">
              Analytical takes on the latest tech, simplified.
            </p>
          </div>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
