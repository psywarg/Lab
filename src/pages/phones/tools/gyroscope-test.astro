      @apply text-xsmall text-white;
    }

    .gyro-stage[data-drift-state="minor"] .gyro-drift-summary strong {
      @apply text-blue-300;
    }

    .gyro-stage[data-drift-state="high"] .gyro-drift-summary strong {
      @apply text-blue-500;
    }

    .gyro-drift-target {
      @apply relative aspect-square w-full overflow-hidden rounded-4xl border border-blue-500 bg-[radial-gradient(circle_at_center,rgb(142_197_255/0.15)_0_35%,transparent_36%),radial-gradient(circle_at_center,transparent_0_55%,rgb(142_197_255/0.10)_56%)] ring-10 ring-blue-300/10;
    }

    .gyro-drift-cross,
    .gyro-drift-ring,
    .gyro-drift-axis-label,
    .gyro-drift-dot {
      @apply pointer-events-none absolute;
    }

