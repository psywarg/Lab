      @apply bg-white/20;
    }

    .gyro-drift-cross--x {
      @apply top-1/2 right-[10%] left-[10%] h-px -translate-y-1/2;
    }

    .gyro-drift-cross--y {
      @apply top-[10%] bottom-[10%] left-1/2 w-px -translate-x-1/2;
    }

    .gyro-drift-ring {
      @apply top-1/2 left-1/2 aspect-square -translate-x-1/2 -translate-y-1/2 rounded-full border border-blue-300;
      width: var(--gyro-drift-ring-size, 65%);
    }

    .gyro-drift-ring--inner {
      @apply border-blue-300/50 bg-blue-300/10 [--gyro-drift-ring-size:32.5%];
    }

    .gyro-drift-ring--outer {
      @apply border-dashed [--gyro-drift-ring-size:65%];
    }

    .gyro-drift-axis-label {
      @apply text-2xsmall z-2 inline-grid size-5 place-items-center rounded-full border border-blue-300 bg-white/50 leading-none font-bold tracking-wide text-white/86;
    }

    .gyro-drift-axis-label--x {
      @apply bottom-2 left-1/2 -translate-x-1/2;
    }

    .gyro-drift-axis-label--y {
      @apply top-1/2 left-2 -translate-y-1/2;
    }

    .gyro-drift-axis-label--z {
      @apply top-8 right-8;
    }

    .gyro-drift-dot {
      @apply top-1/2 left-1/2 size-4 rounded-full border-2 border-white bg-blue-500 ring-4 ring-blue-300/10;
      transform: translate(
        calc(-50% + var(--gyro-drift-x)),
        calc(-50% + var(--gyro-drift-y))
      );
