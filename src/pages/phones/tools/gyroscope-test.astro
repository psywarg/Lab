      @apply bg-blue-950/70;
      transform: rotateY(180deg) translateZ(0.5rem);
    }

    .gyro-3d-notch {
      @apply absolute top-2 left-1/2 h-1 w-6 -translate-x-1/2 rounded-full bg-white/80;
    }

    @supports not (translate: -50% -50%) {
      .gyro-attitude-reticle,
      .gyro-attitude-reticle::before,
      .gyro-drift-ring,
      .gyro-3d-notch {
        transform: translate(-50%, -50%);
      }

      .axis-track i {
        transform: translateY(-50%) translateX(var(--axis-offset, 0%))
          scaleX(var(--axis-direction, 1));
      }
    }

    .gyro-stage[data-check="level"] .gyro-check-visual--level,
    .gyro-stage[data-check="twist"] .gyro-check-visual--twist,
    .gyro-stage[data-check="drift"] .gyro-check-visual--drift,
    .gyro-stage[data-check="3d"] .gyro-check-visual--3d {
      @apply opacity-100;
    }

    :global(
      #gyro-shell[data-check="level"]
        ~ #gyro-readouts
        .gyro-readout-panel--rates
    ),
    :global(
      #gyro-shell[data-check="twist"]
        ~ #gyro-readouts
        .gyro-readout-panel--angles
    ),
    :global(
      #gyro-shell[data-check="drift"]
        ~ #gyro-readouts
        .gyro-readout-panel--angles
    ),
    :global(
      #gyro-shell[data-check="3d"] ~ #gyro-readouts .gyro-readout-panel--rates
    ) {
      @apply opacity-50;
    }

    .axis-track {
      @apply border-accent-line bg-accent-wash relative h-4 w-full overflow-hidden rounded-full border;
    }

    .axis-track::before {
      @apply absolute top-0 bottom-0 left-1/2 w-px bg-white/50 content-[''];
    }

    .axis-track i {
      @apply absolute top-1/2 left-1/2 origin-left size-4 -translate-y-1/2 rounded-full border-4 border-slate-700 dark:border-slate-100;
      width: var(--axis-width, 0%);
      transform: translateX(var(--axis-offset, 0%))
        scaleX(var(--axis-direction, 1));
      transition:
        width 80ms linear,
        transform 80ms linear;
    }

    .axis-stat {
      @apply border-accent-line grid gap-1.5 rounded-xl border bg-custom-100 px-2.5 py-2 sm:gap-2 sm:px-3 dark:bg-custom-700;
    }

    .axis-stat-row {
      @apply flex items-center justify-between gap-2 sm:gap-4;
    }

    .axis-stat-label {
      @apply text-xsmall font-bold text-slate-800 uppercase dark:text-slate-200;
    }

    .axis-stat-value {
      @apply text-small sm:text-h4 text-slate-700 dark:text-slate-300;
    }

    .gyro-graph {
      @apply border-accent-line text-accent-ink block h-15 sm:h-20 w-full rounded-xl border bg-custom-100 dark:bg-custom-700;
    }

    .gyro-diag-card {
      @apply border-accent-line grid gap-2 rounded-xl border bg-custom-100 px-3 py-2 dark:bg-custom-700;
    }

    .gyro-diag-row {
      @apply flex min-w-0 items-baseline justify-between gap-2;
    }

    .gyro-diag-label {
      @apply text-xsmall min-w-0 font-medium text-slate-800 dark:text-slate-200;
    }

    .gyro-diag-value {
      @apply text-small shrink-0 text-slate-700 dark:text-slate-300;
    }

    .gyro-diag-state {
      @apply text-xsmall block text-slate-700 dark:text-slate-300;
    }

    .sensor-panel-title {
      @apply text-small text-slate-800 dark:text-slate-200;
    }

    .sensor-panel-unit {
      @apply text-xsmall text-right text-slate-700 dark:text-slate-300;
    }
  </style>

  <script>
    import { createSensorWatchdog } from "@/utils/phones/tools/sensor";
    import { createWakeLock } from "@/utils/phones/tools/wakeLock";
    import {
      onPageHide,
      observeResize,
      type ResizeHandle,
    } from "@/utils/phones/tools/lifecycle";
    import { createRafScheduler } from "@/utils/site/raf";
    import {
      requestMotionAndOrientationPermission,
      getMotionPermissionState,
      describeSensorUnavailability,
      type SensorPermissionReason,
    } from "@/utils/phones/tools/capabilities";
    import {
      getScreenAngle,
      onOrientationChange,
      remapDeviceAxes,
      type OrientationAngle,
    } from "@/utils/phones/tools/orientation";
    import {
      BIAS_CAPTURE,
      createMotionGraph,
      driftState as gradeDrift,
      genericSensorCtor,
      evaluateBiasCapture,
      mean as average,
      restingStats,
      startGenericSensor,
      type GenericSensor,
      type GraphSeries,
    } from "@/utils/phones/tools/motion";

    type GyroCheck = "level" | "twist" | "drift" | "3d";

    type FrameMetrics = {
      recentRotationData: boolean;
      recentAnyRotationData: boolean;
      tiltMagnitude: number;
      displayDriftX: number;
      displayDriftY: number;
      displayDriftZ: number;
      spinMagnitude: number;
      restingNoise: number;
      restingBias: number;
      driftScore: number;
      driftState: "waiting" | "calm" | "minor" | "high";
    };

    const RAD_TO_DEG = 180 / Math.PI;

    const checkHints = {
      level:
        "Start while the phone is flat, then tilt gently and watch the attitude horizon follow pitch and roll.",
      twist:
        "Keep the phone flat and still for a moment, then rotate it flat. Positive Z-rate moves toward + CCW and negative Z-rate toward - CW.",
      drift:
        "Keep the phone flat and still. X/Y moves the dot and the Drift score should settle close to zero.",
      "3d": "Tilt and rotate slowly and confirm the 3D model tracks the phone's real orientation.",
    } as const;

    const visibleStatsByCheck = {
      level: ["check", "status", "motion", "rate", "tilt"] as const,
      twist: ["check", "status", "motion", "rate", "zrate", "peak"] as const,
      drift: ["check", "status", "motion", "rate", "zrate", "drift"] as const,
      "3d": ["check", "status", "motion"] as const,
    } as const;

    const shell = document.getElementById(
      "gyro-shell",
    ) as HTMLDivElement | null;
    const stage = document.getElementById(
      "gyro-stage",
    ) as HTMLDivElement | null;
    const startButton = document.getElementById("gyro-start");
    const resetButton = document.getElementById("gyro-reset");
    const fullscreenButton = document.getElementById("gyro-fullscreen");
    const pauseNotice = document.getElementById("gyro-pause-notice");
    const captureBiasButton = document.getElementById(
      "gyro-capture-bias",
    ) as HTMLButtonElement | null;
    const stageCheckLegend = document.getElementById("gyro-stage-check-legend");
    const stageInfo = document.getElementById("gyro-stage-info");
    const dockTip = document.getElementById("gyro-dock-tip");
    const driftScope = document.querySelector<HTMLElement>(".gyro-drift-scope");
    const driftStateLabel = document.getElementById("gyro-drift-state");
    const driftXyValue = document.getElementById("gyro-drift-xy-value");
    const gyro3dStage = document.getElementById("gyro-3d-stage");

    const runStatus = document.getElementById("gyro-run-status");
    const stageStatus = document.getElementById("gyro-stage-status");
    const runMotionState = document.getElementById("gyro-run-motion");
    const stageMotionState = document.getElementById("gyro-stage-motion");
    const runRate = document.getElementById("gyro-run-rate");
    const stageRate = document.getElementById("gyro-stage-rate");
    const runTilt = document.getElementById("gyro-run-tilt");
    const stageTilt = document.getElementById("gyro-stage-tilt");
    const runHeading = document.getElementById("gyro-run-heading");
    const stageHeading = document.getElementById("gyro-stage-heading");
    const runZRate = document.getElementById("gyro-run-z-rate");
    const stageZRate = document.getElementById("gyro-stage-z-rate");
    const twistRateValue = document.getElementById("gyro-twist-rate-value");
    const runPeak = document.getElementById("gyro-run-peak");
    const stagePeak = document.getElementById("gyro-stage-peak");
    const runDrift = document.getElementById("gyro-run-drift");
    const stageDrift = document.getElementById("gyro-stage-drift");

    const alphaAngle = document.getElementById("alpha-angle");
    const betaAngle = document.getElementById("beta-angle");
    const gammaAngle = document.getElementById("gamma-angle");
    const alphaAngleBar = document.getElementById("alpha-angle-bar");
    const betaAngleBar = document.getElementById("beta-angle-bar");
    const gammaAngleBar = document.getElementById("gamma-angle-bar");
    const orientationModeLabel = document.getElementById("orientation-mode");

    const xRateLabel = document.getElementById("x-rate");
    const yRateLabel = document.getElementById("y-rate");
    const zRateLabel = document.getElementById("z-rate");
    const xRateBar = document.getElementById("x-rate-bar");
    const yRateBar = document.getElementById("y-rate-bar");
    const zRateBar = document.getElementById("z-rate-bar");

    const biasScoreLabel = document.getElementById("bias-score");
    const biasStateLabel = document.getElementById("bias-state");
    const noiseScoreLabel = document.getElementById("noise-score");
    const noiseStateLabel = document.getElementById("noise-state");
    const headingDriftLabel = document.getElementById("heading-drift");
    const headingStateLabel = document.getElementById("heading-state");
    const peakSpinLabel = document.getElementById("peak-spin");
    const peakStateLabel = document.getElementById("peak-state");
    const graphWindowLabel = document.getElementById("graph-window-label");
    const graphCanvas = document.getElementById(
      "gyro-graph",
    ) as HTMLCanvasElement | null;
    const evidenceSourceLabel = document.getElementById("evidence-source");
    const evidenceAxesLabel = document.getElementById("evidence-axes");
    const evidenceRateLabel = document.getElementById("evidence-rate");
    const evidencePeakLabel = document.getElementById("evidence-peak");
    const runStats = Array.from(
      document.querySelectorAll<HTMLElement>("[data-stat-id]"),
    );
    const checkButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-gyro-check]"),
    );

    const pageController = new AbortController();
    const { signal } = pageController;
    const wakeLock = createWakeLock({ signal });

    onPageHide(cleanupSensorPage);
    let graphResizeObserver: ResizeHandle | null = null;
    let driftVisualResizeObserver: ResizeHandle | null = null;
    const gyroVisual = document.querySelector<HTMLElement>(".gyro-visual");

    let visualScale = 1;
    const VISUAL_SCALE_REFERENCE_HALF_EXTENT = 165;

    function updateVisualScale(): void {
      if (!gyroVisual) return;
      const rect = gyroVisual.getBoundingClientRect();
      const halfExtent = Math.min(rect.width, rect.height) / 2;
      visualScale =
        halfExtent > 0 ? halfExtent / VISUAL_SCALE_REFERENCE_HALF_EXTENT : 1;
    }

    let started = false;
    let startInFlight = false;
    let startCancelled = false;
    let pausedForFullscreen = false;
    let shouldResumeAfterFullscreen = false;
    let motionPermissionGranted = false;
    let orientationPermissionGranted = false;
    let currentCheck: GyroCheck = "level";
    let hasRotationData = false;
    let hasAnyRotationData = false;
    let rateXAvailable = false;
    let rateYAvailable = false;
    let rateZAvailable = false;
    let orientationAbsolute = false;
    let latestAlpha = 0;
    let latestBeta = 0;
    let latestGamma = 0;
    let latestRawRateX = 0;
    let latestRawRateY = 0;
    let latestRawRateZ = 0;
    let rateX = 0;
    let rateY = 0;
    let rateZ = 0;
    let rateBiasX = 0;
    let rateBiasY = 0;
    let rateBiasZ = 0;
    let rateBiasXReady = false;
    let rateBiasYReady = false;
    let rateBiasZReady = false;
    let referenceAlpha = 0;
    let referenceBeta = 0;
    let referenceGamma = 0;
    let orientationReferenceReady = false;
    let visualTiltX = 0;
    let visualTiltY = 0;
    let visualRateZ = 0;
    let visualDriftX = 0;
    let visualDriftY = 0;
    let peakSpin = 0;
    let peakZSpin = 0;
    let sampleCount = 0;
    let orientationLastSampleTime = 0;
    let rotationLastSampleTime = 0;
    let alphaLastSampleTime = 0;
    let betaLastSampleTime = 0;
    let gammaLastSampleTime = 0;
    const motionGraph = createMotionGraph(graphCanvas, graphWindowLabel, {
      r: 51,
      g: 65,
      b: 85,
    });
    const spinHistory: number[] = [];
    const tiltHistory: number[] = [];
    const twistRateHistory: number[] = [];

    // Raw rates minus any captured offset: no smoothing and no deadbands, so
    // drift is measured on what the sensor reports. Deadbands are for the
    // animation only.
    const residualXHistory: number[] = [];
    const residualYHistory: number[] = [];
    const residualZHistory: number[] = [];
    const headingHistory: number[] = [];
    const unwrappedHeadingHistory: number[] = [];
    const orientationIntervals: number[] = [];
    const rotationIntervals: number[] = [];
    let lastDetailedRefresh = 0;
    const detailedRefreshInterval = 1000 / 12;
    const sensorFreshnessWindow = 1800;
    const rateHistoryLimit = 48;
    const rateResidualDeadband = 0.9;
    const rateSmoothingFactor = 0.26;
    const driftQuietRateThreshold = 2.4;
    const twistQuietRateThreshold = 3.5;
    const driftVisualScale = 8;

    type BiasCaptureState = "idle" | "capturing" | "captured" | "rejected";
    let biasCaptureState: BiasCaptureState = "idle";
    let biasCaptureCountdown = 0;
    let biasCaptureTimer = 0;
    let lastCapturedBiasMagnitude = 0;
    const captureRawX: number[] = [];
    const captureRawY: number[] = [];
    const captureRawZ: number[] = [];
    let lastCaptureHighOffset = false;
    let lastCaptureRejectReason: "too-few-samples" | "moved" = "moved";
    const BIAS_CAPTURE_SECONDS = 3;
    const RESTING_MIN_SAMPLES = 8;

    function showRuntimeControls(): void {
      shell?.dispatchEvent(
        new CustomEvent("tool-runtime:show-controls", { bubbles: true }),
      );
    }

    let gyroscopeSensor: GenericSensor | null = null;
    let usingGenericSensor = false;
    let genericSensorLastSampleTime = 0;
    let screenAngle: OrientationAngle = getScreenAngle();

    let visualAnimationFrame = 0;

    const uiScheduler = createRafScheduler(() => {
      refreshStatusFromData();
      const now = performance.now();
      if (now - lastDetailedRefresh >= detailedRefreshInterval) {
        lastDetailedRefresh = now;
        const frameMetrics = computeFrameMetrics();
        updateDiagnostics(frameMetrics);
        updateStageInfo(frameMetrics);
      }
    });

    function wrapDegrees(value: number): number {
      return ((value + 540) % 360) - 180;
    }

    function finiteNumber(value: number | null | undefined): number | null {
      return typeof value === "number" && Number.isFinite(value) ? value : null;
    }


    function pushLimited(
      history: number[],
      value: number,
      limit = rateHistoryLimit,
    ): void {
      history.push(value);
      if (history.length > limit) history.shift();
    }

    function currentHeading(): number {
      return wrapDegrees(latestAlpha - referenceAlpha);
    }

    function currentTiltX(): number {
      return latestGamma - referenceGamma;
    }

    function currentTiltY(): number {
      return wrapDegrees(latestBeta - referenceBeta);
    }

    function currentTiltMagnitude(): number {
      return Math.hypot(currentTiltX(), currentTiltY());
    }

    function setOrientationReferenceFromCurrent(): void {
      if (!hasRecentTiltData()) return;
      if (hasRecentAlphaData()) referenceAlpha = latestAlpha;
      referenceBeta = latestBeta;
      referenceGamma = latestGamma;
      orientationReferenceReady = true;
      tiltHistory.length = 0;
      headingHistory.length = 0;
      unwrappedHeadingHistory.length = 0;
    }

    function currentSpinMagnitude(): number {
      if (!hasRecentRotationData()) return 0;
      return Math.hypot(
        applyDriftRateDeadband(rateX),
        applyDriftRateDeadband(rateY),
        applyDriftRateDeadband(rateZ),
      );
    }

    function correctedRate(
      value: number,
      bias: number,
      biasReady: boolean,
    ): number {
      const corrected = value - (biasReady ? bias : 0);
      return Math.abs(corrected) < rateResidualDeadband ? 0 : corrected;
    }

    function smoothCorrectedRate(previous: number, next: number): number {
      if (next === 0 && Math.abs(previous) < rateResidualDeadband * 1.25)
        return 0;
      const smoothed = previous + (next - previous) * rateSmoothingFactor;
      return Math.abs(smoothed) < rateResidualDeadband ? 0 : smoothed;
    }

    function updateCorrectedRatesFromRaw(): void {
      if (rateXAvailable)
        rateX = smoothCorrectedRate(
          rateX,
          correctedRate(latestRawRateX, rateBiasX, rateBiasXReady),
        );
      if (rateYAvailable)
        rateY = smoothCorrectedRate(
          rateY,
          correctedRate(latestRawRateY, rateBiasY, rateBiasYReady),
        );
      if (rateZAvailable)
        rateZ = smoothCorrectedRate(
          rateZ,
          correctedRate(latestRawRateZ, rateBiasZ, rateBiasZReady),
        );
    }

    function settleCorrectedRates(): void {
      rateX = 0;
      rateY = 0;
      rateZ = 0;
      visualRateZ = 0;
      visualDriftX = 0;
      visualDriftY = 0;
    }

    function resetCorrectedRateHistory(): void {
      spinHistory.length = 0;
      twistRateHistory.length = 0;

      residualXHistory.length = 0;
      residualYHistory.length = 0;
      residualZHistory.length = 0;
      peakSpin = 0;
      peakZSpin = 0;
      visualRateZ = 0;
      visualDriftX = 0;
      visualDriftY = 0;
    }

    function resetRateBias(): void {
      rateBiasX = 0;
      rateBiasY = 0;
      rateBiasZ = 0;
      rateBiasXReady = false;
      rateBiasYReady = false;
      rateBiasZReady = false;
    }

    function updateBiasCaptureUi(): void {
      if (biasScoreLabel) {
        biasScoreLabel.textContent =
          biasCaptureState === "captured"
            ? formatNoise(lastCapturedBiasMagnitude)
            : "--";
      }
      if (biasStateLabel) {
        biasStateLabel.textContent =
          biasCaptureState === "idle"
            ? "Not captured -- hold still and capture"
            : biasCaptureState === "capturing"
              ? `Hold still... ${biasCaptureCountdown}`
              : biasCaptureState === "captured"
                ? lastCaptureHighOffset
                  ? "High offset -- adjusts this page only"
                  : "Captured -- adjusts this page only"
                : lastCaptureRejectReason === "too-few-samples"
                  ? "Too few samples -- try again"
                  : "Phone moved -- hold it still and try again";
      }
      if (captureBiasButton) {
        captureBiasButton.disabled =
          !started ||
          pausedForFullscreen ||
          !hasRotationData ||
          biasCaptureState === "capturing";
        captureBiasButton.textContent =
          biasCaptureState === "capturing"
            ? `Hold ${biasCaptureCountdown}s`
            : "Zero rate";
      }
    }

    function startBiasCapture(): void {
      if (
        !started ||
        pausedForFullscreen ||
        !hasRotationData ||
        biasCaptureState === "capturing"
      )
        return;
      biasCaptureState = "capturing";
      biasCaptureCountdown = BIAS_CAPTURE_SECONDS;
      captureRawX.length = 0;
      captureRawY.length = 0;
      captureRawZ.length = 0;
      updateBiasCaptureUi();
      scheduleBiasCaptureCountdown();
    }

    function scheduleBiasCaptureCountdown(): void {
      if (biasCaptureTimer !== 0 || biasCaptureState !== "capturing") return;
      biasCaptureTimer = window.setInterval(() => {
        biasCaptureCountdown -= 1;
        if (biasCaptureCountdown <= 0) {
          window.clearInterval(biasCaptureTimer);
          biasCaptureTimer = 0;
          finishBiasCapture();
        } else {
          updateBiasCaptureUi();
        }
      }, 1000);
    }

    function pauseBiasCapture(): void {
      if (biasCaptureTimer === 0) return;
      window.clearInterval(biasCaptureTimer);
      biasCaptureTimer = 0;
      updateBiasCaptureUi();
    }

    function resumeBiasCapture(): void {
      scheduleBiasCaptureCountdown();
      updateBiasCaptureUi();
    }

    function finishBiasCapture(): void {
      // A large but steady offset is the result being measured, so only a
      // moving phone or too little data rejects the capture.
      const result = evaluateBiasCapture(captureRawX, captureRawY, captureRawZ);
      if (!result.ok) {
        lastCaptureRejectReason = result.reason;
        biasCaptureState = "rejected";
        updateBiasCaptureUi();
        return;
      }

      const { perAxisMean, biasMagnitude } = result.stats;
      rateBiasX = perAxisMean.x;
      rateBiasY = perAxisMean.y;
      rateBiasZ = perAxisMean.z;
      rateBiasXReady = true;
      rateBiasYReady = true;
      rateBiasZReady = true;
      settleCorrectedRates();
      resetCorrectedRateHistory();
      lastCapturedBiasMagnitude = biasMagnitude;
      lastCaptureHighOffset = result.highOffset;
      biasCaptureState = "captured";
      updateBiasCaptureUi();
    }

    function cancelBiasCapture(rejected: boolean): void {
      if (biasCaptureTimer !== 0) {
        window.clearInterval(biasCaptureTimer);
        biasCaptureTimer = 0;
      }
      if (biasCaptureState === "capturing") {
        biasCaptureState = rejected ? "rejected" : "idle";
        updateBiasCaptureUi();
      }
    }

    function isRecent(lastSampleTime: number): boolean {
      return (
        lastSampleTime > 0 &&
        performance.now() - lastSampleTime < sensorFreshnessWindow
      );
    }

    function hasRecentAlphaData(): boolean {
      return isRecent(alphaLastSampleTime);
    }

    function hasRecentBetaData(): boolean {
      return isRecent(betaLastSampleTime);
    }

    function hasRecentGammaData(): boolean {
      return isRecent(gammaLastSampleTime);
    }

    function hasRecentTiltData(): boolean {
      return hasRecentBetaData() && hasRecentGammaData();
    }

    function hasRecentAnyOrientationData(): boolean {
      return (
        hasRecentAlphaData() || hasRecentBetaData() || hasRecentGammaData()
      );
    }

    function hasRecentAnyRotationData(): boolean {
      return hasAnyRotationData && isRecent(rotationLastSampleTime);
    }

    function hasRecentRotationData(): boolean {
      return hasRotationData && isRecent(rotationLastSampleTime);
    }

    function hasCheckData(check: GyroCheck): boolean {
      if (check === "level") return hasRecentTiltData();
      if (check === "twist")
        return rateZAvailable && hasRecentAnyRotationData();
      if (check === "3d") return hasRecentAnyOrientationData();
      return hasRecentRotationData();
    }

    function updateCheckAvailability(): void {
      checkButtons.forEach((button) => {
        const check = button.dataset.gyroCheck as GyroCheck | undefined;
        if (!check) return;
        const unavailable = started && sampleCount > 0 && !hasCheckData(check);
        button.disabled = unavailable;
        button.title = unavailable
          ? check === "level"
            ? "Orientation-angle data is unavailable."
            : check === "twist"
              ? "Z-axis rotation-rate data is unavailable."
              : check === "3d"
                ? "Orientation data is unavailable."
                : "Complete X, Y, and Z rotation-rate data is unavailable."
          : "";
      });
      updateBiasCaptureUi();
    }

    function formatAngle(value: number): string {
      return `${value.toFixed(1)}°`;
    }

    function formatRate(value: number): string {
      return `${Math.round(value)} deg/s`;
    }

    function formatSignedRate(value: number): string {
      const rounded = Math.round(value);
      return `${rounded > 0 ? "+" : ""}${rounded} deg/s`;
    }

    function formatNoise(value: number): string {
      return `${value.toFixed(1)} deg/s`;
    }

    function applyQuietRateDeadband(
      value: number,
      threshold = twistQuietRateThreshold,
    ): number {
      return Math.abs(value) < threshold ? 0 : value;
    }

    function applyDriftRateDeadband(value: number): number {
      return Math.abs(value) < driftQuietRateThreshold ? 0 : value;
    }

    function setStatus(text: string): void {
      if (runStatus) runStatus.textContent = text;
      if (stageStatus) stageStatus.textContent = text;
    }

    function setAxisBar(
      bar: HTMLElement | null,
      value: number,
      maxValue: number,
    ): void {
      if (!bar) return;
      const width = Math.min(100, (Math.abs(value) / maxValue) * 100);
      bar.style.setProperty("--axis-width", `${width / 2}%`);
      bar.style.setProperty("--axis-direction", value < 0 ? "-1" : "1");
      bar.style.setProperty("--axis-offset", value < 0 ? "-100%" : "0%");
    }

    function updateVisibleStats(): void {
      const visible = new Set<string>(visibleStatsByCheck[currentCheck]);
      runStats.forEach((item) => {
        item.hidden = !visible.has(item.dataset.statId || "");
      });
    }

    function resizeGraph(): void {
      motionGraph.resize();
      drawGraph();
    }

    function currentGraphSeries(): GraphSeries {
      if (currentCheck === "level") {
        const values = tiltHistory.length ? tiltHistory : [0];
        const maxTilt = Math.max(
          8,
          ...tiltHistory,
          currentTiltMagnitude(),
          2.5,
        );
        return {
          values,
          sampleCount: tiltHistory.length,
          min: 0,
          max: maxTilt,
          baseline: 0,
          label: "Tilt offset (target under 2 deg)",
        };
      }

      if (currentCheck === "twist") {
        const values = twistRateHistory.length ? twistRateHistory : [0];
        const scale = Math.max(
          12,
          peakZSpin,
          ...twistRateHistory.map(Math.abs),
        );
        return {
          values,
          sampleCount: twistRateHistory.length,
          min: -scale,
          max: scale,
          baseline: 0,
          label: "Corrected Z-rate",
        };
      }

      const values = spinHistory.length ? spinHistory : [0];
      const maxSpin = Math.max(12, ...spinHistory, peakSpin, 8);
      return {
        values,
        sampleCount: spinHistory.length,
        min: 0,
        max: maxSpin,
        baseline: 0,
        label: "Corrected spin (target under 8 deg/s)",
      };
    }

    function updateGraphLabels(series: GraphSeries): void {
      motionGraph.updateLabel(series);
    }

    function drawGraph(series = currentGraphSeries()): void {
      motionGraph.draw(series);
    }

    function computeHeadingDriftRange(): number {
      if (!unwrappedHeadingHistory.length) return 0;
      return (
        Math.max(...unwrappedHeadingHistory) -
        Math.min(...unwrappedHeadingHistory)
      );
    }

    function updateSampleMetrics(): void {
      const stream =
        currentCheck === "level"
          ? hasRecentTiltData()
            ? "orientation"
            : "rotation"
          : hasRecentAnyRotationData()
            ? "rotation"
            : "orientation";
      const intervals =
        stream === "rotation" ? rotationIntervals : orientationIntervals;
      const avgInterval = average(intervals);
      const sampleRate = avgInterval > 0 ? 1000 / avgInterval : 0;
      const rateText = sampleRate > 0 ? `${sampleRate.toFixed(1)} Hz` : "-- Hz";

      if (runRate) runRate.textContent = rateText;
      if (stageRate) stageRate.textContent = rateText;
      if (evidenceRateLabel) evidenceRateLabel.textContent = rateText;
    }

    function computeFrameMetrics(): FrameMetrics {
      const recentTiltData = hasRecentTiltData();
      const recentRotationData = hasRecentRotationData();
      const recentAnyRotationData = hasRecentAnyRotationData();
      const tiltMagnitude = recentTiltData ? currentTiltMagnitude() : 0;
      const displayDriftX =
        rateXAvailable && recentAnyRotationData
          ? applyDriftRateDeadband(rateX)
          : 0;
      const displayDriftY =
        rateYAvailable && recentAnyRotationData
          ? applyDriftRateDeadband(rateY)
          : 0;
      const displayDriftZ =
        rateZAvailable && recentAnyRotationData
          ? applyDriftRateDeadband(rateZ)
          : 0;
      const spinMagnitude = Math.hypot(
        displayDriftX,
        displayDriftY,
        displayDriftZ,
      );
      const resting = recentRotationData
        ? restingStats(residualXHistory, residualYHistory, residualZHistory)
        : null;
      const restingReady =
        resting !== null && resting.samples >= RESTING_MIN_SAMPLES;
      const restingBias = restingReady ? resting.biasMagnitude : 0;
      const restingNoise = restingReady ? resting.noiseRms : 0;
      const driftScore = restingBias;
      const driftState = restingReady
        ? gradeDrift(restingBias)
        : ("waiting" as const);
      return {
        recentRotationData,
        recentAnyRotationData,
        tiltMagnitude,
        displayDriftX,
        displayDriftY,
        displayDriftZ,
        spinMagnitude,
        restingNoise,
        restingBias,
        driftScore,
        driftState,
      };
    }

    function updateDiagnostics(metrics = computeFrameMetrics()): void {
      const recentTiltData = hasRecentTiltData();
      const recentHeadingData = hasRecentAlphaData();
      const headingRange = computeHeadingDriftRange();
      const {
        recentAnyRotationData,
        tiltMagnitude,
        displayDriftX,
        displayDriftY,
        spinMagnitude,
        restingNoise,
        driftScore,
        driftState,
      } = metrics;
      const driftText =
        driftState === "waiting" ? "--" : formatNoise(driftScore);
      const displayRateZ = applyQuietRateDeadband(rateZ);

      updateSampleMetrics();
      if (runTilt)
        runTilt.textContent = recentTiltData
          ? formatAngle(tiltMagnitude)
          : "--";
      if (stageTilt)
        stageTilt.textContent = recentTiltData
          ? formatAngle(tiltMagnitude)
          : "--";
      if (runHeading)
        runHeading.textContent = recentHeadingData
          ? formatAngle(currentHeading())
          : "--";
      if (stageHeading)
        stageHeading.textContent = recentHeadingData
          ? formatAngle(currentHeading())
          : "--";
      const recentZRate = rateZAvailable && recentAnyRotationData;
      if (runZRate)
        runZRate.textContent = recentZRate
          ? formatSignedRate(displayRateZ)
          : "--";
      if (stageZRate)
        stageZRate.textContent = recentZRate
          ? formatSignedRate(displayRateZ)
          : "--";
      if (twistRateValue)
        twistRateValue.textContent = recentZRate
          ? formatSignedRate(displayRateZ)
          : "--";
      if (runPeak)
        runPeak.textContent = recentZRate ? formatRate(peakZSpin) : "--";
      if (stagePeak)
        stagePeak.textContent = recentZRate ? formatRate(peakZSpin) : "--";
      if (runDrift) runDrift.textContent = driftText;
      if (stageDrift) stageDrift.textContent = driftText;
      if (driftStateLabel) {
        driftStateLabel.textContent =
          driftState === "waiting"
            ? "Waiting for rate"
            : driftState === "calm"
              ? "Calm"
              : driftState === "minor"
                ? "Minor drift"
                : "High drift";
      }
      stage?.setAttribute("data-drift-state", driftState);
      if (noiseScoreLabel)
        noiseScoreLabel.textContent =
          driftState === "waiting" ? "--" : formatNoise(restingNoise);
      if (noiseStateLabel)
        noiseStateLabel.textContent =
          driftState === "waiting"
            ? "Waiting for rate"
            : restingNoise <= BIAS_CAPTURE.noiseLimit
              ? "Steady"
              : "Moving or noisy";

      if (headingDriftLabel)
        headingDriftLabel.textContent = recentHeadingData
          ? formatAngle(headingRange)
          : "--";
      if (headingStateLabel) {
        headingStateLabel.textContent = !recentHeadingData
          ? "Unavailable"
          : headingRange < 2
            ? "Stable"
            : headingRange < 8
              ? "Minor drift"
              : "Large drift";
      }

      if (peakSpinLabel)
        peakSpinLabel.textContent = recentAnyRotationData
          ? formatRate(peakSpin)
          : "--";
      if (evidencePeakLabel)
        evidencePeakLabel.textContent = formatRate(peakSpin);
      if (peakStateLabel) {
        peakStateLabel.textContent = !recentAnyRotationData
          ? "Unavailable"
          : peakSpin < 20
            ? "No spike yet"
            : peakSpin < 80
              ? "Light turn"
              : peakSpin < 180
                ? "Clear turn"
                : "Fast spin";
      }

      const graphSeries = currentGraphSeries();
      if (document.hidden) updateGraphLabels(graphSeries);
      else drawGraph(graphSeries);

      const motionLabel =
        !recentTiltData && !recentAnyRotationData
          ? "Waiting"
          : spinMagnitude < 2 && tiltMagnitude < 2
            ? "Still"
            : Math.abs(displayRateZ) >
                  Math.max(Math.abs(displayDriftX), Math.abs(displayDriftY)) &&
                Math.abs(displayRateZ) > 8
              ? "Twisting"
              : tiltMagnitude > 5
                ? "Tilting"
                : spinMagnitude > 8
                  ? "Rotating"
                  : "Settling";

      if (runMotionState) runMotionState.textContent = motionLabel;
      if (stageMotionState) stageMotionState.textContent = motionLabel;

      if (evidenceSourceLabel) {
        evidenceSourceLabel.textContent = !started
          ? "--"
          : usingGenericSensor
            ? "Source: Generic Sensor API"
            : "Source: DeviceMotion";
      }
      if (evidenceAxesLabel) {
        const axes = [
          rateXAvailable ? "X" : null,
          rateYAvailable ? "Y" : null,
          rateZAvailable ? "Z" : null,
        ].filter((axis): axis is string => axis !== null);
        evidenceAxesLabel.textContent = axes.length ? axes.join(" ") : "--";
      }
    }

    function requestSensorUiRefresh(): void {
      if (document.hidden) return;
      uiScheduler.request();
    }

    function refreshStatusFromData(): void {
      if (!started) {
        setStatus("Ready");
        return;
      }
      if (pausedForFullscreen) {
        setStatus("Paused");
        return;
      }

      const recentOrientationData = hasRecentAnyOrientationData();
      const recentRotationData = hasRecentRotationData();
      const recentAnyRotationData = hasRecentAnyRotationData();
      if (recentOrientationData && recentRotationData) {
        setStatus("Live");
      } else if (recentOrientationData) {
        setStatus(recentAnyRotationData ? "Mixed" : "Angles only");
      } else if (recentRotationData) {
        setStatus("Rate only");
      } else if (recentAnyRotationData) {
        setStatus("Partial rate");
      } else {
        setStatus("Waiting");
      }
      updateCheckAvailability();
    }

    function updateStageInfo(metrics = computeFrameMetrics()): void {
      if (!stageInfo) return;
      const { tiltMagnitude, driftState } = metrics;

      if (started && sampleCount > 0 && !hasCheckData(currentCheck)) {
        stageInfo.textContent =
          currentCheck === "level"
            ? "Orientation-angle data is unavailable, so the level check cannot be evaluated."
            : currentCheck === "twist"
              ? "Z-axis rotation-rate data is unavailable, so the twist check cannot be evaluated."
              : currentCheck === "3d"
                ? "Orientation data is unavailable, so the 3D view cannot be evaluated."
                : "Complete X, Y, and Z rotation-rate data is unavailable, so drift cannot be evaluated.";
        return;
      }

      if (sampleCount === 0 && !hasAnyRotationData) {
        stageInfo.textContent = checkHints[currentCheck];
        return;
      }

      if (currentCheck === "level") {
        stageInfo.textContent =
          tiltMagnitude < 2
            ? "The attitude horizon is close to level. Tilt slowly and confirm pitch and roll move smoothly."
            : "Tilt response is active. Return the phone flat and check that the horizon settles back near level.";
        return;
      }

      if (currentCheck === "twist") {
        stageInfo.textContent =
          Math.abs(rateZ) > 12
            ? "Twist response is active. The signed Z-rate needle should follow the marked + CCW or - CW direction."
            : "Keep the phone flat and still before twisting. Use “Zero rate” first if the resting rate looks offset.";
        return;
      }

      if (currentCheck === "3d") {
        stageInfo.textContent =
          "The model tracks the OS's fused orientation (accelerometer, gyroscope, and compass where present). It shows the orientation pipeline works -- it is not an isolated gyroscope reading.";
        return;
      }

      stageInfo.textContent =
        driftState === "calm"
          ? "Resting spin looks calm and settled close to zero."
          : "Hold the phone flat and still for a few seconds, then use “Zero rate” to remove the resting offset.";
    }

    function render3dStage(): void {
      gyro3dStage?.style.setProperty("--gyro-3d-z", `${-latestAlpha}deg`);
      gyro3dStage?.style.setProperty("--gyro-3d-x", `${-latestBeta}deg`);
      gyro3dStage?.style.setProperty("--gyro-3d-y", `${latestGamma}deg`);
    }

    function animateVisuals(): void {
      const deviceTiltX = hasRecentTiltData() ? currentTiltX() : 0;
      const deviceTiltY = hasRecentTiltData() ? currentTiltY() : 0;
      const { x: tiltX, y: tiltY } = remapDeviceAxes(
        deviceTiltX,
        deviceTiltY,
        screenAngle,
      );
      const recentAnyRotationData = hasRecentAnyRotationData();
      const deviceDriftX =
        rateXAvailable && recentAnyRotationData
          ? applyDriftRateDeadband(rateX)
          : 0;
      const deviceDriftY =
        rateYAvailable && recentAnyRotationData
          ? applyDriftRateDeadband(rateY)
          : 0;
      const { x: displayDriftX, y: displayDriftY } = remapDeviceAxes(
        deviceDriftX,
        deviceDriftY,
        screenAngle,
      );
      const targetRateZ =
        rateZAvailable && recentAnyRotationData
          ? applyQuietRateDeadband(rateZ)
          : 0;

      visualTiltX += (tiltX - visualTiltX) * 0.12;
      visualTiltY += (tiltY - visualTiltY) * 0.12;
      visualRateZ += (targetRateZ - visualRateZ) * 0.2;
      if (targetRateZ === 0 && Math.abs(visualRateZ) < 0.35) visualRateZ = 0;
      visualDriftX += (displayDriftX - visualDriftX) * 0.22;
      visualDriftY += (displayDriftY - visualDriftY) * 0.22;
      if (displayDriftX === 0 && Math.abs(visualDriftX) < 0.35)
        visualDriftX = 0;
      if (displayDriftY === 0 && Math.abs(visualDriftY) < 0.35)
        visualDriftY = 0;

      const zRateAngle = Math.max(-90, Math.min(90, -(visualRateZ / 180) * 90));
      stage?.style.setProperty("--gyro-z-angle", `${zRateAngle}deg`);
      stage?.style.setProperty(
        "--gyro-roll",
        `${Math.max(-70, Math.min(70, -visualTiltX))}deg`,
      );
      stage?.style.setProperty(
        "--gyro-pitch",
        `${Math.max(-52, Math.min(52, visualTiltY * 0.82))}px`,
      );
      if (driftScope) {
        const driftExtent = 64 * visualScale;
        const driftXOffset = Math.max(
          -driftExtent,
          Math.min(
            driftExtent,
            (visualDriftX / driftVisualScale) * 58 * visualScale,
          ),
        );
        const driftYOffset = Math.max(
          -driftExtent,
          Math.min(
            driftExtent,
            (-visualDriftY / driftVisualScale) * 58 * visualScale,
          ),
        );
        driftScope.style.setProperty("--gyro-drift-x", `${driftXOffset}px`);
        driftScope.style.setProperty("--gyro-drift-y", `${driftYOffset}px`);
      }
      if (driftXyValue) {
        const xyDrift = Math.hypot(displayDriftX, displayDriftY);
        driftXyValue.textContent = recentAnyRotationData
          ? formatNoise(xyDrift)
          : "--";
      }
      if (stage) {
        stage.dataset.spinDirection =
          targetRateZ > 4 ? "counter" : targetRateZ < -4 ? "clockwise" : "idle";
      }

      const alphaAvail = hasRecentAlphaData();
      const betaAvail = hasRecentBetaData();
      const gammaAvail = hasRecentGammaData();
      if (alphaAngle)
        alphaAngle.textContent = alphaAvail
          ? formatAngle(wrapDegrees(latestAlpha))
          : "--";
      if (betaAngle)
        betaAngle.textContent = betaAvail ? formatAngle(latestBeta) : "--";
      if (gammaAngle)
        gammaAngle.textContent = gammaAvail ? formatAngle(latestGamma) : "--";
      setAxisBar(alphaAngleBar, alphaAvail ? wrapDegrees(latestAlpha) : 0, 180);
      setAxisBar(betaAngleBar, betaAvail ? latestBeta : 0, 180);
      setAxisBar(gammaAngleBar, gammaAvail ? latestGamma : 0, 90);

      if (xRateLabel)
        xRateLabel.textContent =
          rateXAvailable && recentAnyRotationData
            ? formatRate(displayDriftX)
            : "--";
      if (yRateLabel)
        yRateLabel.textContent =
          rateYAvailable && recentAnyRotationData
            ? formatRate(displayDriftY)
            : "--";
      if (zRateLabel)
        zRateLabel.textContent =
          rateZAvailable && recentAnyRotationData
            ? formatRate(applyQuietRateDeadband(rateZ))
            : "--";
      setAxisBar(xRateBar, displayDriftX, 360);
      setAxisBar(yRateBar, displayDriftY, 360);
      setAxisBar(zRateBar, applyQuietRateDeadband(rateZ), 360);

      if (orientationModeLabel) {
        orientationModeLabel.textContent = hasRecentAnyOrientationData()
          ? orientationAbsolute
            ? "Absolute"
            : "Relative"
          : "Waiting";
      }

      const stillSettling =
        Math.abs(visualTiltX - tiltX) > 0.05 ||
        Math.abs(visualTiltY - tiltY) > 0.05 ||
        Math.abs(visualRateZ) > 0.1 ||
        Math.abs(visualDriftX) > 0.1 ||
        Math.abs(visualDriftY) > 0.1;

      if (
        !document.hidden &&
        !pausedForFullscreen &&
        (started || stillSettling)
      ) {
        visualAnimationFrame = requestAnimationFrame(animateVisuals);
      } else {
        visualAnimationFrame = 0;
      }
    }

    function ensureVisualAnimation(): void {
      if (document.hidden || pausedForFullscreen) return;
      if (visualAnimationFrame !== 0) return;
      visualAnimationFrame = requestAnimationFrame(animateVisuals);
    }

    function pushInterval(
      now: number,
      stream: "orientation" | "rotation",
    ): void {
      const previous =
        stream === "orientation"
          ? orientationLastSampleTime
          : rotationLastSampleTime;
      const interval = previous ? now - previous : 0;
      if (stream === "orientation") {
        orientationLastSampleTime = now;
      } else {
        rotationLastSampleTime = now;
      }
      if (interval > 0) {
        const history =
          stream === "orientation" ? orientationIntervals : rotationIntervals;
        pushLimited(history, interval);
      }
    }

    function pushHeadingSample(heading: number): void {
      headingHistory.push(heading);
      if (headingHistory.length > 48) headingHistory.shift();

      if (!unwrappedHeadingHistory.length) {
        unwrappedHeadingHistory.push(heading);
        return;
      }

      const lastWrapped =
        headingHistory.length > 1
          ? headingHistory[headingHistory.length - 2]
          : heading;
      const lastUnwrapped =
        unwrappedHeadingHistory[unwrappedHeadingHistory.length - 1];
      const delta = wrapDegrees(heading - lastWrapped);
      unwrappedHeadingHistory.push(lastUnwrapped + delta);
      if (unwrappedHeadingHistory.length > 48) unwrappedHeadingHistory.shift();
    }

    function handleNoData(): void {
      if (!started || sampleCount > 0) return;
      setStatus("No data");
      if (stageInfo) {
        stageInfo.textContent =
          "No gyroscope-style data has arrived yet. Move the phone once or check browser support.";
      }
    }

    function handleStreamLoss(): void {
      if (!started || sampleCount === 0) return;
      alphaLastSampleTime = 0;
      betaLastSampleTime = 0;
      gammaLastSampleTime = 0;
      orientationLastSampleTime = 0;
      rotationLastSampleTime = 0;
      orientationIntervals.length = 0;
      rotationIntervals.length = 0;
      hasRotationData = false;
      hasAnyRotationData = false;
      rateXAvailable = false;
      rateYAvailable = false;
      rateZAvailable = false;
      resetCorrectedRateHistory();
      tiltHistory.length = 0;
      cancelBiasCapture(true);
      setStatus("Signal lost");
      updateCheckAvailability();
      updateDiagnostics();
      if (stageInfo) {
        stageInfo.textContent =
          "Sensor updates stopped. Move the phone again or check browser support and permissions.";
      }
    }

    const sensorWatchdog = createSensorWatchdog({
      onNoData: handleNoData,
      onStale: handleStreamLoss,
    });

    function setCheck(checkId: GyroCheck): void {
      const changed = checkId !== currentCheck;
      if (changed && checkId === "twist") {
        peakZSpin = 0;
        twistRateHistory.length = 0;
      }
      if (changed && checkId === "level") {
        tiltHistory.length = 0;
      }
      if (changed && checkId === "drift") {
        resetCorrectedRateHistory();
        headingHistory.length = 0;
        unwrappedHeadingHistory.length = 0;
      }
      currentCheck = checkId;
      checkButtons.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.gyroCheck === checkId),
        ),
      );
      if (stage) stage.dataset.check = checkId;
      if (shell) shell.dataset.check = checkId;
      const activeCheckButton = checkButtons.find(
        (button) => button.dataset.gyroCheck === checkId,
      );
      if (dockTip && activeCheckButton?.dataset.gyroTip) {
        dockTip.textContent = activeCheckButton.dataset.gyroTip;
      }
      const checkLabel =
        checkId === "3d"
          ? "3D View"
          : checkId[0].toUpperCase() + checkId.slice(1);
      if (stageCheckLegend) stageCheckLegend.textContent = checkLabel;
      updateVisibleStats();
      updateDiagnostics();
      updateStageInfo();
    }

    function ingestRotationSample(
      rawX: number | null,
      rawY: number | null,
      rawZ: number | null,
      intervalMs: number,
    ): void {
      if (rawX === null && rawY === null && rawZ === null) return;

      sampleCount += 1;
      const now = performance.now();
      pushInterval(now, "rotation");
      if (intervalMs > 0) {
        rotationLastSampleTime = now;
      }

      rateXAvailable = rawX !== null;
      rateYAvailable = rawY !== null;
      rateZAvailable = rawZ !== null;
      hasAnyRotationData = rateXAvailable || rateYAvailable || rateZAvailable;
      hasRotationData = rateXAvailable && rateYAvailable && rateZAvailable;
      if (rawX !== null) latestRawRateX = rawX;
      if (rawY !== null) latestRawRateY = rawY;
      if (rawZ !== null) latestRawRateZ = rawZ;

      if (biasCaptureState === "capturing") {
        if (rawX !== null) captureRawX.push(rawX);
        if (rawY !== null) captureRawY.push(rawY);
        if (rawZ !== null) captureRawZ.push(rawZ);
      }

      updateCorrectedRatesFromRaw();

      if (rateZAvailable) {
        const correctedZUnsmoothed = correctedRate(
          latestRawRateZ,
          rateBiasZ,
          rateBiasZReady,
        );
        peakZSpin = Math.max(peakZSpin, Math.abs(correctedZUnsmoothed));
        pushLimited(twistRateHistory, rateZ);
      }
      if (hasRotationData) {
        const spinMagnitude = currentSpinMagnitude();
        peakSpin = Math.max(peakSpin, spinMagnitude);
        pushLimited(spinHistory, spinMagnitude);

        pushLimited(residualXHistory, latestRawRateX - (rateBiasXReady ? rateBiasX : 0));
        pushLimited(residualYHistory, latestRawRateY - (rateBiasYReady ? rateBiasY : 0));
        pushLimited(residualZHistory, latestRawRateZ - (rateBiasZReady ? rateBiasZ : 0));
      }

      sensorWatchdog.markSample(now);
      requestSensorUiRefresh();
      ensureVisualAnimation();
    }

    function handleOrientation(event: DeviceOrientationEvent): void {
      if (pausedForFullscreen || sensorsPausedForVisibility) return;
      const incomingAlpha = finiteNumber(event.alpha);
      const incomingBeta = finiteNumber(event.beta);
      const incomingGamma = finiteNumber(event.gamma);
      if (
        incomingAlpha === null &&
        incomingBeta === null &&
        incomingGamma === null
      )
        return;

      orientationAbsolute = Boolean(event.absolute);
      sampleCount += 1;

      const now = performance.now();
      const alphaWasRecent = isRecent(alphaLastSampleTime);
      if (incomingAlpha !== null) {
        if (!alphaWasRecent) {
          headingHistory.length = 0;
          unwrappedHeadingHistory.length = 0;
        }
        latestAlpha = incomingAlpha;
        alphaLastSampleTime = now;
      }
      if (incomingBeta !== null) {
        latestBeta = incomingBeta;
        betaLastSampleTime = now;
      }
      if (incomingGamma !== null) {
        latestGamma = incomingGamma;
        gammaLastSampleTime = now;
      }
      if (!orientationReferenceReady && hasRecentTiltData()) {
        setOrientationReferenceFromCurrent();
      }
      pushInterval(now, "orientation");
      if (hasRecentTiltData()) pushLimited(tiltHistory, currentTiltMagnitude());

      if (
        incomingAlpha !== null &&
        currentSpinMagnitude() < driftQuietRateThreshold
      ) {
        pushHeadingSample(currentHeading());
      }
      render3dStage();

      sensorWatchdog.markSample(now);
      requestSensorUiRefresh();
      ensureVisualAnimation();
    }

    function handleMotion(event: DeviceMotionEvent): void {
      if (pausedForFullscreen || sensorsPausedForVisibility) return;
      const rotation = event.rotationRate;
      if (!rotation) return;

      const now = performance.now();
      const measuredInterval = rotationLastSampleTime
        ? now - rotationLastSampleTime
        : 0;
      ingestRotationSample(
        finiteNumber(rotation.beta),
        finiteNumber(rotation.gamma),
        finiteNumber(rotation.alpha),
        measuredInterval,
      );
    }

    function genericSensorSupported(): boolean {
      return genericSensorCtor("Gyroscope") !== null;
    }

    function handleGenericGyroscopeReading(sensor: GenericSensor): void {
      if (
        sensor !== gyroscopeSensor ||
        !started ||
        pausedForFullscreen ||
        sensorsPausedForVisibility
      )
        return;
      const now = performance.now();
      const intervalMs = genericSensorLastSampleTime
        ? now - genericSensorLastSampleTime
        : 0;
      genericSensorLastSampleTime = now;
      const x = finiteNumber(sensor.x);
      const y = finiteNumber(sensor.y);
      const z = finiteNumber(sensor.z);
      ingestRotationSample(
        x === null ? null : x * RAD_TO_DEG,
        y === null ? null : y * RAD_TO_DEG,
        z === null ? null : z * RAD_TO_DEG,
        intervalMs,
      );
    }

    function stopGenericSensor(): void {
      gyroscopeSensor?.stop();
      gyroscopeSensor = null;
      usingGenericSensor = false;
      genericSensorLastSampleTime = 0;
    }

    function pauseGenericSensor(): void {
      gyroscopeSensor?.stop();
      genericSensorLastSampleTime = 0;
    }

    function recoverFromGenericSensorFailure(): void {
      stopGenericSensor();
      if (
        !started ||
        pausedForFullscreen ||
        sensorsPausedForVisibility ||
        document.hidden ||
        !motionPermissionGranted
      ) {
        return;
      }
      window.removeEventListener("devicemotion", handleMotion);
      window.addEventListener("devicemotion", handleMotion, { signal });
      setStatus("Waiting");
      updateStageInfo();
      sensorWatchdog.start();
    }

    function resumeGenericSensor(): void {
      if (!usingGenericSensor || !gyroscopeSensor) return;
      try {
        gyroscopeSensor.start();
      } catch {
        recoverFromGenericSensorFailure();
      }
    }

    async function tryStartGenericSensor(): Promise<boolean> {
      const sensor = await startGenericSensor("Gyroscope", {
        signal,
        onReading: handleGenericGyroscopeReading,
        onError: recoverFromGenericSensorFailure,
      });
      gyroscopeSensor = sensor;
      return sensor !== null;
    }

    async function startTest(): Promise<void> {
      if (started || startInFlight) return;
      // iOS only shows the permission prompts while the click is being
      // handled, so request both before the first await.
      const permissionsRequest = requestMotionAndOrientationPermission();
      startInFlight = true;
      startCancelled = false;
      syncStartButton();

      if (
        !("DeviceOrientationEvent" in window) &&
        !("DeviceMotionEvent" in window) &&
        !genericSensorSupported()
      ) {
        setStatus("Unavailable");
        if (stageInfo)
          stageInfo.textContent = describeSensorUnavailability("unsupported");
        startInFlight = false;
        syncStartButton();
        return;
      }

      usingGenericSensor =
        genericSensorSupported() && (await tryStartGenericSensor());
      if (startCancelled) {
        stopGenericSensor();
        startInFlight = false;
        syncStartButton();
        return;
      }

      const results = await permissionsRequest;
      const permissions = {
        motion: results.motion.granted,
        orientation: results.orientation.granted,
      };
      if (startCancelled) {
        startInFlight = false;
        syncStartButton();
        return;
      }
      motionPermissionGranted = permissions.motion;
      orientationPermissionGranted = permissions.orientation;

      if (
        !usingGenericSensor &&
        !permissions.motion &&
        !permissions.orientation
      ) {
        const reason: SensorPermissionReason = "denied";
        const permanentlyDenied =
          (await getMotionPermissionState()) === "denied";
        setStatus("Permission blocked");
        if (stageInfo)
          stageInfo.textContent = describeSensorUnavailability(reason, {
            permanentlyDenied,
          });
        startInFlight = false;
        syncStartButton();
        return;
      }

      started = true;
      pausedForFullscreen = true;
      pauseGenericSensor();
      updateBiasCaptureUi();

      startInFlight = false;
      setStatus("Paused");
      syncStartButton();
      syncPauseNotice();
    }

    let sensorsPausedForVisibility = false;

    function pauseSensorsForVisibility(): void {
      if (!started || sensorsPausedForVisibility) return;
      sensorsPausedForVisibility = true;
      wakeLock.release();
      window.removeEventListener("deviceorientation", handleOrientation);
      window.removeEventListener("devicemotion", handleMotion);
      pauseGenericSensor();
      sensorWatchdog.stop();
      pauseBiasCapture();
      if (visualAnimationFrame !== 0) {
        cancelAnimationFrame(visualAnimationFrame);
        visualAnimationFrame = 0;
      }
    }

    function resumeSensorsForVisibility(): void {
      if (!started || !sensorsPausedForVisibility) return;
      sensorsPausedForVisibility = false;
      if (pausedForFullscreen) return;
      if (orientationPermissionGranted) {
        window.addEventListener("deviceorientation", handleOrientation, {
          signal,
        });
      }
      if (usingGenericSensor) {
        resumeGenericSensor();
      } else if (motionPermissionGranted) {
        window.addEventListener("devicemotion", handleMotion, { signal });
      }
      sensorWatchdog.start();
      ensureVisualAnimation();
      resumeBiasCapture();
      wakeLock.request();
    }

    function isFullscreenActive(): boolean {
      return shell?.dataset.fullscreen === "true";
    }

    function syncPauseNotice(): void {
      if (pauseNotice) {
        pauseNotice.hidden = isFullscreenActive() || !pausedForFullscreen;
      }
    }

    function syncStartButton(): void {
      if (!startButton) return;
      const isRunning = started && !pausedForFullscreen;
      startButton.classList.toggle("is-running", isRunning);
      startButton.setAttribute("aria-pressed", String(isRunning));
      startButton.toggleAttribute("disabled", startInFlight);
      startButton.textContent = startInFlight
        ? "Starting..."
        : isRunning
          ? "Pause"
          : pausedForFullscreen
            ? "Resume"
            : "Start";
    }

    function pauseSensorTest(): void {
      if (!started || pausedForFullscreen) return;
      pausedForFullscreen = true;
      shouldResumeAfterFullscreen = false;
      wakeLock.release();
      window.removeEventListener("deviceorientation", handleOrientation);
      window.removeEventListener("devicemotion", handleMotion);
      pauseGenericSensor();
      sensorWatchdog.stop();
      uiScheduler.cancel();
      pauseBiasCapture();
      if (visualAnimationFrame !== 0) {
        cancelAnimationFrame(visualAnimationFrame);
        visualAnimationFrame = 0;
      }
      setStatus("Paused");
      updateBiasCaptureUi();
      syncStartButton();
      syncPauseNotice();
    }

    function resumeSensorTest(): void {
      if (!started || document.hidden) return;
      pausedForFullscreen = false;
      sensorsPausedForVisibility = false;
      wakeLock.request();
      if (orientationPermissionGranted) {
        window.addEventListener("deviceorientation", handleOrientation, {
          signal,
        });
      }
      if (usingGenericSensor) {
        resumeGenericSensor();
      } else if (motionPermissionGranted) {
        window.addEventListener("devicemotion", handleMotion, { signal });
      }
      setStatus(hasAnyRotationData ? "Live" : "Waiting");
      updateStageInfo();
      sensorWatchdog.start();
      ensureVisualAnimation();
      resumeBiasCapture();
      requestSensorUiRefresh();
      syncStartButton();
      syncPauseNotice();
    }

    function requestSensorFullscreen(): void {
      shouldResumeAfterFullscreen = true;
      if (isFullscreenActive()) {
        shouldResumeAfterFullscreen = false;
        resumeSensorTest();
        return;
      }
      fullscreenButton?.click();
      showRuntimeControls();
    }

    async function handleStartButton(): Promise<void> {
      if (startInFlight) return;
      if (!started) {
        await startTest();
        if (!started) return;
      } else if (!pausedForFullscreen) {
        pauseSensorTest();
        showRuntimeControls();
        return;
      }
      requestSensorFullscreen();
    }

    function resetTest(): void {
      startCancelled = true;
      wakeLock.release();
      window.removeEventListener("deviceorientation", handleOrientation);
      window.removeEventListener("devicemotion", handleMotion);
      stopGenericSensor();
      started = false;
      sensorsPausedForVisibility = false;
      pausedForFullscreen = false;
      shouldResumeAfterFullscreen = false;
      motionPermissionGranted = false;
      orientationPermissionGranted = false;
      sensorWatchdog.stop();
      uiScheduler.cancel();
      if (visualAnimationFrame !== 0) {
        cancelAnimationFrame(visualAnimationFrame);
        visualAnimationFrame = 0;
      }
      cancelBiasCapture(false);
      biasCaptureState = "idle";

      hasRotationData = false;
      hasAnyRotationData = false;
      rateXAvailable = false;
      rateYAvailable = false;
      rateZAvailable = false;
      orientationAbsolute = false;
      latestAlpha = 0;
      latestBeta = 0;
      latestGamma = 0;
      latestRawRateX = 0;
      latestRawRateY = 0;
      latestRawRateZ = 0;
      rateX = 0;
      rateY = 0;
      rateZ = 0;
      resetRateBias();
      referenceAlpha = 0;
      referenceBeta = 0;
      referenceGamma = 0;
      orientationReferenceReady = false;
      visualTiltX = 0;
      visualTiltY = 0;
      visualRateZ = 0;
      visualDriftX = 0;
      visualDriftY = 0;
      peakSpin = 0;
      peakZSpin = 0;
      sampleCount = 0;
      orientationLastSampleTime = 0;
      rotationLastSampleTime = 0;
      alphaLastSampleTime = 0;
      betaLastSampleTime = 0;
      gammaLastSampleTime = 0;
      genericSensorLastSampleTime = 0;
      lastDetailedRefresh = 0;
      resetCorrectedRateHistory();
      tiltHistory.length = 0;
      headingHistory.length = 0;
      unwrappedHeadingHistory.length = 0;
      orientationIntervals.length = 0;
      rotationIntervals.length = 0;
      if (orientationModeLabel) orientationModeLabel.textContent = "Waiting";
      [
        alphaAngle,
        betaAngle,
        gammaAngle,
        xRateLabel,
        yRateLabel,
        zRateLabel,
      ].forEach((item) => {
        if (item) item.textContent = "--";
      });
      [alphaAngleBar, betaAngleBar, gammaAngleBar].forEach((bar, index) => {
        setAxisBar(bar, 0, index === 2 ? 90 : 180);
      });
      [xRateBar, yRateBar, zRateBar].forEach((bar) => setAxisBar(bar, 0, 360));

      if (runRate) runRate.textContent = "-- Hz";
      if (stageRate) stageRate.textContent = "-- Hz";
      if (runZRate) runZRate.textContent = "--";
      if (stageZRate) stageZRate.textContent = "--";
      if (twistRateValue) twistRateValue.textContent = "--";
      if (runTilt) runTilt.textContent = "--";
      if (stageTilt) stageTilt.textContent = "--";
      if (runHeading) runHeading.textContent = "--";
      if (stageHeading) stageHeading.textContent = "--";
      if (runPeak) runPeak.textContent = "--";
      if (stagePeak) stagePeak.textContent = "--";
      if (runDrift) runDrift.textContent = "--";
      if (stageDrift) stageDrift.textContent = "--";
      if (runMotionState) runMotionState.textContent = "Waiting";
      if (stageMotionState) stageMotionState.textContent = "Waiting";
      if (headingDriftLabel) headingDriftLabel.textContent = "--";
      if (headingStateLabel) headingStateLabel.textContent = "Waiting";
      if (peakSpinLabel) peakSpinLabel.textContent = "--";
      if (peakStateLabel) peakStateLabel.textContent = "Waiting";
      if (evidenceSourceLabel) evidenceSourceLabel.textContent = "--";
      if (evidenceAxesLabel) evidenceAxesLabel.textContent = "--";
      if (evidenceRateLabel) evidenceRateLabel.textContent = "-- Hz";
      if (evidencePeakLabel) evidencePeakLabel.textContent = "0 deg/s";
      if (graphWindowLabel) graphWindowLabel.textContent = "No samples yet";
      if (stage) stage.dataset.spinDirection = "idle";
      stage?.setAttribute("data-drift-state", "waiting");
      if (driftStateLabel) driftStateLabel.textContent = "Waiting for rate";
      if (driftScope) {
        driftScope.style.setProperty("--gyro-drift-x", "0px");
        driftScope.style.setProperty("--gyro-drift-y", "0px");
      }
      if (driftXyValue) driftXyValue.textContent = "0.0 deg/s";
      render3dStage();

      setStatus("Ready");
      syncStartButton();
      syncPauseNotice();
      updateCheckAvailability();
      updateBiasCaptureUi();
      drawGraph();
      updateStageInfo();
    }

    function queueGraphResize(): void {
      window.setTimeout(resizeGraph, 40);
    }

    function cleanupSensorPage(): void {
      resetTest();
      pageController.abort();
      stopOrientationWatch?.();
      stopOrientationWatch = null;
      graphResizeObserver?.disconnect();
      motionGraph.disconnect();
      graphResizeObserver = null;
      driftVisualResizeObserver?.disconnect();
      driftVisualResizeObserver = null;
    }

    checkButtons.forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const checkId = button.dataset.gyroCheck as GyroCheck | undefined;
          if (!checkId) return;
          setCheck(checkId);
        },
        { signal },
      );
    });

    startButton?.addEventListener("click", () => void handleStartButton(), {
      signal,
    });
    resetButton?.addEventListener("click", resetTest, { signal });
    captureBiasButton?.addEventListener("click", startBiasCapture, { signal });
    shell?.addEventListener(
      "tool-runtime:fullscreen-change",
      (event) => {
        const detail = (event as CustomEvent<{ isExpanded: boolean }>).detail;
        if (detail.isExpanded) {
          if (shouldResumeAfterFullscreen) {
            shouldResumeAfterFullscreen = false;
            resumeSensorTest();
          }
        } else {
          shouldResumeAfterFullscreen = false;
          if (started && !pausedForFullscreen) pauseSensorTest();
        }
        syncPauseNotice();
        queueGraphResize();
        showRuntimeControls();
      },
      { signal },
    );
    document.addEventListener(
      "visibilitychange",
      () => {
        if (document.hidden) {
          pauseSensorsForVisibility();
        } else {
          resumeSensorsForVisibility();
          requestSensorUiRefresh();
        }
      },
      { signal },
    );
    graphResizeObserver = observeResize(graphCanvas, resizeGraph);
    driftVisualResizeObserver = observeResize(gyroVisual, updateVisualScale);
    let stopOrientationWatch: (() => void) | null = onOrientationChange(() => {
      screenAngle = getScreenAngle();
      ensureVisualAnimation();
    });

    updateVisualScale();
    setCheck("level");
    resetTest();
    resizeGraph();
  </script>
</BaseLayout>
