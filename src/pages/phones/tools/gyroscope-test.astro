        transform 150ms ease,
        background 150ms ease,
        box-shadow 150ms ease;
    }

    .gyro-stage[data-drift-state="waiting"] .gyro-drift-dot {
      @apply bg-white ring-4 ring-white/10;
    }

    .gyro-stage[data-drift-state="minor"] .gyro-drift-dot {
      @apply bg-blue-300 ring-4 ring-blue-300/10;
    }

    .gyro-stage[data-drift-state="high"] .gyro-drift-dot {
      @apply bg-blue-500 ring-4 ring-blue-500/10;
    }

    .gyro-3d-scene {
      @apply relative grid h-full w-full place-items-center;
      perspective: 900px;
    }

    .gyro-3d-stage {
      @apply relative h-44 w-22;
      transform-style: preserve-3d;
      transform: rotateZ(var(--gyro-3d-z, 0deg)) rotateX(var(--gyro-3d-x, 0deg))
        rotateY(var(--gyro-3d-y, 0deg));
      transition: transform 90ms linear;
    }

    .gyro-3d-face {
      @apply absolute inset-0 rounded-3xl border-2 border-white bg-blue-500/30 ring-8 ring-blue-300/10;
      backface-visibility: hidden;
      transform: translateZ(0.5rem);
    }

