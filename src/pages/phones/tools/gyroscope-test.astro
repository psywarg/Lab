      .gyro-visual {
        width: min(83.333%, calc(83.333cqh * 16 / 9), 64rem);
      }
    }

    .gyro-check-visual {
      @apply absolute inset-0 grid place-items-center opacity-0 transition-opacity duration-200 ease-out;
    }

    .gyro-attitude {
      @apply relative aspect-square w-[80%] max-w-[350px] overflow-hidden rounded-full border-4 border-blue-500 bg-white/10 ring-10 ring-blue-300/10;
    }

    .gyro-attitude::before {
      @apply pointer-events-none absolute inset-[10%] z-2 rounded-full border border-blue-300 bg-[linear-gradient(90deg,transparent_calc(50%-1px),rgb(142_197_255/0.25)_50%,transparent_calc(50%+1px)),linear-gradient(transparent_calc(50%-1px),rgb(142_197_255/0.50)_50%,transparent_calc(50%+1px))] content-[''];
    }

    .gyro-attitude-horizon {
      @apply absolute top-[-30%] left-[-30%] h-[160%] w-[160%] bg-linear-to-b from-blue-300/80 from-49% via-blue-500/60 via-50% to-blue-300/40 to-51%;
      @apply [transform:translateY(var(--gyro-pitch))_rotate(var(--gyro-roll))] shadow-inner transition-transform duration-[90ms] ease-linear;
    }

    .gyro-attitude-reticle {
      @apply absolute top-1/2 left-1/2 z-3 h-0.5 w-[55%] rounded-full;
      @apply bg-linear-to-r from-white from-30% via-transparent via-50% to-white to-70%;
      @apply -translate-x-1/2 -translate-y-1/2;
    }

    .gyro-attitude-reticle::before {
      @apply absolute top-1/2 left-1/2 size-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-white/50 content-[''];
    }

    .gyro-twist-rate-gauge {
      @apply relative aspect-square w-[80%] max-w-[350px] rounded-4xl border border-blue-500 ring-10 ring-blue-300/10;
    }

    .gyro-twist-rate-gauge svg {
      @apply absolute inset-0 h-full w-full overflow-visible;
    }

    .gyro-twist-scale {
      @apply fill-none [stroke:rgb(142_197_255/0.4)] [stroke-width:4] [stroke-linecap:round] [vector-effect:non-scaling-stroke];
