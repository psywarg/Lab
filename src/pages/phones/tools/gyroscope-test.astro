      @apply [stroke:rgb(142_197_255/0.50)] [stroke-width:6];
    }

    .gyro-twist-scale-label {
      @apply [fill:rgb(255_255_255)] text-[12px] font-bold tracking-[0];
    }

    .gyro-twist-scale-label--counter {
      @apply [text-anchor:start];
    }

    .gyro-twist-scale-label--zero {
      @apply [text-anchor:middle];
    }

    .gyro-twist-scale-label--clockwise {
      @apply [text-anchor:end];
    }

    .gyro-twist-direction-arc {
      @apply fill-none [stroke:rgb(142_197_255/0.5)] [stroke-width:6] [stroke-linecap:round] opacity-50 [vector-effect:non-scaling-stroke];
      transition:
        opacity 140ms ease,
        stroke 140ms ease,
        stroke-width 140ms ease;
    }

    .gyro-twist-arrow-marker path {
      @apply [fill:rgb(142_197_255)];
    }

    .gyro-stage[data-spin-direction="counter"]
      .gyro-twist-direction-arc--counter,
    .gyro-stage[data-spin-direction="clockwise"]
      .gyro-twist-direction-arc--clockwise {
      @apply [stroke:rgb(142_197_255/1)] [stroke-width:7] opacity-100;
    }

    .gyro-stage[data-spin-direction="counter"]
      .gyro-twist-direction-arc--clockwise,
    .gyro-stage[data-spin-direction="clockwise"]
      .gyro-twist-direction-arc--counter {
      @apply opacity-25;
    }

    .gyro-twist-needle {
      @apply [stroke:rgb(255_255_255)] [stroke-width:4] [stroke-linecap:round] [vector-effect:non-scaling-stroke];
      transform: rotate(var(--gyro-z-angle, 0deg));
