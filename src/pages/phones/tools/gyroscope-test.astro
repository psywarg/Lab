---
// src/pages/phones/tools/gyroscope-test.astro

export const prerender = true;

import ToolReference from "@/components/phones/tools/Reference.astro";
import ToolSidebar from "@/components/phones/tools/Sidebar.astro";
import ToolRuntime from "@/components/phones/tools/Runtime.astro";
import { getToolBySlug } from "@/content/phones/tools";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createToolApplicationSchema, SITE_ORIGIN } from "@/utils/site/schema";
import ToolIcons from "@/assets/icons/tools-sprites.svg?url";

const tool = getToolBySlug("gyroscope-test");
const ogImage = tool.image;
const title = "Free Online Gyroscope Test: Rotation, Drift & 3D Tracking";
const metaDescription =
  "Check pitch, roll, yaw, X, Y, and Z rotation rates, twist direction, peak spin, and drift. Capture a local zero-rate offset directly in your browser.";

const referenceItems = [
  {
    label: "Level",
    check:
      "Start while flat, then tilt slightly and watch the browser-reported orientation horizon show pitch and roll.",
    reading:
      "This check uses fused orientation angles rather than raw angular rate. Pitch is forward/backward tilt and roll is side-to-side tilt. Angles are shown in degrees.",
    good: "The horizon moves and banks smoothly, then returns close to level when the phone is flat again.",
    concern:
      "The horizon jumps, drifts while still, or one tilt direction barely reacts.",
  },
  {
    label: "Zero-rate",
    check:
      "After starting, place the phone flat and completely still, press Zero rate, and keep it still for the three-second capture.",
    reading:
      "The tool averages the resting X, Y, and Z rotation rates and subtracts that offset from this page's readings. It does not recalibrate or repair the phone's gyroscope.",
    good:
      "The capture completes, resting rates move closer to zero, and the offset is reported as captured.",
    concern:
      "The capture reports a high offset (5.5 deg/s or more), or a large resting rate returns immediately while the phone remains still. A rejected capture means the phone moved; hold it still and try again.",
  },
  {
    label: "Twist",
    check:
      "Place the phone flat and still for a moment, then rotate it around the center of its screen while watching the signed Z-axis rate gauge.",
    reading:
      "Z is the rotation axis pointing through the screen. Facing the screen, + CCW means a positive counter-clockwise turn and - CW means a negative clockwise turn. deg/s means degrees turned per second; the signs are directions, not scores.",
    good: "From the screen-facing view, positive Z-rate moves counter-clockwise and negative Z-rate moves clockwise, then returns near zero when the phone stops.",
    concern:
      "The needle sticks, moves the wrong way, or stays far from zero after the phone stops.",
  },
  {
    label: "Drift",
    check:
      "After capturing zero-rate, hold the phone flat and still, then watch whether the resting-spin dot stays near the center target.",
    reading:
      "The square maps corrected X and Y rotation rate to the moving dot. The Drift score is the average resting rotation across X, Y, and Z over the last 48 samples, taken from the unfiltered readings minus any captured offset. Resting noise shows how much those readings scatter around that average.",
    good: "The dot stays inside the center ring and the Drift score settles close to zero after movement stops.",
    concern:
      "The dot sits away from center or the Drift score keeps reporting rotation while the phone rests.",
  },
  {
    label: "3D View",
    check:
      "Start the test, then tilt and rotate the phone slowly on each axis and watch the 3D model follow.",
    reading:
      "This view renders the phone's fused orientation (accelerometer, gyroscope, and compass where present), not an isolated gyroscope reading. It shows the orientation pipeline is working end to end.",
    good: "The model tracks smoothly and matches the phone's real orientation on every axis, including flipping face-down.",
    concern:
      "The model sticks, tracks the wrong axis, or never responds to a slow, deliberate rotation.",
  },
];

const gyroChecks = [
  {
    id: "level",
    icon: "gyro-level",
    label: "Level",
    meta: "Pitch and roll response",
    hint: "Start while flat, then tilt gently and watch whether the attitude horizon follows smoothly.",
  },
  {
    id: "twist",
    icon: "gyro-twist",
    label: "Twist",
    meta: "Z-axis turn rate",
    hint: "Keep the phone flat and still briefly, then rotate it flat and confirm the signed Z-axis rate follows the marked direction, reverses, then returns to zero.",
  },
  {
    id: "drift",
    icon: "gyro-drift",
    label: "Drift",
    meta: "Zero-rate stability",
    hint: "Keep the phone flat and still: X/Y should keep the dot near center, Z-rate should stay near zero, and the Drift score should settle near zero.",
  },
  {
    id: "3d",
    icon: "motion-3d",
    label: "3D View",
    meta: "Fused orientation model",
    hint: "Tilt and rotate slowly and confirm the 3D model tracks the phone's real orientation.",
  },
];

const sidebarGroups = [
  {
    title: "Select check",
    openByDefault: true,
    attributes: { "data-gyro-accordion": "" },
    items: gyroChecks.map((check, index) => ({
      label: check.label,
      meta: check.meta,
      visual: {
        type: "icon" as const,
        spriteUrl: ToolIcons,
        spriteId: check.icon,
      },
      active: index === 0,
      attributes: {
        "data-gyro-check": check.id,
        "data-gyro-tip": check.hint,
      },
    })),
  },
];

const structuredData = createToolApplicationSchema({
  name: title,
  description: metaDescription,
  url: `${SITE_ORIGIN}${tool.href}`,
});
---

<BaseLayout
  {title}
  {metaDescription}
  {ogImage}
  {structuredData}
  robots="index, follow"
  breadcrumbLabels={{
    tools: "Tools",
    "gyroscope-test": "Gyroscope Sensor Check",
  }}
>
  <section>
    <div class="mb-6 grid gap-4">
      <div>
        <h1>Gyroscope Tester: Rotation Sensor Checks</h1>
        <p>
          Test four aspects of phone rotation sensing directly in your browser.
          Tilt the device to follow pitch and roll on the orientation horizon,
          twist it to check the signed Z-axis rate and direction, hold it still
          to examine X, Y, and Z drift, and rotate it to compare a fused 3D
          orientation model. Capture a three-second zero-rate offset, then review
          live sensor rate, tilt, yaw, peak rotation, axis readings, and rolling
          data. The
          zero-rate capture changes only this page's readings and does not
          recalibrate the phone. The 3D view uses fused orientation data where
          available, rather than the gyroscope alone, and browser readings are
          not a hardware calibration or service test.
        </p>
      </div>
    </div>

    <div class="tool-page-shell">
      <div class="tool-page-main">
        <ToolRuntime
          shellId="gyro-shell"
          fullscreenButtonId="gyro-fullscreen"
          actionBarLabel="Gyroscope actions"
          stageStatsMode="fullscreen-only"
          stageStatsFillMobile={true}
          buttons={[
            {
              label: "Start",
              tone: "success",
              attributes: { id: "gyro-start" },
            },
            {
              label: "Zero rate",
              attributes: { id: "gyro-capture-bias", disabled: "true" },
            },
            {
              label: "Reset",
              tone: "danger",
              attributes: { id: "gyro-reset" },
            },
          ]}
          stats={[
            {
              label: "Status",
              value: "Ready",
              attributes: { "data-stat-id": "status" },
              valueAttributes: { id: "gyro-run-status" },
            },
            {
              label: "Motion",
              value: "Still",
              attributes: { "data-stat-id": "motion" },
              valueAttributes: { id: "gyro-run-motion" },
            },
            {
              label: "Rate",
              value: "-- Hz",
              attributes: { "data-stat-id": "rate" },
              valueAttributes: { id: "gyro-run-rate" },
            },
            {
              label: "Tilt",
              value: "0.0°",
              attributes: { "data-stat-id": "tilt" },
              valueAttributes: { id: "gyro-run-tilt" },
            },
            {
              label: "Yaw",
              value: "0.0°",
              attributes: { "data-stat-id": "heading" },
              valueAttributes: { id: "gyro-run-heading" },
            },
            {
              label: "Z Rate",
              value: "0 deg/s",
              attributes: { "data-stat-id": "zrate" },
              valueAttributes: { id: "gyro-run-z-rate" },
            },
            {
              label: "Peak Z",
              value: "0 deg/s",
              attributes: { "data-stat-id": "peak" },
              valueAttributes: { id: "gyro-run-peak" },
            },
            {
              label: "Drift",
              value: "0.0 deg/s",
              attributes: { "data-stat-id": "drift" },
              valueAttributes: { id: "gyro-run-drift" },
            },
          ]}
          stageStats={[
            {
              label: "Check",
              value: "Level",
              attributes: { "data-stat-id": "check" },
              valueAttributes: { id: "gyro-stage-check-legend" },
            },
            {
              label: "Status",
              value: "Ready",
              attributes: { "data-stat-id": "status" },
              valueAttributes: { id: "gyro-stage-status" },
            },
            {
              label: "Motion",
              value: "Still",
              attributes: { "data-stat-id": "motion" },
              valueAttributes: { id: "gyro-stage-motion" },
            },
            {
              label: "Rate",
              value: "-- Hz",
              attributes: { "data-stat-id": "rate" },
              valueAttributes: { id: "gyro-stage-rate" },
            },
            {
              label: "Tilt",
              value: "0.0°",
              attributes: { "data-stat-id": "tilt" },
              valueAttributes: { id: "gyro-stage-tilt" },
            },
            {
              label: "Yaw",
              value: "0.0°",
              attributes: { "data-stat-id": "heading" },
              valueAttributes: { id: "gyro-stage-heading" },
            },
            {
              label: "Z Rate",
              value: "0 deg/s",
              attributes: { "data-stat-id": "zrate" },
              valueAttributes: { id: "gyro-stage-z-rate" },
            },
            {
              label: "Peak Z",
              value: "0 deg/s",
              attributes: { "data-stat-id": "peak" },
              valueAttributes: { id: "gyro-stage-peak" },
            },
            {
              label: "Drift",
              value: "0.0 deg/s",
              attributes: { "data-stat-id": "drift" },
              valueAttributes: { id: "gyro-stage-drift" },
            },
          ]}
        >
          <div
            id="gyro-stage"
            class="gyro-stage"
            data-check="level"
            data-spin-direction="idle"
            data-drift-state="waiting"
          >
            <div class="gyro-visual" aria-hidden="true">
              <div class="gyro-check-visual gyro-check-visual--level">
                <div class="gyro-attitude">
                  <span class="gyro-attitude-horizon"></span>
                  <span class="gyro-attitude-reticle"></span>
                </div>
              </div>
              <div class="gyro-check-visual gyro-check-visual--twist">
                <div class="gyro-twist-rate-gauge">
                  <svg viewBox="0 0 320 220">
                    <defs>
                      <marker
                        id="gyro-twist-arrow"
                        class="gyro-twist-arrow-marker"
                        viewBox="0 0 10 10"
                        refX="8"
                        refY="5"
                        markerWidth="2.2"
                        markerHeight="2.2"
                        orient="auto"
                      >
                        <path d="M0 0 L10 5 L0 10 Z"></path>
                      </marker>
                    </defs>
                    <path
                      class="gyro-twist-scale"
                      d="M38 176 A122 122 0 0 1 282 176"></path>
                    <g class="gyro-twist-ticks">
                      <line
                        class="gyro-twist-tick gyro-twist-tick--major"
                        x1="160"
                        y1="64"
                        x2="160"
                        y2="76"
                        transform="rotate(-90 160 176)"></line>
                      <line
                        class="gyro-twist-tick"
                        x1="160"
                        y1="64"
                        x2="160"
                        y2="73"
                        transform="rotate(-60 160 176)"></line>
                      <line
                        class="gyro-twist-tick"
                        x1="160"
                        y1="64"
                        x2="160"
                        y2="73"
                        transform="rotate(-30 160 176)"></line>
                      <line
                        class="gyro-twist-tick gyro-twist-tick--major"
                        x1="160"
                        y1="62"
                        x2="160"
                        y2="76"></line>
                      <line
                        class="gyro-twist-tick"
                        x1="160"
                        y1="64"
                        x2="160"
                        y2="73"
                        transform="rotate(30 160 176)"></line>
                      <line
                        class="gyro-twist-tick"
                        x1="160"
                        y1="64"
                        x2="160"
                        y2="73"
                        transform="rotate(60 160 176)"></line>
                      <line
                        class="gyro-twist-tick gyro-twist-tick--major"
                        x1="160"
                        y1="64"
                        x2="160"
                        y2="76"
                        transform="rotate(90 160 176)"></line>
                    </g>
                    <text
                      class="gyro-twist-scale-label gyro-twist-scale-label--counter"
                      x="32"
                      y="202">+ CCW</text
                    >
                    <text
                      class="gyro-twist-scale-label gyro-twist-scale-label--zero"
                      x="160"
                      y="42">0</text
                    >
                    <text
                      class="gyro-twist-scale-label gyro-twist-scale-label--clockwise"
                      x="288"
                      y="202">- CW</text
                    >
                    <path
                      class="gyro-twist-direction-arc gyro-twist-direction-arc--counter"
                      d="M160 54 A122 122 0 0 0 38 176"
                      marker-end="url(#gyro-twist-arrow)"></path>
                    <path
                      class="gyro-twist-direction-arc gyro-twist-direction-arc--clockwise"
                      d="M160 54 A122 122 0 0 1 282 176"
                      marker-end="url(#gyro-twist-arrow)"></path>
                    <line
                      id="gyro-twist-needle"
                      class="gyro-twist-needle"
                      x1="160"
                      y1="176"
                      x2="160"
                      y2="78"></line>
                    <circle class="gyro-twist-hub" cx="160" cy="176" r="11"
                    ></circle>
                  </svg>
                  <strong id="gyro-twist-rate-value">0 deg/s</strong>
                </div>
              </div>
              <div class="gyro-check-visual gyro-check-visual--drift">
                <div class="gyro-drift-scope">
                  <div class="gyro-drift-target">
                    <span class="gyro-drift-cross gyro-drift-cross--x"></span>
                    <span class="gyro-drift-cross gyro-drift-cross--y"></span>
                    <span class="gyro-drift-ring gyro-drift-ring--outer"></span>
                    <span class="gyro-drift-ring gyro-drift-ring--inner"></span>
                    <span class="gyro-drift-axis-label gyro-drift-axis-label--x"
                      >X</span
                    >
                    <span class="gyro-drift-axis-label gyro-drift-axis-label--y"
                      >Y</span
                    >
                    <span class="gyro-drift-axis-label gyro-drift-axis-label--z"
                      >Z</span
                    >
                    <span id="gyro-drift-dot" class="gyro-drift-dot"></span>
                  </div>
                  <div class="gyro-drift-summary">
                    <strong id="gyro-drift-state">Waiting</strong>
                    <span>
                      X/Y
                      <b id="gyro-drift-xy-value">0.0 deg/s</b>
                    </span>
                  </div>
                </div>
              </div>
              <div class="gyro-check-visual gyro-check-visual--3d">
                <div class="gyro-3d-scene">
                  <div id="gyro-3d-stage" class="gyro-3d-stage">
                    <span class="gyro-3d-face gyro-3d-face--front">
                      <span class="gyro-3d-notch"></span>
                    </span>
                    <span class="gyro-3d-face gyro-3d-face--back"></span>
                  </div>
                </div>
              </div>
            </div>
            <div
              id="gyro-pause-notice"
              class="bg-custom-100 dark:bg-custom-700 border-accent-line shadow-accent-glow pointer-events-none absolute top-1/2 left-1/2 z-6 grid w-[min(18rem,calc(100%-2rem))] -translate-x-1/2 -translate-y-1/2 gap-1 rounded-2xl border px-4 py-3 text-center shadow-md"
              hidden
              role="status"
              aria-live="polite"
            >
              <strong class="text-small leading-tight text-slate-800 dark:text-slate-200"
                >Paused</strong
              >
              <span class="text-xsmall leading-snug text-slate-700 dark:text-slate-300"
                >Press Resume to continue in fullscreen.</span
              >
            </div>
            <span id="gyro-stage-info" class="sr-only">
              Start while the phone is flat, then keep it level briefly before
              each check.
            </span>
          </div>

          <p slot="dockLead" id="gyro-dock-tip">
            {gyroChecks[0]?.hint}
          </p>
        </ToolRuntime>

        <div
          id="gyro-readouts"
          class="bg-custom-100 dark:bg-custom-700 border-accent-line shadow-accent-glow grid gap-2 rounded-xl border p-2.5 shadow-md sm:gap-3 sm:rounded-2xl sm:p-3"
          aria-label="Live gyroscope readouts"
        >
          <div class="grid gap-3 md:grid-cols-2">
            <section
              class="gyro-readout-panel--angles border-accent-line grid gap-2 rounded-xl border p-2.5 sm:gap-3 sm:rounded-2xl sm:p-3"
              aria-label="Orientation angles"
            >
              <div class="flex min-w-0 items-baseline justify-between gap-3">
                <strong class="sensor-panel-title">Orientation angles</strong>
                <span id="orientation-mode" class="sensor-panel-unit"
                  >Waiting</span
                >
              </div>
              <div class="grid grid-cols-3 gap-1.5 sm:gap-3">
                <div class="axis-stat">
                  <div class="axis-stat-row">
                    <span class="axis-stat-label">Alpha</span>
                    <strong id="alpha-angle" class="axis-stat-value">--</strong>
                  </div>
                  <div class="axis-track"><i id="alpha-angle-bar"></i></div>
                </div>
                <div class="axis-stat">
                  <div class="axis-stat-row">
                    <span class="axis-stat-label">Beta</span>
                    <strong id="beta-angle" class="axis-stat-value">--</strong>
                  </div>
                  <div class="axis-track"><i id="beta-angle-bar"></i></div>
                </div>
                <div class="axis-stat">
                  <div class="axis-stat-row">
                    <span class="axis-stat-label">Gamma</span>
                    <strong id="gamma-angle" class="axis-stat-value">--</strong>
                  </div>
                  <div class="axis-track">
                    <i id="gamma-angle-bar"></i>
                  </div>
                </div>
              </div>
            </section>

            <section
              class="gyro-readout-panel--rates border-accent-line grid gap-2 rounded-xl border p-2.5 sm:gap-3 sm:rounded-2xl sm:p-3"
              aria-label="Rotation rate"
            >
              <div class="flex min-w-0 items-baseline justify-between gap-3">
                <strong class="sensor-panel-title">Rotation rate</strong>
                <span class="sensor-panel-unit">deg/s</span>
              </div>
              <div class="grid grid-cols-3 gap-1.5 sm:gap-3">
                <div class="axis-stat">
                  <div class="axis-stat-row">
                    <span class="axis-stat-label">X</span>
                    <strong id="x-rate" class="axis-stat-value">--</strong>
                  </div>
                  <div class="axis-track"><i id="x-rate-bar"></i></div>
                </div>
                <div class="axis-stat">
                  <div class="axis-stat-row">
                    <span class="axis-stat-label">Y</span>
                    <strong id="y-rate" class="axis-stat-value">--</strong>
                  </div>
                  <div class="axis-track"><i id="y-rate-bar"></i></div>
                </div>
                <div class="axis-stat">
                  <div class="axis-stat-row">
                    <span class="axis-stat-label">Z</span>
                    <strong id="z-rate" class="axis-stat-value">--</strong>
                  </div>
                  <div class="axis-track"><i id="z-rate-bar"></i></div>
                </div>
              </div>
            </section>
          </div>

          <section
            class="border-accent-line grid gap-2 rounded-xl border p-2.5 sm:gap-3 sm:rounded-2xl sm:p-3"
            aria-label="Diagnostic checks"
          >
            <div class="flex min-w-0 items-baseline justify-between gap-3">
              <strong class="sensor-panel-title">Diagnostic checks</strong>
              <span id="graph-window-label" class="sensor-panel-unit"
                >Last 48 samples</span
              >
            </div>
            <div class="grid grid-cols-2 gap-2 sm:gap-3">
              <div class="gyro-diag-card">
                <div class="gyro-diag-row">
                  <span class="gyro-diag-label">Peak spin</span>
                  <strong id="peak-spin" class="gyro-diag-value">0 deg/s</strong
                  >
                </div>
                <small id="peak-state" class="gyro-diag-state"
                  >No spike yet</small
                >
              </div>
              <div class="gyro-diag-card">
                <div class="gyro-diag-row">
                  <span class="gyro-diag-label">Yaw drift</span>
                  <strong id="heading-drift" class="gyro-diag-value"
                    >0.0 deg</strong
                  >
                </div>
                <small id="heading-state" class="gyro-diag-state">Stable</small>
              </div>
            </div>

            <canvas
              id="gyro-graph"
              class="gyro-graph"
              aria-label="Rolling gyroscope diagnostic graph"></canvas>
          </section>

          <section
            class="border-accent-line grid gap-2 rounded-xl border p-2.5 sm:gap-3 sm:rounded-2xl sm:p-3"
            aria-label="Measured evidence"
          >
            <div class="flex min-w-0 items-baseline justify-between gap-3">
              <strong class="sensor-panel-title">Measured Evidence</strong>
              <span id="evidence-source" class="sensor-panel-unit">--</span>
            </div>
            <p class="text-xsmall m-0 text-slate-700 dark:text-slate-300">
              A browser cannot recalibrate gyroscope hardware. "Zero rate"
              measures the resting offset while the phone is held
              still and subtracts it for this page only -- it does not touch the
              device.
            </p>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3">
              <div class="gyro-diag-card">
                <div class="gyro-diag-row">
                  <span class="gyro-diag-label">Axes present</span>
                  <strong id="evidence-axes" class="gyro-diag-value">--</strong>
                </div>
                <small class="gyro-diag-state">X / Y / Z</small>
              </div>
              <div class="gyro-diag-card">
                <div class="gyro-diag-row">
                  <span class="gyro-diag-label">Measured rate</span>
                  <strong id="evidence-rate" class="gyro-diag-value"
                    >-- Hz</strong
                  >
                </div>
                <small class="gyro-diag-state">Sample delivery</small>
              </div>
              <div class="gyro-diag-card">
                <div class="gyro-diag-row">
                  <span class="gyro-diag-label">Zero-rate offset</span>
                  <strong id="bias-score" class="gyro-diag-value">--</strong>
                </div>
                <small id="bias-state" class="gyro-diag-state"
                  >Not captured -- hold still and capture</small
                >
              </div>
              <div class="gyro-diag-card">
                <div class="gyro-diag-row">
                  <span class="gyro-diag-label">Resting noise</span>
                  <strong id="noise-score" class="gyro-diag-value">--</strong>
                </div>
                <small id="noise-state" class="gyro-diag-state"
                  >Waiting for rate</small
                >
              </div>
              <div class="gyro-diag-card col-span-2 sm:col-span-1">
                <div class="gyro-diag-row">
                  <span class="gyro-diag-label">Peak spin recorded</span>
                  <strong id="evidence-peak" class="gyro-diag-value"
                    >0 deg/s</strong
                  >
                </div>
                <small class="gyro-diag-state">This session</small>
              </div>
            </div>
          </section>
        </div>
        <ToolReference
          title="How to Use This Tool and Read the Results"
          items={referenceItems}
        />
      </div>

      <div class="lg:col-span-1">
        <ToolSidebar
          currentSlug={tool.slug}
          groups={sidebarGroups}
          panelLabel="Gyroscope checks and related tools"
        />
      </div>
    </div>
  </section>

  <style>
    @reference "#app.css";

    :global(#gyro-start.is-running) {
      @apply bg-linear-to-br from-yellow-400 to-yellow-600;
    }

    .gyro-stage {
      @apply relative grid size-full place-items-center [--gyro-pitch:0px] [--gyro-roll:0deg] [--gyro-z-angle:0deg];
      container-type: size;
    }

