    const spotIsolationBackground = "#000000";
    const CONSENT_STORAGE_KEY = "phones-tools:stuck-pixel-consent";

    const NOISE_FALLBACK_WIDTH = 400;
    const NOISE_FALLBACK_HEIGHT = 250;

    const NOISE_TILE_SIZE = 128;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    type ChannelMask = { r: boolean; g: boolean; b: boolean };
    const FULL_CHANNEL_MASK: ChannelMask = { r: true, g: true, b: true };

    type PatternDefinition = {
      label: string;
      note: string;
      colors: string[];
      isNoise?: boolean;
      channelMask?: ChannelMask;
    };

    const patternLibrary: Record<string, PatternDefinition> = {
      rgb: {
        label: "RGB",
        note: "Color cycling for a colored stuck sub-pixel. Speed is limited by the selected repair mode.",
        colors: ["#ff0000", "#00ff00", "#0000ff"],
      },
      cmy: {
        label: "CMY",
        note: "Cyan, magenta, and yellow manual color cycling.",
        colors: ["#00ffff", "#ff00ff", "#ffff00"],
      },
      rgbwb: {
        label: "RGB + White + Black",
        note: "Broader cycle for bright or white-hot stuck pixels.",
        colors: ["#ff0000", "#00ff00", "#0000ff", "#ffffff", "#000000"],
      },
      rgbcmy: {
        label: "RGB + CMY",
        note: "Exercises more color transitions without jumping straight to a harsh contrast pulse.",
        colors: [
          "#ff0000",
          "#00ff00",
          "#0000ff",
          "#00ffff",
          "#ff00ff",
          "#ffff00",
        ],
      },
      contrast: {
        label: "B/W",
        note: "Highest contrast option. Use this only after gentler patterns fail.",
        colors: ["#000000", "#ffffff"],
      },
      static: {
        label: "Static Noise",
        note: "Recommended. Independently toggles each red, green and blue sub-pixel. Starts at 15fps and adjusts up to 30fps.",
        colors: [],
        isNoise: true,
      },
    };

    function diagnosisDescription(mark: DiagnosisMark): string {
      return describeDiagnosis(mark, (id) => patternLibrary[id]?.label ?? id);
    }

    let colorIndex = 0;
    let flashFrame = 0;
    let lastFlashTime = 0;
    let countdownTimer: ReturnType<typeof setInterval> | null = null;
    let endsAt = 0;
    let runPaused = false;
    let pausedRunRemainingMs = 0;
    let selectedPatternId = "static";
    let pendingSpotPosition: { clientX: number; clientY: number } | null = null;
    let spotFrame = 0;
    let spotStageRect: DOMRect | null = null;
    let spotDragging = false;
    let pendingFullscreenAction:
      | "run"
      | "diagnose"
      | "diagnose-resume"
      | null = null;
    let pendingRunDurationMs: number | null = null;
    let noiseTileCanvas: HTMLCanvasElement | null = null;
    let noiseTileCtx: CanvasRenderingContext2D | null = null;
    let noiseTileImageData: ImageData | null = null;
    const xorshift32 = createXorshift32();

    type WorkflowMode = "auto" | "manual";
    type ManualColorGroup = "rgb" | "cmy" | "contrast";
    const STEP_VIEW_SECONDS = 10;

    let diagnosisActive = false;
    let diagnosisViewing = false;
    let diagnosisPaused = false;
    let diagnosisStep = 0;
    let sessionTaps: StepTap[] = [];
    let diagnosisMarkerElements: HTMLElement[] = [];
    let diagnosedMarks: DiagnosisMark[] = [];
    let autoMarkHighlightTimer: ReturnType<typeof setTimeout> | null = null;
    let workflowMode: WorkflowMode = "auto";
    let autoRepairQueue: AutoRepairItem[] = [];
    let autoQueueIndex = 0;
    let autoQueueRunning = false;
    let autoQueueComplete = false;
    let manualSelectedPatternId = "static";
    const manualColorGroups = new Set<ManualColorGroup>();
    let stepCountdownTimer: ReturnType<typeof setInterval> | null = null;
    let stepCountdownRemaining = 0;
    const DIAGNOSIS_COLORS: DiagnosisColor[] = [...QUICK_DIAGNOSIS_COLORS];
    // After the colour steps: marks found, and the extra questions that
    // settle near-ties (one test colour re-checked for one mark).
    let pendingClusters: ReturnType<typeof clusterTaps> = [];
    let followUps: { markIndex: number; color: InspectColorId }[] = [];
    let followUpIndex = 0;
    let followUpAnswers: Partial<Record<InspectColorId, boolean>>[] = [];
    // After Auto finishes: which flashed marks are still visible. Round 2 is
    // the optional longer run on the marks that persisted.
    let checkMarkIndexes: number[] = [];
    let checkIndex = 0;
    let checkResults = new Map<number, CheckOutcome>();
    let autoRound: 1 | 2 = 1;

    const pageController = new AbortController();
    const wakeLock = createWakeLock({
      signal: pageController.signal,
      onRelease: () => {
        if (wakeLockNote) wakeLockNote.hidden = false;
      },
    });

    function currentPattern(): PatternDefinition {
      return patternLibrary[selectedPatternId] ?? patternLibrary.rgb;
    }

    function currentRunDetail(): string {
      const patternLabel = currentPattern().label;
      const item = autoRepairQueue[autoQueueIndex];
      if (workflowMode !== "auto" || !item) return patternLabel;
      // Count only the marks Auto flashes; the number names the mark on screen.
      const queued = queuedMarkIndexes();
      return `Mark #${item.markIndex + 1} (${queued.indexOf(item.markIndex) + 1}/${queued.length}) • ${patternLabel}`;
    }

    function queuedMarkIndexes(): number[] {
      return [...new Set(autoRepairQueue.map((entry) => entry.markIndex))];
    }

    const MANUAL_COLOR_GROUP_ORDER: ManualColorGroup[] = [
      "rgb",
      "cmy",
      "contrast",
    ];

    function buildManualColorPattern(): PatternDefinition {
      const selectedGroups = MANUAL_COLOR_GROUP_ORDER.filter((group) =>
        manualColorGroups.has(group),
      );
      const labels = selectedGroups.map(
        (group) => patternLibrary[group]?.label ?? group.toUpperCase(),
      );
      return {
        label: labels.join(" + ") || "Static Noise",
        note: "A custom manual cycle built from the selected color groups.",
        colors: selectedGroups.flatMap(
          (group) => patternLibrary[group]?.colors ?? [],
        ),
      };
    }

    function activateManualColorPattern(): void {
      if (manualColorGroups.size === 0) {
        manualSelectedPatternId = "static";
      } else {
        patternLibrary["manual-custom"] = buildManualColorPattern();
        manualSelectedPatternId = "manual-custom";
      }
      selectedPatternId = manualSelectedPatternId;
      syncManualPatternButtons();
      syncPattern();
    }

    function syncManualPatternButtons(): void {
      repairButtons.forEach((button) => {
        const patternId = button.dataset.patternId;
        const isNoise = button.dataset.patternKind === "noise";
        const isSelected = isNoise
          ? manualSelectedPatternId === "static"
          : manualColorGroups.has(patternId as ManualColorGroup);
        button.setAttribute("aria-pressed", String(isSelected));
      });
    }

    function setManualSidebarAvailability(enabled: boolean): void {
      manualSidebarGroups.forEach((group) => {
        group.dataset.manualDisabled = String(!enabled);
        group.setAttribute("aria-disabled", String(!enabled));
      });
      [...repairButtons, ...inspectButtons].forEach((button) => {
        button.disabled = !enabled;
      });
    }

    function markCoordinateLabel(mark: DiagnosisMark, index: number): string {
      const x = Math.round(mark.x * 100);
      const y = Math.round(mark.y * 100);
      return `#${index + 1} - ${x}% ${y}%`;
    }

    function updateDiagnosisSummary(index: number): void {
      const mark = diagnosedMarks[index];
      if (!diagnosisSummary) return;
      diagnosisSummary.hidden = workflowMode !== "auto" || !mark;
      if (!mark) return;

      const identifiedCount = diagnosedMarks.filter(
        (result) => result.classification !== "unclear",
      ).length;
      if (diagnosisSummaryTitle) {
        diagnosisSummaryTitle.textContent = `#${index + 1} ${classificationShortLabel(mark)}`;
      }
      if (diagnosisSummaryCount) {
        diagnosisSummaryCount.textContent = `${identifiedCount}/${diagnosedMarks.length} identified`;
      }
      if (diagnosisSummaryBody) {
        diagnosisSummaryBody.textContent = diagnosisDescription(mark);
      }
    }

    function renderAutoMarkMarkers(): void {
      clearDiagnosisMarkers();
      if (!stage || workflowMode !== "auto") return;
      diagnosedMarks.forEach((mark, index) => {
        const marker = document.createElement("div");
        const strong = document.createElement("strong");
        marker.className = "pixel-auto-marker";
        marker.dataset.autoMarkIndex = String(index);
        marker.setAttribute("aria-hidden", "true");
        marker.style.left = `${mark.x * 100}%`;
        marker.style.top = `${mark.y * 100}%`;
        strong.textContent = `#${index + 1}`;
        marker.append(strong);
        stage.append(marker);
        diagnosisMarkerElements.push(marker);
      });
    }

    function highlightAutoMark(index: number): void {
      if (autoMarkHighlightTimer) clearTimeout(autoMarkHighlightTimer);
      const markers = Array.from(
        stage?.querySelectorAll<HTMLElement>("[data-auto-mark-index]") ?? [],
      );
      markers.forEach((marker) => {
        marker.classList.toggle(
          "is-highlighted",
          marker.dataset.autoMarkIndex === String(index),
        );
      });
      autoMarkHighlightTimer = setTimeout(() => {
        markers.forEach((marker) => marker.classList.remove("is-highlighted"));
        autoMarkHighlightTimer = null;
      }, 5000);
    }

    function syncAutoQueueControls(preview = false): void {
      const hasQueue = diagnosedMarks.length > 0 && autoRepairQueue.length > 0;
      // Skipped marks stay listed, so their explanation can be read.
      const hasMarks = diagnosedMarks.length > 0;
      if (autoMarkInput) {
        autoMarkInput.replaceChildren();
        if (hasMarks) {
          diagnosedMarks.forEach((mark, index) => {
            const option = document.createElement("option");
            option.value = String(index);
            option.textContent = markCoordinateLabel(mark, index);
            autoMarkInput.append(option);
          });
          autoMarkInput.value = "0";
        } else {
          const option = document.createElement("option");
          option.value = "";
          option.textContent = "Diagnose first";
          autoMarkInput.append(option);
        }
        autoMarkInput.disabled = !hasMarks;
      }

      if (timerInput) {
        timerInput.disabled = !hasQueue && workflowMode === "auto";
        syncControlDropdown(timerInput, timerLabel);
      }
      if (timerControl) {
        const timerDisabled = workflowMode === "auto" && !hasQueue;
        timerControl.dataset.disabled = String(timerDisabled);
        const timerDetails = timerControl.querySelector("details");
        if (timerDetails instanceof HTMLElement) {
          timerDetails.inert = timerDisabled;
          timerDetails.setAttribute("aria-disabled", String(timerDisabled));
          if (timerDisabled) timerDetails.removeAttribute("open");
        }
      }
      if (preview && hasQueue) renderAutoMarkMarkers();
      updateDiagnosisSummary(0);
    }

    function autoMarkDurationSeconds(markIndex: number): number {
      return markDurationSeconds(autoRepairQueue, markIndex);
    }

    function previewAutoRepairItem(index: number): void {
      const item = autoRepairQueue[index];
      if (!item || !stage || !spot || !modeInput) return;
      modeInput.value = "spot";
      stage.dataset.spotPlaced = "true";
      spot.style.left = `${item.result.x * 100}%`;
      spot.style.top = `${item.result.y * 100}%`;
      selectedPatternId = item.patternId;
      syncMode();
      syncPattern();
      syncNoisePlacement();
      if (countdownLabel) {
        countdownLabel.textContent = formatTime(
          autoMarkDurationSeconds(item.markIndex),
        );
      }
      updateStatus("Ready", item.label);
    }

    function syncWorkflowUI(): void {
      const isAuto = workflowMode === "auto";
      if (testShell) {
        testShell.dataset.workflow = workflowMode;
        testShell.dataset.autoReady = String(
          isAuto && autoRepairQueue.length > 0,
        );
      }
      workflowTabs.forEach((tab) => {
        const selected = tab.dataset.workflowTab === workflowMode;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      if (autoControls) autoControls.hidden = !isAuto;
      if (manualControls) manualControls.hidden = isAuto;
      if (manualRangeControls) manualRangeControls.hidden = isAuto;
      const timerHeading = document.getElementById("pixel-timer-select-label");
      if (timerHeading) {
        timerHeading.textContent = isAuto ? "Time per mark" : "Select time";
      }
      setManualSidebarAvailability(!isAuto);
      syncAutoQueueControls(isAuto && autoRepairQueue.length > 0);
      if (!isAuto) {
        clearDiagnosisMarkers();
        if (diagnosisSummary) diagnosisSummary.hidden = true;
        selectedPatternId = manualSelectedPatternId;
        syncManualPatternButtons();
        syncPattern();
        if (dockTip) {
          dockTip.textContent =
            "Choose Static Noise or build a custom RGB, CMY, and B/W cycle.";
        }
      } else if (dockTip) {
        dockTip.textContent = autoRepairQueue.length > 0
          ? "Pick a mark to highlight it. Set time, then Play at display max."
          : diagnosedMarks.length > 0
            ? "Nothing here for flashing to fix. Pick a mark to see why."
            : "Diagnose the screen to add repair marks.";
      }
      if (isAuto && diagnosedMarks.length > 0) {
        const selectedMark = Number(autoMarkInput?.value ?? 0);
        updateDiagnosisSummary(Number.isInteger(selectedMark) ? selectedMark : 0);
      }
      updateRunButton();
    }

    function setWorkflowMode(nextMode: WorkflowMode): void {
      if (workflowMode === nextMode) return;
      if (diagnosisActive) cancelDiagnosis();
      if (stage?.dataset.running === "true" || runPaused) {
        resetFlashing(false);
      }
      autoQueueRunning = false;
      workflowMode = nextMode;
      syncWorkflowUI();
    }

    function renderNoiseTile(mask: ChannelMask): void {
      if (!noiseTileCanvas) {
        noiseTileCanvas = document.createElement("canvas");
        noiseTileCanvas.width = NOISE_TILE_SIZE;
        noiseTileCanvas.height = NOISE_TILE_SIZE;
        noiseTileCtx = noiseTileCanvas.getContext("2d", { alpha: false });
        if (noiseTileCtx) noiseTileCtx.imageSmoothingEnabled = false;
      }
      if (!noiseTileCtx) return;
      if (!noiseTileImageData) {
        noiseTileImageData = noiseTileCtx.createImageData(
          NOISE_TILE_SIZE,
          NOISE_TILE_SIZE,
        );
      }
      const pixels = new Uint32Array(noiseTileImageData.data.buffer);
      const rBit = mask.r ? 0x000000ff : 0;
      const gBit = mask.g ? 0x0000ff00 : 0;
      const bBit = mask.b ? 0x00ff0000 : 0;
      for (let index = 0; index < pixels.length; index += 1) {
        const bits = xorshift32();
        let value = 0xff000000;
        if (bits & 1) value |= rBit;
        if (bits & 2) value |= gBit;
        if (bits & 4) value |= bBit;
        pixels[index] = value;
      }
      noiseTileCtx.putImageData(noiseTileImageData, 0, 0);
    }

    function renderNoiseFrame(): void {
      if (!noiseCanvas) return;
      const context = noiseCanvas.getContext("2d", { alpha: false });
      if (!context) return;
      context.imageSmoothingEnabled = false;
      const mask = currentPattern().channelMask ?? FULL_CHANNEL_MASK;
      renderNoiseTile(mask);
      if (!noiseTileCanvas) return;
      const fillPattern = context.createPattern(noiseTileCanvas, "repeat");
      if (!fillPattern) return;
      const offsetX = Math.floor(Math.random() * NOISE_TILE_SIZE);
      const offsetY = Math.floor(Math.random() * NOISE_TILE_SIZE);
      fillPattern.setTransform(new DOMMatrix().translate(offsetX, offsetY));
      context.fillStyle = fillPattern;
      context.fillRect(0, 0, noiseCanvas.width, noiseCanvas.height);
    }

    function syncNoisePlacement(): void {
      if (!noiseCanvas) return;
      const dpr = window.devicePixelRatio || 1;
      const inSpotMode = modeInput?.value === "spot";
      let cssWidth: number;
      let cssHeight: number;

      if (inSpotMode) {
        const diameter = effectiveSpotDiameter();
        cssWidth = diameter;
        cssHeight = diameter;
        noiseCanvas.style.left = spot?.style.left || "50%";
        noiseCanvas.style.top = spot?.style.top || "50%";
        noiseCanvas.style.width = `${diameter}px`;
        noiseCanvas.style.height = `${diameter}px`;
      } else {
        const rect = stage?.getBoundingClientRect();
        cssWidth = rect?.width || NOISE_FALLBACK_WIDTH;
        cssHeight = rect?.height || NOISE_FALLBACK_HEIGHT;
        noiseCanvas.style.left = "";
        noiseCanvas.style.top = "";
        noiseCanvas.style.width = "";
        noiseCanvas.style.height = "";
      }

      const width = Math.max(1, Math.round(cssWidth * dpr));
      const height = Math.max(1, Math.round(cssHeight * dpr));
      if (noiseCanvas.width !== width || noiseCanvas.height !== height) {
        noiseCanvas.width = width;
        noiseCanvas.height = height;
      }
    }

    function syncRuntimeWarningState(): void {
      const warningVisible = stage?.dataset.warningHidden !== "true";
      if (!testShell) return;
      testShell.dataset.runtimeScreenOverflow = warningVisible
        ? "visible"
        : "hidden";
      testShell.dataset.fullscreenButtonMuted = warningVisible
        ? "true"
        : "false";
      testShell.dataset.dialog = warningVisible ? "warning" : "none";
    }

    function updateStatus(state: string, detail: string): void {
      if (stateLabel) stateLabel.textContent = state;
      if (detailLabel) detailLabel.textContent = detail;
    }

    function isFullscreenActive(): boolean {
      return shellIsFullscreen(testShell);
    }

    function syncPauseNotice(): void {
      if (pauseNotice) {
        pauseNotice.hidden =
          isFullscreenActive() || (!runPaused && !diagnosisPaused);
      }
    }

    function syncDiagnosisButton(): void {
      if (!diagnoseButton) return;
      const isRunning = diagnosisActive && !diagnosisPaused;
      diagnoseButton.classList.toggle("is-running", isRunning);
      diagnoseButton.setAttribute("aria-pressed", String(isRunning));
      diagnoseButton.textContent = diagnosisActive
        ? diagnosisPaused
          ? "Resume"
          : "Pause"
        : "Diagnose";
    }

    function updateRunButton(_isRunning?: boolean): void {
      const isRunning = stage?.dataset.running === "true";
      const isAuto = workflowMode === "auto";
      const autoReady = autoRepairQueue.length > 0;
      const hideDiagnoseForRepair =
        !diagnosisActive && isFullscreenActive() && (isRunning || runPaused);
      if (diagnoseButton) {
        diagnoseButton.hidden =
          !isAuto || hideDiagnoseForRepair || (autoReady && !diagnosisActive);
      }
      if (startButton) {
        startButton.hidden = diagnosisActive;
        startButton.disabled = isAuto && !autoReady;
        startButton.classList.toggle("is-running", isRunning);
        startButton.setAttribute("aria-pressed", String(isRunning));
        startButton.textContent = isRunning
          ? "Pause"
          : runPaused
            ? "Resume"
            : "Start";
      }
      if (stopButton) stopButton.disabled = false;
      if (testShell) {
        testShell.dataset.autoReady = String(isAuto && autoReady);
        testShell.dataset.actionCount =
          isAuto && !autoReady && !diagnosisActive ? "3" : "2";
      }
      syncDiagnosisButton();
      syncPauseNotice();
    }

    function syncExclusiveSidebarSelection(
      buttons: HTMLButtonElement[],
      activeButton: HTMLButtonElement | null,
    ): void {
      buttons.forEach((candidate) => {
        const isActive = candidate === activeButton;
        candidate.setAttribute("aria-pressed", String(isActive));
      });
    }

    function syncControlDropdown(
      select: HTMLSelectElement | null,
      label: HTMLElement | null,
    ): void {
      if (!select || !label) return;
      const selectedOption = select.selectedOptions[0];
      if (selectedOption) label.textContent = selectedOption.textContent ?? "";
      controlDropdownOptions.forEach((option) => {
        const isMatch =
          option.dataset.targetSelect === select.id &&
          option.dataset.value === select.value;
        option.classList.toggle("is-active", isMatch);
      });
    }

    function closeOtherControlDropdowns(active: HTMLDetailsElement): void {
      controlDropdowns.forEach((dropdown) => {
        if (dropdown !== active) dropdown.open = false;
      });
    }

    function hideWarningOverlay(): void {
      if (!stage) return;
      stage.dataset.warningHidden = "true";
      isolateStageModal(null);
      syncRuntimeWarningState();
    }

    function showWarningOverlay(): void {
      if (!stage) return;
      stage.dataset.warningHidden = "false";
      isolateStageModal(warningPanel);
      syncRuntimeWarningState();
      if (warningPanel) focusModal(warningPanel, warningAck);
    }

    function hasAcknowledgedWarning(): boolean {
      return stage?.dataset.warningAcknowledged === "true";
    }

    function acknowledgeWarning(): void {
      if (!stage) return;
      stage.dataset.warningAcknowledged = "true";
      setStoredValue(CONSENT_STORAGE_KEY, "true");
      hideWarningOverlay();
    }

    function effectiveSpotDiameter(): number {
      if (!sizeInput) return 112;
      const requested = Number(sizeInput.value);
      const stageWidth = stage?.getBoundingClientRect().width || 0;
      if (stageWidth <= 0) return requested;
      return Math.min(requested, Math.round(stageWidth * 0.6));
    }

    function syncSpotSize(): void {
      if (!spot || !sizeInput) return;
      const size = `${effectiveSpotDiameter()}px`;
      spot.style.width = size;
      spot.style.height = size;
    }

    function syncMode(): void {
      if (!stage || !spot || !modeInput || !sizeInput) return;
      stage.dataset.mode = modeInput.value;
      syncSpotSize();
      if (sizeControl) sizeControl.hidden = modeInput.value !== "spot";
      syncNoisePlacement();
      if (stage.dataset.running !== "true") {
        updateStatus("Ready", currentPattern().label);
      }
    }

    function activeSpeedRange(): { min: number; max: number } {
      return speedRange({
        isNoise: Boolean(currentPattern().isNoise),
        reducedMotion: prefersReducedMotion,
        spotDiameter: modeInput?.value === "spot" ? effectiveSpotDiameter() : null,
      });
    }

    function delayFromSpeedInput(): number {
      if (!speedInput) return defaultDelayMs();
      return delayFromSpeed(Number(speedInput.value), activeSpeedRange());
    }

    function defaultDelayMs(): number {
      return defaultFlashDelayMs(Boolean(currentPattern().isNoise));
    }

    function syncSpeed(): void {
      if (!speedInput) return;
      const delay = delayFromSpeedInput();
      const isNoise = currentPattern().isNoise === true;
      if (isNoise) {
        const fps = Math.round(1000 / delay);
        if (speedValue) speedValue.textContent = `${fps} fps`;
        if (speedNote) speedNote.textContent = `${fps} frames/sec`;
        speedInput.setAttribute("aria-valuetext", `${fps} frames per second`);
        return;
      }
      const changesPerSec = 1000 / delay;
      if (speedValue) speedValue.textContent = `${delay} ms`;
      if (speedNote)
        speedNote.textContent = `${changesPerSec.toFixed(1)} changes/sec`;
      speedInput.setAttribute(
        "aria-valuetext",
        `${delay} milliseconds per color`,
      );
    }

    function syncSize(): void {
      if (!sizeInput || !sizeValue) return;
      sizeValue.textContent = `${effectiveSpotDiameter()} px`;
    }

    function syncPattern(): void {
      if (!modeInput || !stage) return;
      stage.dataset.pattern = selectedPatternId;
      const pattern = currentPattern();
      const selectedPatternButton = repairButtons.find(
        (button) => button.dataset.patternId === selectedPatternId,
      );
      if (dockTip && workflowMode === "manual") {
        dockTip.textContent =
          selectedPatternId === "manual-custom"
            ? `Manual cycle: ${pattern.label}.`
            : selectedPatternButton?.dataset.patternTip ?? pattern.note;
      }
      syncSpeed();
      if (stage.dataset.running === "true") {
        colorIndex = 0;
        if (pattern.isNoise) {
          applyIdleStage();
          syncNoisePlacement();
          renderNoiseFrame();
        } else {
          applyColor(pattern.colors[colorIndex] ?? "#ff0000");
        }
        updateStatus("Running", currentRunDetail());
        return;
      }
      updateStatus("Ready", pattern.label);
    }

    function applyIdleStage(): void {
      if (!stage) return;

      stage.style.background =
        modeInput?.value === "spot" ? spotIsolationBackground : "";
      if (spot) spot.style.background = "transparent";
    }

    function applyColor(color: string): void {
      if (!stage || !spot || !modeInput) return;
      if (modeInput.value === "spot") {
        stage.style.background = spotIsolationBackground;
        spot.style.background = color;
      } else {
        stage.style.background = color;
        spot.style.background = "transparent";
      }
    }


    function updateCountdown(): void {
      if (!countdownLabel) return;
      const remaining = Math.max(0, Math.ceil((endsAt - Date.now()) / 1000));
      const currentItem = autoRepairQueue[autoQueueIndex];
      const laterPhaseSeconds =
        workflowMode === "auto" && currentItem
          ? autoRepairQueue
              .slice(autoQueueIndex + 1)
              .filter((item) => item.markIndex === currentItem.markIndex)
              .reduce((total, item) => total + item.durationSeconds, 0)
          : 0;
      countdownLabel.textContent = formatTime(remaining + laterPhaseSeconds);
      if (remaining === 0) {
        if (workflowMode === "auto" && autoQueueRunning) {
          advanceAutoQueue();
        } else {
          resetFlashing();
        }
      }
    }

    function stopFlashLoop(): void {
      if (flashFrame !== 0) {
        cancelAnimationFrame(flashFrame);
        flashFrame = 0;
      }
      lastFlashTime = 0;
    }

    function flashTick(timestamp: number): void {
      if (!speedInput || stage?.dataset.running !== "true") {
        flashFrame = 0;
        return;
      }
      const pattern = currentPattern();
      const delay = delayFromSpeedInput();
      if (
        lastFlashTime === 0 ||
        timestamp - lastFlashTime >= delay
      ) {
        lastFlashTime = timestamp;
        if (pattern.isNoise) {
          renderNoiseFrame();
        } else {
          colorIndex = (colorIndex + 1) % pattern.colors.length;
          applyColor(pattern.colors[colorIndex] ?? "#ff0000");
        }
      }
      flashFrame = requestAnimationFrame(flashTick);
    }

    function scheduleFlashLoop(): void {
      stopFlashLoop();
      flashFrame = requestAnimationFrame(flashTick);
    }

    function clearRunTimers(): void {
      stopFlashLoop();
      if (countdownTimer) clearInterval(countdownTimer);
      countdownTimer = null;
    }

    function beginFlashing(durationMs: number): void {
      if (!speedInput || !stage || !modeInput) return;
      if (!hasAcknowledgedWarning()) {
        showWarningOverlay();
        return;
      }
      hideWarningOverlay();
      clearDiagnosisMarkers();
      if (wakeLockNote) wakeLockNote.hidden = true;

      const pattern = currentPattern();
      syncSpeed();
      clearRunTimers();
      endsAt = Date.now() + durationMs;
      runPaused = false;
      pausedRunRemainingMs = 0;
      stage.dataset.running = "true";
      stage.dataset.pattern = selectedPatternId;
      updateStatus("Running", currentRunDetail());
      colorIndex = 0;
      if (pattern.isNoise) {
        applyIdleStage();
        syncNoisePlacement();
        renderNoiseFrame();
      } else {
        applyColor(pattern.colors[colorIndex] ?? "#ff0000");
      }
      updateRunButton(true);
      showRuntimeControls(testShell);
      scheduleFlashLoop();
      countdownTimer = setInterval(updateCountdown, 250);
      updateCountdown();
      wakeLock.request();
    }

    function pauseFlashing(): void {
      if (!stage || stage.dataset.running !== "true") return;
      pausedRunRemainingMs = Math.max(0, endsAt - Date.now());
      clearRunTimers();
      stage.dataset.running = "false";
      runPaused = pausedRunRemainingMs > 0;
      updateStatus("Paused", currentRunDetail());
      updateRunButton();
      wakeLock.release();
    }

    function resumeFlashing(durationMs: number): void {
      if (!stage || durationMs <= 0) {
        resetFlashing();
        return;
      }
      endsAt = Date.now() + durationMs;
      runPaused = false;
      pausedRunRemainingMs = 0;
      stage.dataset.running = "true";
      updateStatus("Running", currentRunDetail());
      updateRunButton();
      scheduleFlashLoop();
      countdownTimer = setInterval(updateCountdown, 250);
      updateCountdown();
      wakeLock.request();
    }

    function resetSpotToCenter(): void {
      if (!spot || !stage) return;
      spotDragging = false;
      stage.dataset.spotPlaced = "false";
      spot.style.left = "50%";
      spot.style.top = "50%";
      spot.style.background = "transparent";
      syncNoisePlacement();
    }

    function resetFlashing(resetReady = true): void {
      clearRunTimers();
      runPaused = false;
      pausedRunRemainingMs = 0;
      if (stage) {
        stage.dataset.running = "false";
      }
      applyIdleStage();
      resetSpotToCenter();
      updateRunButton(false);
      wakeLock.release();
      if (modeInput && resetReady) {
        updateStatus("Ready", currentPattern().label);
      }
      if (timerInput && countdownLabel) {
        countdownLabel.textContent = formatTime(Number(timerInput.value));
      }
    }

    function requestRunStart(durationMs: number): void {
      if (!hasAcknowledgedWarning()) {
        showWarningOverlay();
        return;
      }
      if (testShell?.dataset.fullscreen !== "true") {
        pendingRunDurationMs = durationMs;
        pendingFullscreenAction = "run";
        fullscreenButton?.click();
        return;
      }
      if (runPaused) resumeFlashing(durationMs);
      else beginFlashing(durationMs);
    }

    function startAutoQueueItem(index: number, durationMs?: number): void {
      const item = autoRepairQueue[index];
      if (!item) return;
      autoQueueIndex = index;
      autoQueueRunning = true;
      autoQueueComplete = false;
      if (speedInput) speedInput.value = String(SPEED_RAW_MAX);
      previewAutoRepairItem(index);
      syncAutoQueueControls(false);
      if (autoMarkInput) autoMarkInput.value = String(item.markIndex);
      updateDiagnosisSummary(item.markIndex);
      requestRunStart(durationMs ?? item.durationSeconds * 1000);
    }

    function advanceAutoQueue(): void {
      clearRunTimers();
      runPaused = false;
      pausedRunRemainingMs = 0;
      if (stage) stage.dataset.running = "false";
      const nextIndex = autoQueueIndex + 1;
      if (nextIndex < autoRepairQueue.length) {
        startAutoQueueItem(nextIndex);
        return;
      }
      autoQueueRunning = false;
      autoQueueComplete = true;
      wakeLock.release();
      applyIdleStage();
      const flashed = queuedMarkIndexes().length;
      updateStatus("Complete", `${flashed} ${flashed === 1 ? "mark" : "marks"}`);
      if (countdownLabel) countdownLabel.textContent = "Done";
      updateRunButton();
      showRuntimeControls(testShell);
      startResultCheck();
    }

    function startResultCheck(): void {
      checkMarkIndexes = queuedMarkIndexes();
      checkIndex = 0;
      checkResults = new Map();
      if (checkMarkIndexes.length === 0) return;
      showResultCheck();
    }

    function showCheckPanel(markY: number | null): void {
      if (!checkPanel) return;
      placeStageCard(checkPanel, markY);
      checkPanel.dataset.visible = "true";
      isolateStageModal(checkPanel);
      focusModal(checkPanel);
    }

    function hideCheckPanel(): void {
      if (checkPanel) checkPanel.dataset.visible = "false";
      isolateStageModal(null);
    }

    function showResultCheck(): void {
      const markIndex = checkMarkIndexes[checkIndex];
      const mark = markIndex === undefined ? undefined : diagnosedMarks[markIndex];
      if (markIndex === undefined || !mark || !stage) return;
      const colorId = checkColorForMark(mark);
      const color = [...QUICK_DIAGNOSIS_COLORS, ...DEEP_DIAGNOSIS_COLORS].find(
        (entry) => entry.id === colorId,
      );
      stage.style.background = color?.hex ?? "#ffffff";
      if (spot) spot.style.background = "transparent";
      renderAutoMarkMarkers();
      diagnosisMarkerElements.forEach((marker) =>
        marker.classList.toggle(
          "is-highlighted",
          marker.dataset.autoMarkIndex === String(markIndex),
        ),
      );
      updateStatus("Check", `Mark #${markIndex + 1}`);
      if (checkTitle) checkTitle.textContent = `Is mark #${markIndex + 1} still visible?`;
      if (checkBody) {
        checkBody.textContent = `Look closely at the ringed spot on this ${(color?.label ?? "white").toLowerCase()} screen.`;
      }
      if (checkProgress) {
        checkProgress.textContent = `${checkIndex + 1}/${checkMarkIndexes.length}`;
      }
      if (checkAnswer) checkAnswer.hidden = false;
      if (checkLonger) checkLonger.hidden = true;
      if (checkDoneButton) checkDoneButton.hidden = true;
      showCheckPanel(mark.y);
    }

    function answerResultCheck(outcome: CheckOutcome): void {
      const markIndex = checkMarkIndexes[checkIndex];
      if (markIndex === undefined) return;
      checkResults.set(markIndex, outcome);
      checkIndex += 1;
      if (checkIndex < checkMarkIndexes.length) {
        showResultCheck();
        return;
      }
      showCheckSummary();
    }

    function showCheckSummary(): void {
      const { fixed, persists } = summarizeCheck(checkResults);
      applyIdleStage();
      clearDiagnosisMarkers();
      if (checkProgress) checkProgress.textContent = "";
      if (checkAnswer) checkAnswer.hidden = true;
      const offerLonger = persists.length > 0 && autoRound === 1;
      if (checkLonger) checkLonger.hidden = !offerLonger;
      if (checkDoneButton) {
        checkDoneButton.hidden = false;
        checkDoneButton.textContent = offerLonger ? "Not now" : "Done";
      }
      const persisting = markNumberList(persists);
      const verb = persists.length === 1 ? "is" : "are";
      if (persists.length === 0) {
        if (checkTitle) {
          checkTitle.textContent =
            fixed.length === 1 ? "The mark is gone" : "All marks are gone";
        }
        if (checkBody) {
          checkBody.textContent = `${markNumberList(fixed)} ${fixed.length === 1 ? "is" : "are"} no longer visible.`;
        }
      } else if (offerLonger) {
        if (checkTitle) checkTitle.textContent = `Mark ${persisting} ${verb} still visible`;
        if (checkBody) {
          checkBody.textContent = `Run a longer round on ${persists.length === 1 ? "it" : "them"}? The screen keeps flashing and the phone stays awake the whole time; stop if it gets warm.`;
        }
      } else {
        if (checkTitle) checkTitle.textContent = `Mark ${persisting} ${verb} still visible`;
        if (checkBody) {
          checkBody.textContent = "Software flashing hasn't fixed it. If the phone is under warranty, contact the manufacturer. You can still try Manual Override.";
        }
      }
      updateStatus(
        "Checked",
        `${fixed.length} gone, ${persists.length} still visible`,
      );
      showCheckPanel(null);
    }

    function startLongerRound(minutes: number): void {
      const { persists } = summarizeCheck(checkResults);
      hideCheckPanel();
      autoRound = 2;
      // Number marks as before: build from every mark, keep the persisting ones.
      autoRepairQueue = buildRepairQueue(diagnosedMarks, minutes * 60).filter(
        (item) => persists.includes(item.markIndex),
      );
      autoQueueIndex = 0;
      autoQueueComplete = false;
      startAutoQueueItem(0);
    }

    function finishResultCheck(): void {
      hideCheckPanel();
      checkMarkIndexes = [];
      checkResults = new Map();
      autoRound = 1;
      // Start again runs the full first round.
      buildAutoRepairQueue();
      syncWorkflowUI();
      renderAutoMarkMarkers();
    }

    function resetResultCheck(): void {
      hideCheckPanel();
      checkMarkIndexes = [];
      checkResults = new Map();
      autoRound = 1;
    }

    function toggleRunState(): void {
      if (!timerInput || !stage) return;
      if (stage.dataset.running === "true") {
        pauseFlashing();
        showRuntimeControls(testShell);
        return;
      }
      if (workflowMode === "auto") {
        // Start while the result check is open drops the check and runs
        // the full first round again.
        if (checkPanel?.dataset.visible === "true") finishResultCheck();
        if (autoRepairQueue.length === 0) return;
        if (runPaused) {
          startAutoQueueItem(autoQueueIndex, pausedRunRemainingMs);
          return;
        }
        startAutoQueueItem(autoQueueComplete ? 0 : autoQueueIndex);
        return;
      }
      requestRunStart(
        runPaused ? pausedRunRemainingMs : Number(timerInput.value) * 1000,
      );
    }

    function showInspectColor(
      color: string,
      label: string,
    ): void {
      if (workflowMode !== "manual") return;
      if (!stage || !countdownLabel) return;
      if (!hasAcknowledgedWarning()) {
        showWarningOverlay();
        return;
      }
      autoRepairQueue = [];
      autoQueueIndex = 0;
      autoQueueRunning = false;
      autoQueueComplete = false;
      resetFlashing(false);
      hideWarningOverlay();
      stage.dataset.running = "false";
      stage.style.background = color;
      if (spot) spot.style.background = "transparent";
      updateStatus("Inspect", label);
      if (dockTip) {
        dockTip.textContent = `Check the same screen position on ${label.toLowerCase()} and compare it with other colors.`;
      }
      countdownLabel.textContent = "Hold";
      showRuntimeControls(testShell);

    }

    function updateSpotPosition(clientX: number, clientY: number): void {
      if (!spot || !stage) return;
      const rect = spotStageRect ?? stage.getBoundingClientRect();
      spotStageRect = rect;
      spot.style.left = `${clientX - rect.left}px`;
      spot.style.top = `${clientY - rect.top}px`;
      syncNoisePlacement();
    }

    function queueSpotPosition(clientX: number, clientY: number): void {
      if (stage?.dataset.mode !== "spot") return;
      if (stage.dataset.warningHidden !== "true") return;
      if (diagnosisActive) return;
      pendingSpotPosition = { clientX, clientY };
      if (spotFrame !== 0) return;
      spotFrame = window.requestAnimationFrame(() => {
        spotFrame = 0;
        if (!pendingSpotPosition) return;
        updateSpotPosition(
          pendingSpotPosition.clientX,
          pendingSpotPosition.clientY,
        );
        pendingSpotPosition = null;
      });
    }

    function clearDiagnosisMarkers(): void {
      if (autoMarkHighlightTimer) {
        clearTimeout(autoMarkHighlightTimer);
        autoMarkHighlightTimer = null;
      }
      diagnosisMarkerElements.forEach((marker) => marker.remove());
      diagnosisMarkerElements = [];
    }

    function renderMarkersFromFractions(
      points: { x: number; y: number }[],
    ): void {
      clearDiagnosisMarkers();
      if (!stage) return;
      points.forEach((point) => {
        const marker = document.createElement("div");
        marker.className = "pixel-diagnosis-marker";
        marker.setAttribute("aria-hidden", "true");
        marker.style.left = `${point.x * 100}%`;
        marker.style.top = `${point.y * 100}%`;
        stage.append(marker);
        diagnosisMarkerElements.push(marker);
      });
    }

    function renderDiagnosisMarkers(): void {
      const current = DIAGNOSIS_COLORS[diagnosisStep];
      if (!current) {
        clearDiagnosisMarkers();
        return;
      }
      renderMarkersFromFractions(
        sessionTaps
          .filter((tap) => tap.colorId === current.id)
          .map((tap) => ({ x: tap.x, y: tap.y })),
      );
    }

    function setRunControlsHidden(hidden: boolean): void {
      if (startButton) startButton.hidden = hidden;
      if (stopButton) stopButton.hidden = false;
      updateRunButton();
    }

    function clearStepCountdownTimer(): void {
      if (stepCountdownTimer) {
        clearInterval(stepCountdownTimer);
        stepCountdownTimer = null;
      }
    }

    function resetAutoWorkflow(): void {
      resetResultCheck();
      autoRepairQueue = [];
      autoQueueIndex = 0;
      autoQueueRunning = false;
      autoQueueComplete = false;
      diagnosedMarks = [];
      clearDiagnosisMarkers();
      resetFlashing();
      syncAutoQueueControls(false);
      syncRuntimeWarningState();
      syncWorkflowUI();
    }

    function stopStepCountdown(): void {
      clearStepCountdownTimer();
      if (diagnosisCountdown) diagnosisCountdown.hidden = true;
    }

    function resumeStepCountdown(): void {
      if (!diagnosisViewing || stepCountdownRemaining <= 0) return;
      if (diagnosisCountdown) {
        diagnosisCountdown.hidden = false;
        diagnosisCountdown.textContent = `${stepCountdownRemaining}s`;
        diagnosisCountdown.focus();
      }
      clearStepCountdownTimer();
      stepCountdownTimer = setInterval(tickStepCountdown, 1000);
    }

    function paintCurrentStep(): void {
      const current = DIAGNOSIS_COLORS[diagnosisStep];
      if (!current || !stage) return;
      stage.style.background = current.hex;
      if (spot) spot.style.background = "transparent";
      updateStatus("Diagnose", current.label);
    }

    function showInstructCard(): void {
      const current = DIAGNOSIS_COLORS[diagnosisStep];
      if (!current || !diagnosisInstructPanel) return;
      const isDeepPassStart =
        diagnosisStep === QUICK_DIAGNOSIS_COLORS.length;
      paintCurrentStep();
      if (diagnosisInstructTitle) {
        diagnosisInstructTitle.textContent = isDeepPassStart
          ? "Narrow down the issue"
          : "Start diagnosis";
      }
      if (diagnosisInstructBody) {
        diagnosisInstructBody.textContent = isDeepPassStart
          ? "You marked an area. Five more checks will compare the same location using cyan, magenta, yellow, and two greys."
          : "You will see five test colors for 10 seconds each. Tap every area that does not match. You can mark more than one area.";
      }
      if (diagnosisInstructProgress) {
        diagnosisInstructProgress.textContent = `${diagnosisStep + 1}/${DIAGNOSIS_COLORS.length}`;
      }
      if (diagnosisBeginButton) {
        diagnosisBeginButton.textContent = isDeepPassStart
          ? "Continue"
          : "Start";
      }
      diagnosisInstructPanel.dataset.visible = "true";
      isolateStageModal(diagnosisInstructPanel);
      focusModal(diagnosisInstructPanel, diagnosisBeginButton);
    }

    function tickStepCountdown(): void {
      if (diagnosisPaused) return;
      stepCountdownRemaining -= 1;
      if (diagnosisCountdown) {
        diagnosisCountdown.textContent = `${stepCountdownRemaining}s`;
      }
      if (stepCountdownRemaining <= 0) {
        endStepViewing();
      }
    }

    function beginStepViewing(): void {
      if (diagnosisPaused) return;
      if (diagnosisInstructPanel)
        diagnosisInstructPanel.dataset.visible = "false";
      isolateStageModal(null);
      paintCurrentStep();
      clearDiagnosisMarkers();
      stopStepCountdown();
      diagnosisViewing = true;
      stepCountdownRemaining = STEP_VIEW_SECONDS;
      if (diagnosisCountdown) {
        diagnosisCountdown.hidden = false;
        diagnosisCountdown.textContent = `${stepCountdownRemaining}s`;
        diagnosisCountdown.focus();
      }
      stepCountdownTimer = setInterval(tickStepCountdown, 1000);
    }

    function endStepViewing(): void {
      diagnosisViewing = false;
      stopStepCountdown();
      showConfirmCard();
    }

    function showConfirmCard(): void {
      const current = DIAGNOSIS_COLORS[diagnosisStep];
      if (!current || !diagnosisConfirmPanel) return;
      const marksThisStep = sessionTaps.filter(
        (tap) => tap.colorId === current.id,
      ).length;
      const isFinalStep = diagnosisStep === DIAGNOSIS_COLORS.length - 1;
      const willExtend =
        isFinalStep &&
        DIAGNOSIS_COLORS.length === QUICK_DIAGNOSIS_COLORS.length &&
        sessionTaps.length > 0;

      if (diagnosisConfirmTitle) {
        diagnosisConfirmTitle.textContent = `${current.label} screen`;
      }
      if (diagnosisConfirmProgress) {
        diagnosisConfirmProgress.textContent = `${diagnosisStep + 1}/${DIAGNOSIS_COLORS.length}`;
      }

      if (marksThisStep === 0) {
        if (diagnosisConfirmBody) {
          diagnosisConfirmBody.textContent = willExtend
            ? "You marked an area earlier. Five more checks will narrow down what it is."
            : "Did you see anything on this screen?";
        }
        if (diagnosisConfirmClean) diagnosisConfirmClean.hidden = false;
        if (diagnosisConfirmMarked) diagnosisConfirmMarked.hidden = true;
        if (diagnosisNoIssueButton) {
          diagnosisNoIssueButton.textContent = willExtend
            ? "Continue"
            : isFinalStep
              ? "Finish"
              : "Next";
        }
      } else {
        if (diagnosisConfirmBody) {
          diagnosisConfirmBody.textContent = willExtend
            ? "You marked an area. Five more checks will narrow down what it is."
            : marksThisStep === 1
              ? "You marked 1 area on this screen."
              : `You marked ${marksThisStep} areas on this screen.`;
        }
        if (diagnosisConfirmClean) diagnosisConfirmClean.hidden = true;
        if (diagnosisConfirmMarked) diagnosisConfirmMarked.hidden = false;
        if (diagnosisConfirmNextButton) {
          diagnosisConfirmNextButton.textContent = willExtend
            ? "Continue"
            : isFinalStep
              ? "Finish"
              : "Next";
        }
      }

      diagnosisConfirmPanel.dataset.visible = "true";
      isolateStageModal(diagnosisConfirmPanel);
      focusModal(diagnosisConfirmPanel);
    }

    function redoStep(): void {
      if (diagnosisPaused) return;
      const current = DIAGNOSIS_COLORS[diagnosisStep];
      if (current) {
        sessionTaps = sessionTaps.filter((tap) => tap.colorId !== current.id);
      }
      if (diagnosisConfirmPanel)
        diagnosisConfirmPanel.dataset.visible = "false";
      isolateStageModal(null);
      beginStepViewing();
    }

    function confirmStepAndAdvance(): void {
      if (diagnosisPaused) return;
      if (diagnosisConfirmPanel)
        diagnosisConfirmPanel.dataset.visible = "false";
      isolateStageModal(null);
      diagnosisStep += 1;
      if (diagnosisStep >= DIAGNOSIS_COLORS.length) {
        if (
          DIAGNOSIS_COLORS.length === QUICK_DIAGNOSIS_COLORS.length &&
          sessionTaps.length > 0
        ) {
          DIAGNOSIS_COLORS.push(...DEEP_DIAGNOSIS_COLORS);
          showInstructCard();
          return;
        }
        startFollowUps();
        return;
      }

      beginStepViewing();
    }

    function startDiagnosis(): void {
      if (!hasAcknowledgedWarning()) {
        showWarningOverlay();
        return;
      }

      if (testShell?.dataset.fullscreen !== "true") {
        pendingFullscreenAction = "diagnose";
        fullscreenButton?.click();
        return;
      }
      resetFlashing(false);
      hideWarningOverlay();
      diagnosisStep = 0;
      sessionTaps = [];
      followUps = [];
      resetResultCheck();
      DIAGNOSIS_COLORS.length = QUICK_DIAGNOSIS_COLORS.length;
      clearDiagnosisMarkers();
      diagnosisActive = true;
      diagnosisPaused = false;
      if (stage) stage.dataset.diagnosing = "true";
      setRunControlsHidden(true);
      showRuntimeControls(testShell);
      showInstructCard();
    }

    function pauseDiagnosis(): void {
      if (!diagnosisActive || diagnosisPaused) return;
      diagnosisPaused = true;
      clearStepCountdownTimer();
      const current = DIAGNOSIS_COLORS[diagnosisStep];
      updateStatus("Paused", current?.label ?? "Diagnosis");
      updateRunButton();
      showRuntimeControls(testShell);
    }

    function resumeDiagnosis(): void {
      if (!diagnosisActive || !diagnosisPaused) return;
      diagnosisPaused = false;
      if (followUps.length > 0) showFollowUp();
      else paintCurrentStep();
      resumeStepCountdown();
      updateRunButton();
      showRuntimeControls(testShell);
    }

    function requestDiagnosisResume(): void {
      if (isFullscreenActive()) {
        resumeDiagnosis();
        return;
      }
      pendingFullscreenAction = "diagnose-resume";
      fullscreenButton?.click();
      showRuntimeControls(testShell);
    }

    function toggleDiagnosisState(): void {
      if (workflowMode !== "auto") return;
      if (!diagnosisActive) {
        startDiagnosis();
        return;
      }
      if (diagnosisPaused) requestDiagnosisResume();
      else pauseDiagnosis();
    }

    function cancelDiagnosis(): void {
      diagnosisActive = false;
      diagnosisViewing = false;
      diagnosisPaused = false;
      stopStepCountdown();
      if (stage) stage.dataset.diagnosing = "false";
      setRunControlsHidden(false);
      if (diagnosisInstructPanel)
        diagnosisInstructPanel.dataset.visible = "false";
      if (diagnosisConfirmPanel)
        diagnosisConfirmPanel.dataset.visible = "false";
      if (followUpPanel) followUpPanel.dataset.visible = "false";
      followUps = [];
      isolateStageModal(null);
      clearDiagnosisMarkers();
      resetFlashing();
      syncWorkflowUI();
      diagnoseButton?.focus();
    }

    function buildAutoRepairQueue(): void {
      autoRepairQueue = buildRepairQueue(
        diagnosedMarks,
        Number(timerInput?.value ?? 300),
      );
      autoQueueIndex = 0;
      autoQueueRunning = false;
      autoQueueComplete = false;
    }

    /**
     * Puts a question card on the half of the stage away from the mark
     * (top when there is none). At the bottom it keeps clear of the run
     * controls dock, which can be shown over the stage.
     */
    function placeStageCard(panel: HTMLElement, markY: number | null): void {
      const place = markY !== null && markY < 0.5 ? "bottom" : "top";
      panel.dataset.place = place;
      const dock = testShell?.querySelector<HTMLElement>(".tool-runtime-dock-primary");
      panel.style.paddingBottom =
        place === "bottom" ? `${(dock?.offsetHeight ?? 0) + 16}px` : "";
    }

    function startFollowUps(): void {
      const rect = stage?.getBoundingClientRect();
      pendingClusters = clusterTaps(
        sessionTaps,
        Math.max(1, rect?.width ?? window.innerWidth),
        Math.max(1, rect?.height ?? window.innerHeight),
      );
      followUpAnswers = pendingClusters.map(() => ({}));
      followUps = pendingClusters.flatMap((cluster, markIndex) =>
        followUpColors(observationsForColors(cluster.colors)).map((color) => ({
          markIndex,
          color,
        })),
      );
      followUpIndex = 0;
      if (followUps.length === 0) {
        finishDiagnosis();
        return;
      }
      showFollowUp();
    }

    function showFollowUp(): void {
      const item = followUps[followUpIndex];
      const cluster = item ? pendingClusters[item.markIndex] : undefined;
      const color = [...QUICK_DIAGNOSIS_COLORS, ...DEEP_DIAGNOSIS_COLORS].find(
        (entry) => entry.id === item?.color,
      );
      if (!item || !cluster || !color || !stage || !followUpPanel) return;
      const markNumber = item.markIndex + 1;
      stage.style.background = color.hex;
      updateStatus("Diagnose", `Check mark #${markNumber}`);
      clearDiagnosisMarkers();
      const marker = document.createElement("div");
      const label = document.createElement("strong");
      marker.className = "pixel-auto-marker is-highlighted";
      marker.setAttribute("aria-hidden", "true");
      marker.style.left = `${cluster.x * 100}%`;
      marker.style.top = `${cluster.y * 100}%`;
      label.textContent = `#${markNumber}`;
      marker.append(label);
      stage.append(marker);
      diagnosisMarkerElements.push(marker);
      if (followUpTitle) {
        followUpTitle.textContent = `Mark #${markNumber} on ${color.label.toLowerCase()}`;
      }
      if (followUpBody) {
        followUpBody.textContent = `Look closely at the ringed spot. Can you see the mark on this ${color.label.toLowerCase()} screen?`;
      }
      if (followUpProgress) {
        followUpProgress.textContent = `${followUpIndex + 1}/${followUps.length}`;
      }
      placeStageCard(followUpPanel, cluster.y);
      followUpPanel.dataset.visible = "true";
      isolateStageModal(followUpPanel);
      focusModal(followUpPanel);
    }

    function answerFollowUp(visible: boolean): void {
      if (diagnosisPaused) return;
      const item = followUps[followUpIndex];
      if (!item) return;
      const answers = followUpAnswers[item.markIndex];
      if (answers) answers[item.color] = visible;
      followUpIndex += 1;
      if (followUpIndex < followUps.length) {
        showFollowUp();
        return;
      }
      if (followUpPanel) followUpPanel.dataset.visible = "false";
      isolateStageModal(null);
      clearDiagnosisMarkers();
      followUps = [];
      finishDiagnosis();
    }

    function finishDiagnosis(): void {
      diagnosisActive = false;
      diagnosisViewing = false;
      diagnosisPaused = false;
      stopStepCountdown();
      if (stage) stage.dataset.diagnosing = "false";
      setRunControlsHidden(false);
      applyIdleStage();

      // A follow-up answer replaces that colour's first response, since the
      // user was then looking at one known spot.
      diagnosedMarks = pendingClusters.map((cluster, index) => {
        const observations = withAnswers(
          observationsForColors(cluster.colors),
          followUpAnswers[index] ?? {},
        );
        return {
          x: cluster.x,
          y: cluster.y,
          observations,
          ...classifyObservations(observations),
        };
      });

      buildAutoRepairQueue();
      syncWorkflowUI();
      if (autoRepairQueue.length > 0) {
        const identifiedCount = diagnosedMarks.filter(
          (result) => result.classification !== "unclear",
        ).length;
        updateStatus(
          "Diagnosed",
          `${identifiedCount}/${diagnosedMarks.length} identified`,
        );
        if (countdownLabel && timerInput) {
          countdownLabel.textContent = formatTime(Number(timerInput.value));
        }
      } else if (diagnosedMarks.length > 0) {
        updateStatus(
          "Nothing to repair",
          `${diagnosedMarks.length} ${diagnosedMarks.length === 1 ? "mark" : "marks"}`,
        );
      } else {
        updateStatus("Ready", "No marks");
        if (dockTip) dockTip.textContent = "No marks were added. Run Diagnose again.";
      }
      if (testShell?.dataset.fullscreen === "true") {
        fullscreenButton?.click();
      }
      showRuntimeControls(testShell);
      syncRuntimeWarningState();
      startButton?.focus();
    }

    stage?.addEventListener(
      "pointermove",
      (event) => {
        if (!spotDragging) return;
        queueSpotPosition(event.clientX, event.clientY);
      },
      { passive: true },
    );

    window.addEventListener(
      "pointerup",
      () => {
        spotDragging = false;
      },
      { passive: true, signal: pageController.signal },
    );
    window.addEventListener(
      "pointercancel",
      () => {
        spotDragging = false;
      },
      { passive: true, signal: pageController.signal },
    );

    stage?.addEventListener(
      "pointerdown",
      (event) => {
        spotStageRect = stage?.getBoundingClientRect() ?? null;
        if (
          stage?.dataset.mode === "spot" &&
          stage.dataset.warningHidden === "true" &&
          !diagnosisActive
        ) {
          spotDragging = true;
          stage.dataset.spotPlaced = "true";
        }
        queueSpotPosition(event.clientX, event.clientY);

        if (diagnosisViewing && !diagnosisPaused && stage) {
          const rect = spotStageRect ?? stage.getBoundingClientRect();
          const current = DIAGNOSIS_COLORS[diagnosisStep];
          if (rect.width > 0 && rect.height > 0 && current) {
            sessionTaps.push({
              x: Math.min(
                1,
                Math.max(0, (event.clientX - rect.left) / rect.width),
              ),
              y: Math.min(
                1,
                Math.max(0, (event.clientY - rect.top) / rect.height),
              ),
              colorId: current.id,
              matchRadiusPx: pointerMatchRadius(event),
            });
            renderDiagnosisMarkers();
          }
        }
      },
      { passive: true },
    );

    stage?.addEventListener("dblclick", (event) => {
      if (stage.dataset.warningHidden === "true") event.preventDefault();
    });

    modeInput?.addEventListener("change", syncMode);
    modeInput?.addEventListener("change", () =>
      syncControlDropdown(modeInput, modeLabel),
    );

    modeInput?.addEventListener("change", syncSpeed);
    speedInput?.addEventListener("input", syncSpeed);
    sizeInput?.addEventListener("input", () => {
      if (workflowMode === "manual" && stage?.dataset.mode === "spot") {
        stage.dataset.spotPlaced = "true";
      }
      syncMode();
      syncSize();
      syncSpeed();
    });
    timerInput?.addEventListener("change", () => {
      syncControlDropdown(timerInput, timerLabel);
      if (workflowMode === "auto") {
        const durationSeconds = Number(timerInput.value);
        const selectedMark = Number(autoMarkInput?.value ?? 0);
        buildAutoRepairQueue();
        syncAutoQueueControls(false);
        if (
          autoMarkInput &&
          Number.isInteger(selectedMark) &&
          diagnosedMarks[selectedMark]
        ) {
          autoMarkInput.value = String(selectedMark);
          updateDiagnosisSummary(selectedMark);
        }
        if (countdownLabel) {
          countdownLabel.textContent = formatTime(durationSeconds);
        }
        return;
      }
      resetFlashing();
    });
    autoMarkInput?.addEventListener("change", () => {
      const index = Number(autoMarkInput.value);
      const mark = diagnosedMarks[index];
      if (!Number.isInteger(index) || !mark) return;
      if (stage?.dataset.running !== "true") {
        renderAutoMarkMarkers();
        highlightAutoMark(index);
      }
      updateDiagnosisSummary(index);
      updateStatus("Mark", markCoordinateLabel(mark, index));
    });
    autoMarkInput?.addEventListener("click", () => {
      const index = Number(autoMarkInput.value);
      if (!Number.isInteger(index) || !diagnosedMarks[index]) return;
      if (stage?.dataset.running !== "true") highlightAutoMark(index);
      updateDiagnosisSummary(index);
    });
    startButton?.addEventListener("click", toggleRunState);
    stopButton?.addEventListener("click", () => {
      if (diagnosisActive) cancelDiagnosis();
      else if (workflowMode === "auto") resetAutoWorkflow();
      else resetFlashing();
    });
    diagnoseButton?.addEventListener("click", toggleDiagnosisState);
    diagnosisBeginButton?.addEventListener("click", beginStepViewing);
    diagnosisCheckAgainButton?.addEventListener("click", redoStep);
    diagnosisNoIssueButton?.addEventListener("click", confirmStepAndAdvance);
    diagnosisRedoButton?.addEventListener("click", redoStep);
    diagnosisConfirmNextButton?.addEventListener(
      "click",
      confirmStepAndAdvance,
    );
    diagnosisCancelButtons.forEach((button) =>
      button.addEventListener("click", cancelDiagnosis),
    );
    followUpYesButton?.addEventListener("click", () => answerFollowUp(true));
    checkGoneButton?.addEventListener("click", () => answerResultCheck("fixed"));
    checkStillButton?.addEventListener("click", () =>
      answerResultCheck("persists"),
    );
    longerRoundButtons.forEach((button) =>
      button.addEventListener("click", () =>
        startLongerRound(Number(button.dataset.longerMinutes)),
      ),
    );
    checkDoneButton?.addEventListener("click", finishResultCheck);
    followUpNoButton?.addEventListener("click", () => answerFollowUp(false));
    workflowTabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        const nextMode = tab.dataset.workflowTab;
        if (nextMode === "auto" || nextMode === "manual") {
          setWorkflowMode(nextMode);
        }
      });
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const direction = event.key === "ArrowRight" ? 1 : -1;
        const nextTab = workflowTabs.at(
          (index + direction + workflowTabs.length) % workflowTabs.length,
        );
        nextTab?.focus();
        nextTab?.click();
      });
    });

    warningAck?.addEventListener("change", () => {
      if (!warningButton) return;
      warningButton.disabled = !warningAck.checked;
    });

    warningButton?.addEventListener("click", () => {
      if (!warningAck?.checked) return;
      acknowledgeWarning();
      startButton?.focus();
    });

    controlDropdowns.forEach((dropdown) => {
      dropdown.addEventListener("toggle", () => {
        if (dropdown.open) closeOtherControlDropdowns(dropdown);
      });
    });

    controlDropdownOptions.forEach((option) => {
      option.addEventListener("click", () => {
        const targetId = option.dataset.targetSelect;
        const value = option.dataset.value;
        if (!targetId || !value) return;
        const target = document.getElementById(
          targetId,
        ) as HTMLSelectElement | null;
        if (!target || target.disabled) return;
        target.value = value;
        target.dispatchEvent(new Event("change", { bubbles: true }));
        option.closest("details")?.removeAttribute("open");
      });
    });

    repairButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (workflowMode !== "manual") return;
        const nextId = button.dataset.patternId;
        if (!nextId) return;
        const activeAccordion = button.closest("details");
        if (activeAccordion instanceof HTMLDetailsElement) {
          activeAccordion.dispatchEvent(
            new CustomEvent("tool-sidebar:open-accordion", { bubbles: true }),
          );
        }
        if (button.dataset.patternKind === "noise") {
          manualSelectedPatternId = "static";
          selectedPatternId = "static";
          syncManualPatternButtons();
          syncPattern();
          return;
        }
        const group = nextId as ManualColorGroup;
        if (manualColorGroups.has(group)) manualColorGroups.delete(group);
        else manualColorGroups.add(group);
        activateManualColorPattern();
      });
    });

    inspectButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const color = button.dataset.inspectColor;
        const label = button.dataset.inspectLabel;
        if (!color || !label) return;
        const activeAccordion = button.closest("details");
        if (activeAccordion instanceof HTMLDetailsElement) {
          activeAccordion.dispatchEvent(
            new CustomEvent("tool-sidebar:open-accordion", { bubbles: true }),
          );
        }
        syncExclusiveSidebarSelection(inspectButtons, button);
        showInspectColor(color, label);
      });
    });

    testShell?.addEventListener("tool-runtime:fullscreen-change", () => {
      spotStageRect = null;
      syncSpotSize();
      syncNoisePlacement();

      const isExpanded = testShell?.dataset.fullscreen === "true";
      if (isExpanded && pendingFullscreenAction) {
        const action = pendingFullscreenAction;
        pendingFullscreenAction = null;
        if (action === "run") {
          const duration = pendingRunDurationMs ?? Number(timerInput?.value ?? 0) * 1000;
          pendingRunDurationMs = null;
          if (runPaused) resumeFlashing(duration);
          else beginFlashing(duration);
        } else if (action === "diagnose") {
          startDiagnosis();
        } else {
          resumeDiagnosis();
        }
        return;
      }

      if (!isExpanded) {
        pendingFullscreenAction = null;
        pendingRunDurationMs = null;
        if (stage?.dataset.running === "true") pauseFlashing();
        if (diagnosisActive && !diagnosisPaused) pauseDiagnosis();
      }
      updateRunButton();
      showRuntimeControls(testShell);
    });

    const stageResizeObserver = observeResize(stage, () => {
      spotStageRect = null;
      syncSpotSize();
      syncNoisePlacement();
    });
    window.addEventListener(
      "scroll",
      () => {
        spotStageRect = null;
      },
      { passive: true, signal: pageController.signal },
    );
    const unsubscribeOrientation = onOrientationChange(() => {
      spotStageRect = null;
      syncSpotSize();
      syncNoisePlacement();
    });

    function restoreConsent(): void {
      if (!stage) return;
      if (getStoredValue(CONSENT_STORAGE_KEY) === "true") {
        stage.dataset.warningAcknowledged = "true";
        hideWarningOverlay();
      }
    }

    function cleanupPixelPage(): void {
      clearRunTimers();
      stopStepCountdown();
      if (spotFrame !== 0) {
        cancelAnimationFrame(spotFrame);
        spotFrame = 0;
      }
      stageResizeObserver?.disconnect();
      unsubscribeOrientation();
      pageController.abort();
      wakeLock.release();
    }

    onPageHide(cleanupPixelPage);

    if (prefersReducedMotion && motionNote) motionNote.hidden = false;

    syncRuntimeWarningState();
    syncMode();
    syncControlDropdown(modeInput, modeLabel);
    syncSpeed();
    syncSize();
    syncControlDropdown(timerInput, timerLabel);
    syncPattern();
    resetFlashing();
    syncWorkflowUI();
    restoreConsent();
    if (!hasAcknowledgedWarning() && warningPanel) {
      isolateStageModal(warningPanel);
      focusModal(warningPanel, warningAck);
    }
  </script>
</BaseLayout>
