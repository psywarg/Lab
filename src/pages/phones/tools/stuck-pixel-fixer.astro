---
// src/pages/phones/tools/stuck-pixel-fixer.astro

export const prerender = true;

import { getToolBySlug } from "@/content/phones/tools";
import ToolReference from "@/components/phones/tools/Reference.astro";
import ToolSidebar from "@/components/phones/tools/Sidebar.astro";
import ToolRuntime from "@/components/phones/tools/Runtime.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteIcons from "@/assets/icons/site-sprites.svg?url";
import { createToolApplicationSchema, SITE_ORIGIN } from "@/utils/site/schema";
// Lengths offered for a second, longer round on marks still visible.
const LONGER_ROUND_MINUTES = [10, 20] as const;

const tool = getToolBySlug("stuck-pixel-fixer");
const ogImage = tool.image;
const title = "Free Online Stuck Pixel Fixer for Any Screen";
const metaDescription =
  "Diagnose stuck, hot, or dead pixels, mark affected areas, then try targeted static noise or color cycles with adjustable spot, speed, and timer controls.";

const defaultSpeedFps = 15;
const SPEED_RAW_MAX = 500;
const defaultSpeedRaw = SPEED_RAW_MAX / 2;

const referenceItems = [
  {
    label: "Identify",
    check:
      "Use Diagnose in the Auto tab to view black, white, red, green, and blue. If you mark an area, five comparison checks follow. Nearby taps at the same screen position are grouped, classified, and shown in the Auto dock.",
    reading:
      "A pixel contains red, green, and blue sub-pixels. A fixed colored point often means one sub-pixel is stuck; a point that stays black on every color is more likely dead. Software repair can't do anything for a genuinely dead pixel. No tool can guarantee a fix, and any specific success-rate claim you see elsewhere is unverified marketing, not a measured result.",
    good: "That usually points to a stuck sub-pixel, which may respond to color cycling or per-pixel noise.",
    concern:
      "A permanently black pixel, crack, line, burn-in mark, or pressure damage will not be repaired here.",
  },
  {
    label: "Target",
    check:
      "Auto positions the repair spot over each mark. In Manual Override, choose Movable spot and drag the repair window directly over the affected area.",
    reading:
      "Movable spot flashes only inside the square repair window, while Full screen flashes the entire panel. Size in px means the spot width in browser-rendered pixels.",
    good: "Only the problem area flashes while the rest of the screen stays calmer.",
    concern:
      "Jumping straight to full-screen flashing is harsher and usually unnecessary at first.",
  },
  {
    label: "Run",
    check:
      "Auto runs Static Noise on each stuck or hot pixel for the selected time; dead pixels, surface marks, uneven patches and unclear results are explained and skipped. Manual Override lets you run Static Noise or combine RGB, CMY, and B/W color cycles. Start with a short pass and stop if the phone becomes warm or you feel discomfort. When Auto finishes, it shows each mark on the color where it was clearest and asks whether it is gone; for a mark still visible you can choose one longer 10 or 20 minute round.",
    reading:
      "RGB means red, green, and blue; B/W means black and white; CMY means cyan, magenta, and yellow. Static Noise starts at 15 fps and adjusts to a 30 fps cap. Color-cycle speed and spot size are limited by mode, and reduced-motion preferences lower the fastest setting. These limits reduce risk but do not guarantee that rapidly changing patterns are safe for every person. Keep the phone ventilated and stop the run if it becomes hot.",
    good: "If the pixel improves, repeat another short pass instead of pushing one long aggressive run.",
    concern:
      "The pixel stays unchanged after several short passes, which suggests the issue will not respond to software cycling.",
  },
  {
    label: "Verify",
    check:
      "Use the solid-color checks after each pass. All 10 are available, including both greys. Watch the same screen location as the colors change to confirm whether the defect remains.",
    reading:
      "Verify colors are inspection screens and do not run a repair cycle. Watch the exact same screen position as colors change to see whether the defect remains fixed. iPhone Safari has no true fullscreen, so part of the edge always sits under the address bar or the notch. Check in both portrait and landscape to cover it.",
    good: "A recovered pixel changes normally across those colors without staying bright or tinted.",
    concern:
      "If the same defect remains after repeated short passes, the issue is likely not recoverable in software.",
  },
];

const repairPatterns = [
  {
    id: "static",
    label: "Static Noise",
    note: "Recommended. Independently varies red, green, and blue sub-pixels. It starts at 15 frames per second and can be adjusted up to 30.",
    swatch:
      "background: repeating-conic-gradient(from 0deg, #000 0deg 9deg, #fff 9deg 18deg, #ff0000 18deg 27deg, #00ff00 27deg 36deg, #0000ff 36deg 45deg); background-size: 6px 6px;",
  },
  {
    id: "rgb",
    label: "RGB",
    note: "Color cycling for a colored stuck sub-pixel.",
    swatch: "background: linear-gradient(to right, #ef4444, #a3e635, #3b82f6);",
  },
  {
    id: "cmy",
    label: "CMY",
    note: "Adds cyan, magenta, and yellow to a custom manual color cycle.",
    swatch:
      "background: linear-gradient(to right, #00ffff, #ff00ff, #ffff00);",
  },
  {
    id: "contrast",
    label: "B/W",
    note: "Highest contrast option. Try this only after gentler patterns fail.",
    swatch: "background: linear-gradient(to right, #000000, #ffffff);",
  },
];

const repairTips: Record<string, string> = {
  static: "Start with the smallest spot that fully covers the affected pixel.",
  rgb: "Add red, green, and blue to the manual color cycle.",
  cmy: "Add cyan, magenta, and yellow to the manual color cycle.",
  contrast: "Try this high-contrast pulse last and stop if it causes discomfort.",
};

const inspectColors = [
  { id: "black", label: "Black", value: "#000000", swatch: "background: #000000;" },
  { id: "white", label: "White", value: "#ffffff", swatch: "background: #ffffff;" },
  { id: "red", label: "Red", value: "#ff0000", swatch: "background: #ff0000;" },
  { id: "green", label: "Green", value: "#00ff00", swatch: "background: #00ff00;" },
  { id: "blue", label: "Blue", value: "#0000ff", swatch: "background: #0000ff;" },
  { id: "cyan", label: "Cyan", value: "#00ffff", swatch: "background: #00ffff;" },
  { id: "magenta", label: "Magenta", value: "#ff00ff", swatch: "background: #ff00ff;" },
  { id: "yellow", label: "Yellow", value: "#ffff00", swatch: "background: #ffff00;" },
  { id: "midGrey", label: "Mid grey", value: "#808080", swatch: "background: #808080;" },
  { id: "darkGrey", label: "Dark grey", value: "#101010", swatch: "background: #101010;" },
];

const timerOptions = [
  { value: 60, label: "1 min" },
  { value: 300, label: "5 min", selected: true },
  { value: 600, label: "10 min" },
  { value: 1200, label: "20 min" },
  { value: 1800, label: "30 min" },
  { value: 3600, label: "60 min" },
];
const defaultTimerOption =
  timerOptions.find((option) => option.selected) ?? timerOptions[0];

const sidebarGroups = [
  {
    title: "Manual patterns",
    openByDefault: true,
    attributes: {
      "data-manual-sidebar-group": "",
      "data-disabled-message": "Available in Manual Override",
    },
    items: repairPatterns.map((pattern, index) => ({
      label: pattern.label,
      visual: {
        type: "swatch" as const,
        style: pattern.swatch,
      },
      active: index === 0,
      disabled: true,
      attributes: {
        "data-repair-button": "",
        "data-pattern-id": pattern.id,
        "data-pattern-label": pattern.label,
        "data-pattern-tip": repairTips[pattern.id],
        "data-pattern-kind": pattern.id === "static" ? "noise" : "color-group",
      },
    })),
  },
  {
    title: "Verify",
    attributes: {
      "data-manual-sidebar-group": "",
      "data-disabled-message": "Available in Manual Override",
    },
    items: inspectColors.map((color) => ({
      label: color.label,
      visual: {
        type: "swatch" as const,
        style: color.swatch,
      },
      disabled: true,
      attributes: {
        "data-inspect-button": "",
        "data-inspect-color": color.value,
        "data-inspect-label": color.label,
      },
    })),
  },
];

const structuredData = createToolApplicationSchema({
  name: title,
  description: metaDescription,
  url: `${SITE_ORIGIN}${tool.href}`,
});
---

<BaseLayout
  {title}
  {metaDescription}
  {ogImage}
  {structuredData}
  robots="index, follow"
  breadcrumbLabels={{
    tools: "Tools",
    "stuck-pixel-fixer": "Stuck Pixel Fixer",
  }}
>
  <section>
    <div class="mb-6 grid gap-4">
      <div>
        <h1>Stuck Pixel Diagnosis and Repair Tool</h1>
        <p>
          Check a fixed screen point against different background colors to
          identify stuck, hot, or dead pixels and attempting recovery when a
          pixel appears stuck. Color cycles change at most 3 times per second in
          full-screen mode and for spots larger than 140 px; spots of 140 px or
          smaller may cycle up to 10 times per second, and Static Noise
          refreshes at up to 30 frames per second. Reduced-motion preferences
          lower the fastest settings. These limits reduce risk but are not a
          substitute for a professional flash analysis.
          The Diagnose option compares each marked area across multiple test
          colors and classifies the likely issue; Auto then runs locally
          rendered Static Noise on each stuck or hot pixel and explains why it
          skips the rest, and Manual Override offers Static
          Noise or RGB, CMY, and B/W color cycles. It cannot guarantee recovery
          or repair dead black pixels,
          permanent OLED burn-in, horizontal lines, screen cracks, or physical
          impact damage.
        </p>
      </div>
    </div>

    <div class="tool-page-shell">
      <div class="tool-page-main">
        <ToolRuntime
          shellId="pixel-test-shell"
          fullscreenButtonId="pixel-fullscreen"
          stageVariant="tall"
          controlsAutoHide={true}
          fullscreenButtonMuted={true}
          fullscreenScreenTouch="none"
          screenOverflow="visible"
          actionBarLabel="Run controls"
          dockPrimaryItemCount={4}
          buttons={[
            {
              label: "Diagnose",
              attributes: { id: "pixel-diagnose" },
            },
            {
              label: "Play",
              tone: "success",
              disabled: true,
              attributes: { id: "pixel-start" },
            },
            {
              label: "Reset",
              tone: "danger",
              attributes: { id: "pixel-stop" },
            },
          ]}
          stats={[
            {
              label: "Timer",
              value: "05:00",
              className: "run-timer",
              valueAttributes: { id: "pixel-countdown" },
            },
          ]}
        >
          <div
            id="pixel-stage"
            class="pixel-stage"
            data-running="false"
            data-mode="spot"
            data-warning-hidden="false"
            data-warning-acknowledged="false"
            data-pattern="static"
            data-spot-placed="false"
          >
            <div
              id="pixel-warning"
              class="pixel-warning absolute inset-0 z-8 rounded-2xl bg-custom-100 p-4 transition-opacity duration-200 dark:bg-custom-700"
              role="dialog"
              aria-modal="false"
              tabindex="-1"
              aria-labelledby="pixel-warning-title"
              aria-describedby="pixel-warning-info"
            >
              <div
                class="grid h-full w-full justify-items-center overflow-y-auto overscroll-contain touch-pan-y touch-pinch-zoom"
              >
                <div
                  class="border-accent-line from-accent-wash rounded-2xl my-auto w-full max-w-xl border bg-linear-to-b to-custom-100 p-5 text-slate-800 dark:to-custom-700 dark:text-slate-200"
                >
                  <h2
                    id="pixel-warning-title"
                    class="text-body mb-4 rounded-xl bg-linear-to-b from-red-400 to-red-600 px-3 py-2 text-center text-white"
                  >
                    PHOTOSENSITIVITY WARNING
                  </h2>
                  <p
                    id="pixel-warning-info"
                    class="text-small text-custom-800 dark:text-custom-200 mb-4"
                  >
                    This helper can flash saturated colors rapidly. Do not use
                    it if flashing lights or high-contrast patterns trigger
                    seizures, migraines, dizziness, nausea, or visual
                    discomfort.
                  </p>
                  <details
                    id="pixel-warning-details"
                    class="text-small text-custom-800 dark:text-custom-200 mb-4"
                  >
                    <summary class="cursor-pointer font-medium"
                      >Safety Tips</summary
                    >
                    <ul class="text-xsmall mt-2 mb-2 grid gap-2 pl-4">
                      <li class="leading-relaxed">
                        Use it in a well-lit room and sit back from the
                        screen.
                      </li>
                      <li class="leading-relaxed">
                        Prefer movable spot mode before trying full-screen
                        mode.
                      </li>
                      <li class="leading-relaxed">
                        Stop immediately if you feel any discomfort.
                      </li>
                    </ul>
                  </details>
                  <label
                    class="text-small border-accent-line mb-4 flex items-start gap-2 rounded-2xl border p-2"
                  >
                    <input
                      id="pixel-warning-ack"
                      class="text-accent-ink mt-0.5 h-5 w-5 shrink-0 accent-current"
                      type="checkbox"
                    />
                    <span>I understand and want to continue</span>
                  </label>
                  <button
                    type="button"
                    id="pixel-warning-button"
                    class="btn-base text-small ml-auto w-fit disabled:cursor-not-allowed disabled:opacity-50"
                    disabled
                  >
                    Show Test Area
                  </button>
                </div>
              </div>
            </div>

            <div
              id="pixel-diagnosis-instruct"
              class="pixel-diagnosis-instruct absolute inset-0 z-8 grid place-items-center p-4"
              data-visible="false"
              role="dialog"
              aria-modal="false"
              tabindex="-1"
              aria-labelledby="pixel-diagnosis-instruct-title"
            >
              <div
                class="border-accent-line shadow-accent-glow relative grid w-full max-w-sm gap-3 max-h-full overflow-y-auto overscroll-contain rounded-2xl border bg-custom-100 p-4 text-center shadow-md sm:max-w-md lg:max-w-lg dark:bg-custom-700"
              >
                <span
                  id="pixel-diagnosis-instruct-progress"
                  class="text-2xsmall absolute top-3 right-3 font-bold text-slate-500 dark:text-slate-400"
                  >1/5</span
                >
                <h2
                  id="pixel-diagnosis-instruct-title"
                  class="text-body mb-0 px-10 text-slate-800 dark:text-slate-200"
                >
                </h2>
                <p
                  id="pixel-diagnosis-instruct-body"
                  class="text-small text-custom-800 dark:text-custom-200 mb-0"
                >
                </p>
                <div class="flex flex-wrap justify-center gap-2">
                  <button
                    type="button"
                    id="pixel-diagnosis-begin"
                    class="btn-base text-small"
                  >
                    Yes
                  </button>
                </div>
                <button
                  type="button"
                  data-diagnosis-cancel
                  class="text-2xsmall text-slate-500 underline"
                >
                  Cancel diagnosis
                </button>
              </div>
            </div>

            <div
              id="pixel-diagnosis-countdown"
              class="pixel-diagnosis-countdown"
              hidden
              aria-live="polite"
              tabindex="-1"
            >
            </div>

            <div
              id="pixel-diagnosis-confirm"
              class="pixel-diagnosis-confirm absolute inset-0 z-8 grid place-items-center p-4"
              data-visible="false"
              role="dialog"
              aria-modal="false"
              tabindex="-1"
              aria-labelledby="pixel-diagnosis-confirm-title"
            >
              <div
                class="border-accent-line shadow-accent-glow relative grid w-full max-w-sm gap-3 max-h-full overflow-y-auto overscroll-contain rounded-2xl border bg-custom-100 p-4 text-center shadow-md sm:max-w-md lg:max-w-lg dark:bg-custom-700"
              >
                <span
                  id="pixel-diagnosis-confirm-progress"
                  class="text-2xsmall absolute top-3 right-3 font-bold text-slate-500 dark:text-slate-400"
                  >1/5</span
                >
                <h2
                  id="pixel-diagnosis-confirm-title"
                  class="text-body mb-0 px-10 text-slate-800 dark:text-slate-200"
                >
                </h2>
                <p
                  id="pixel-diagnosis-confirm-body"
                  class="text-small text-custom-800 dark:text-custom-200 mb-0"
                >
                </p>
                <div
                  id="pixel-diagnosis-confirm-clean"
                  class="flex flex-wrap justify-center gap-2"
                >
                  <button
                    type="button"
                    id="pixel-diagnosis-check-again"
                    class="btn-base text-small"
                  >
                    Repeat
                  </button>
                  <button
                    type="button"
                    id="pixel-diagnosis-no-issue"
                    class="btn-base text-small"
                  >
                    No Issue
                  </button>
                </div>
                <div
                  id="pixel-diagnosis-confirm-marked"
                  class="flex flex-wrap justify-center gap-2"
                >
                  <button
                    type="button"
                    id="pixel-diagnosis-redo"
                    class="btn-base text-small"
                  >
                    Redo
                  </button>
                  <button
                    type="button"
                    id="pixel-diagnosis-confirm-next"
                    class="btn-base text-small"
                  >
                    Next Color
                  </button>
                </div>
                <button
                  type="button"
                  data-diagnosis-cancel
                  class="text-2xsmall text-slate-500 underline"
                >
                  Cancel Diagnosis
                </button>
              </div>
            </div>

            <div
              id="pixel-followup"
              class="pixel-diagnosis-confirm pixel-followup absolute inset-0 z-8 grid justify-items-center p-4"
              data-visible="false"
              data-place="top"
              role="dialog"
              aria-modal="false"
              tabindex="-1"
              aria-labelledby="pixel-followup-title"
            >
              <div
                class="border-accent-line shadow-accent-glow relative grid w-full max-w-sm gap-3 max-h-full overflow-y-auto overscroll-contain rounded-2xl border bg-custom-100 p-4 text-center shadow-md sm:max-w-md lg:max-w-lg dark:bg-custom-700"
              >
                <span
                  id="pixel-followup-progress"
                  class="text-2xsmall absolute top-3 right-3 font-bold text-slate-500 dark:text-slate-400"
                  >1/1</span
                >
                <h2
                  id="pixel-followup-title"
                  class="text-body mb-0 px-10 text-slate-800 dark:text-slate-200"
                >
                </h2>
                <p
                  id="pixel-followup-body"
                  class="text-small text-custom-800 dark:text-custom-200 mb-0"
                >
                </p>
                <div class="flex flex-wrap justify-center gap-2">
                  <button
                    type="button"
                    id="pixel-followup-no"
                    class="btn-base text-small"
                  >
                    Not visible
                  </button>
                  <button
                    type="button"
                    id="pixel-followup-yes"
                    class="btn-base text-small"
                  >
                    Visible
                  </button>
                </div>
                <button
                  type="button"
                  data-diagnosis-cancel
                  class="text-2xsmall text-slate-500 underline"
                >
                  Cancel Diagnosis
                </button>
              </div>
            </div>

            <div
              id="pixel-check"
              class="pixel-diagnosis-confirm pixel-followup absolute inset-0 z-8 grid justify-items-center p-4"
              data-visible="false"
              data-place="top"
              role="dialog"
              aria-modal="false"
              tabindex="-1"
              aria-labelledby="pixel-check-title"
            >
              <div
                class="border-accent-line shadow-accent-glow relative grid w-full max-w-sm gap-3 max-h-full overflow-y-auto overscroll-contain rounded-2xl border bg-custom-100 p-4 text-center shadow-md sm:max-w-md lg:max-w-lg dark:bg-custom-700"
              >
                <span
                  id="pixel-check-progress"
                  class="text-2xsmall absolute top-3 right-3 font-bold text-slate-500 dark:text-slate-400"
                ></span>
                <h2
                  id="pixel-check-title"
                  class="text-body mb-0 px-10 text-slate-800 dark:text-slate-200"
                >
                </h2>
                <p
                  id="pixel-check-body"
                  class="text-small text-custom-800 dark:text-custom-200 mb-0"
                >
                </p>
                <div
                  id="pixel-check-answer"
                  class="flex flex-wrap justify-center gap-2"
                >
                  <button
                    type="button"
                    id="pixel-check-gone"
                    class="btn-base text-small"
                  >
                    Gone
                  </button>
                  <button
                    type="button"
                    id="pixel-check-still"
                    class="btn-base text-small"
                  >
                    Still there
                  </button>
                </div>
                <div
                  id="pixel-check-longer"
                  class="flex flex-wrap justify-center gap-2"
                  hidden
                >
                  {
                    LONGER_ROUND_MINUTES.map((minutes) => (
                      <button
                        type="button"
                        data-longer-minutes={minutes}
                        class="btn-base text-small"
                      >
                        {minutes} min
                      </button>
                    ))
                  }
                </div>
                <button
                  type="button"
                  id="pixel-check-done"
                  class="btn-base text-small justify-self-center"
                  hidden
                >
                  Done
                </button>
              </div>
            </div>

            <div
              id="pixel-pause-notice"
              class="bg-custom-100 dark:bg-custom-700 border-accent-line shadow-accent-glow pointer-events-none absolute top-1/2 left-1/2 z-9 grid w-[min(18rem,calc(100%-2rem))] -translate-x-1/2 -translate-y-1/2 gap-1 rounded-2xl border px-4 py-3 text-center shadow-md"
              hidden
              role="status"
              aria-live="polite"
            >
              <strong class="text-small leading-tight text-slate-800 dark:text-slate-200"
                >Paused</strong
              >
              <span class="text-xsmall leading-snug text-slate-700 dark:text-slate-300"
                >Press Resume to continue in fullscreen.</span
              >
            </div>

            <div class="pixel-pattern-status" aria-live="polite">
              <span
                id="pixel-state"
                class="text-small text-slate-200 leading-tight">Ready</span
              >
              <strong
                id="pixel-detail"
                class="text-xsmall text-slate-300 uppercase">Static Noise</strong
              >
            </div>

            <div id="pixel-spot" class="pixel-spot" aria-hidden="true"></div>
            <canvas
              id="pixel-noise-canvas"
              class="pixel-noise-canvas"
              aria-hidden="true"></canvas>
          </div>

          <div
            slot="dockTabs"
            id="pixel-workflow-tabs"
            class="pl-3 -mx-3 -mt-4 flex w-[calc(100%+1.5rem)] items-start justify-start gap-4 sm:pl-4 sm:-mx-4 sm:-mt-5 sm:w-[calc(100%+2rem)]"
            role="tablist"
            aria-label="Repair workflow"
          >
            <button
              type="button"
              id="pixel-auto-tab"
              class="pixel-workflow-tab"
              role="tab"
              aria-selected="true"
              aria-controls="pixel-auto-controls"
              data-workflow-tab="auto"
            >
              Auto
            </button>
            <button
              type="button"
              id="pixel-manual-tab"
              class="pixel-workflow-tab"
              role="tab"
              aria-selected="false"
              aria-controls="pixel-manual-controls"
              data-workflow-tab="manual"
              tabindex="-1"
            >
              Manual
            </button>
          </div>

          <p slot="dockLead" id="pixel-dock-tip" class="mb-0">
            Diagnose the screen, choose one time per mark, then press Play.
          </p>

          <div slot="dockPrimary" class="grid gap-3">
            <div
              id="pixel-diagnosis-summary"
              class="to-custom-100 dark:to-custom-700 border-accent-line from-accent-wash grid gap-1 rounded-2xl border bg-linear-to-b p-3 text-left"
              aria-live="polite"
              hidden
            >
              <div class="flex items-start justify-between gap-3">
                <strong
                  id="pixel-diagnosis-summary-title"
                  class="text-xsmall text-custom-800 dark:text-custom-200"
                >
                  Diagnosis
                </strong>
                <span
                  id="pixel-diagnosis-summary-count"
                  class="text-2xsmall text-accent-ink shrink-0 font-bold"
                ></span>
              </div>
              <p
                id="pixel-diagnosis-summary-body"
                class="text-2xsmall text-custom-700 dark:text-custom-300 mb-0"
              ></p>
            </div>

            <div class="grid grid-cols-2 gap-2 sm:gap-3">
              <div
                id="pixel-auto-controls"
                class="grid content-start gap-1 text-left"
                role="tabpanel"
                aria-labelledby="pixel-auto-tab"
              >
                <label
                  for="pixel-auto-mark"
                  class="text-xsmall grid gap-1 leading-tight font-bold tracking-widest uppercase"
                >
                  Marked Location
                </label>
                <div class="relative">
                  <select
                    id="pixel-auto-mark"
                    class="pixel-visible-select"
                    disabled
                  >
                    <option value="">Diagnose First</option>
                  </select>
                  <svg
                    class="pixel-visible-select-icon"
                    aria-hidden="true"
                  >
