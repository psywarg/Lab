    function focusModal(
      panel: HTMLElement,
      preferredTarget?: HTMLElement | null,
    ): void {
      requestAnimationFrame(() => {
        const target =
          preferredTarget ?? visibleFocusableElements(panel)[0] ?? panel;
        target.focus();
      });
    }

    function isolateStageModal(panel: HTMLElement | null): void {
      if (!stage) return;
      const activeBranch = panel
        ? Array.from(stage.children).find(
            (child) => child === panel || child.contains(panel),
          )
        : null;
      Array.from(stage.children).forEach((child) => {
        if (child instanceof HTMLElement) {
          child.inert = activeBranch !== null && child !== activeBranch;
        }
      });
    }

    function handleModalKeydown(event: KeyboardEvent): void {
      const panel = event.currentTarget as HTMLDivElement;
      if (event.key === "Escape") {
        if (panel === checkPanel) {
          event.preventDefault();
          finishResultCheck();
        } else if (panel !== warningPanel) {
          event.preventDefault();
          cancelDiagnosis();
          diagnoseButton?.focus();
