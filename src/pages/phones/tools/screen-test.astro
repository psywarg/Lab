        swatch:
          "linear-gradient(90deg, red, yellow, lime, cyan, blue, magenta, red)",
        meta: "hue cycle, ~14s/rotation",
      },
      {
        id: "burnin-bars",
        label: "Sliding Bars",
        kind: "burnin-bars",
        bg: "#000000",
        swatch:
          "repeating-linear-gradient(90deg,#ef4444 0 12.5%,#f97316 12.5% 25%,#eab308 25% 37.5%,#22c55e 37.5% 50%,#3b82f6 50% 62.5%,#8b5cf6 62.5% 75%,#ec4899 75% 87.5%,#fff 87.5% 100%)",
        meta: "8 bars sliding",
