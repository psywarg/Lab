        id: "near-white-gradient",
        label: "Near White Gradient",
        kind: "gradient-near-white",
        bg: "#ffffff",
        swatch: "linear-gradient(90deg, #dfdfdf, #ffffff)",
        meta: "#dfdfdf -> #ffffff",
