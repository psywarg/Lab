---
// src/pages/phones/tools/screen-test.astro

export const prerender = true;

import { getToolBySlug } from "@/content/phones/tools";
import ToolReference from "@/components/phones/tools/Reference.astro";
import ToolSidebar from "@/components/phones/tools/Sidebar.astro";
import ToolRuntime from "@/components/phones/tools/Runtime.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteIcons from "@/assets/icons/site-sprites.svg?url";
import ToolIcons from "@/assets/icons/tools-sprites.svg?url";
import { createToolApplicationSchema, SITE_ORIGIN } from "@/utils/site/schema";

const tool = getToolBySlug("screen-test");
const ogImage = tool.image.src;
const title = "Free Online Screen Test: Color, Banding, Sharpness & Gamma";
const metaDescription =
  "Run an online screen test with full-screen color, grayscale, gradient, banding, sharpness, black and white level, motion, image retention, and gamma patterns.";

const referenceItems = [
  {
    label: "Set up",
    check:
      "Clean the screen, choose a fixed normal brightness, and disable automatic display changes such as auto-brightness, True Tone or adaptive color, Night Shift or a blue-light filter, and color filters before judging color, uniformity, clipping, or gamma.",
    reading:
      "These settings can change color or intensity while a pattern is displayed, making comparisons unreliable. Keep browser zoom at its normal setting and test in stable room lighting.",
    good: "Brightness and color stay fixed as the patterns change.",
    concern:
      "Color temperature or brightness changes during the test, or a tint appears only while a system filter is enabled.",
  },
  {
    label: "Colors",
    check: "Run the solid colors at normal and high brightness.",
    reading:
      "Each solid color lights a different combination of red, green, and blue sub-pixels. A defect that stays in the same screen position across several colors is more likely to be a panel issue.",
    good: "The full screen stays even, with no fixed bright or dark dots.",
    concern:
      "A dot, line, tint patch, or corner glow stays visible across colors.",
  },
  {
    label: "Greys",
    check: "Move through 5% to 95% grey in a dim room.",
    reading:
      "The percentage runs from nearly black toward nearly white. Grey should remain neutral, so colored clouds or uneven bright areas reveal tint and uniformity differences.",
    good: "Grey looks neutral and evenly lit from edge to edge.",
    concern: "Green, pink, yellow, cloudy, or darker zones stand out.",
  },
  {
    label: "Gradients",
    check: "Use radial gradients, ramps, hue spectrum, and saturation grid.",
    reading:
      "A gradient should change continuously. Visible rings, stripes, or sudden color steps are banding or posterization rather than intentional pattern boundaries.",
    good: "Transitions look smooth with clean color changes and no harsh rings.",
    concern:
      "You see color banding, sudden jumps, posterization, or uneven saturation.",
  },
  {
    label: "Patterns",
    check:
      "Use edge frame, checkerboards, stripes, diagonal lines, and crosshatch.",
    reading:
      "The repeated lines and squares provide known geometry, rendered at your screen's actual pixel grid rather than an approximation. Compare their width, spacing, and visibility from the center to every edge and corner.",
    good: "Lines stay straight, spacing looks consistent, and edges are not cropped.",
    concern:
      "Patterns shimmer badly, warp, blur, or disappear in parts of the screen.",
  },
  {
    label: "Banding",
    check: "Compare 16, 32, and 64 steps in grey, red, green, and blue.",
    reading:
      "These patterns intentionally contain separate brightness steps. The number is how many steps are shown; neighboring steps merging together indicates lost tonal detail.",
    good: "Each step is visible and spacing feels consistent across the panel.",
    concern:
      "Several steps merge together, or one color channel bands much worse.",
  },
  {
    label: "Sharpness",
    check:
      "Use the text pattern and inspect letters from normal viewing distance.",
    reading:
      "Clean letter edges test pixel-level focus and sub-pixel rendering. Colored outlines, doubled strokes, or fuzzy edges make sharpness problems easier to see.",
    good: "Characters look crisp with no color fringes, blur, or uneven rendering.",
    concern: "Letters look fuzzy, doubled, jagged, or tinted around the edges.",
  },
  {
    label: "Shadow detail",
    check:
      "Use black level and near-black gradient with brightness set for normal use.",
    reading:
      "Near-black steps are deliberately only slightly brighter than black. Distinguishing more early steps means the display preserves more dark-scene detail instead of crushing it.",
    good: "Low values separate gradually instead of turning into one black block.",
    concern:
      "The first visible steps are crushed, tinted, or flicker while viewing.",
  },
  {
    label: "Highlights",
    check:
      "Use white saturation and near-white gradient without maxing brightness.",
    reading:
      "Near-white steps are deliberately only slightly dimmer than white. Separate visible steps mean bright detail is preserved instead of clipping into one white block.",
    good: "Bright steps remain distinct and whites do not look heavily tinted.",
    concern:
      "Light steps clip into one flat white area or show a strong color cast.",
  },
  {
    label: "Image retention & motion",
    check:
      "Play the color wash, bars, checker flip, or gradient sweep in a dim room, ideally full screen.",
    reading:
      "Moving patterns make a fixed patch easier to notice while also revealing response trails, flicker, or panel non-uniformity. Recheck any mark on several solid colors to distinguish temporary image retention from possible permanent burn-in.",
    good: "Uniform fields stay even, and moving patterns show no fixed shadow or unusual trail.",
    concern:
      "A patch, band, or logo-shaped mark remains in the same place across multiple fields.",
  },
  {
    label: "Gamma check",
    check:
      "Open Visual Gamma and step through candidate values until the center patch disappears into the surrounding stripes.",
    reading:
      "The striped border is a fixed reference; only the center patch changes as you step. The candidate that blends in is a visual estimate of your screen's effective gamma. This page does not calibrate the display.",
    good: "One candidate clearly blends the patch into the stripes.",
    concern:
      "Nothing blends cleanly, which usually means auto-brightness or True Tone is shifting the display while you test.",
  },
];

type PatternItem = {
  id: string;
  label: string;
  kind: string;
  bg: string;
  meta: string;
  swatch?: string;
  swatchText?: string;
  swatchTextColor?: string;
};

type PatternGroup = {
  label: string;
  patterns: PatternItem[];
};

const patternGroups: PatternGroup[] = [
  {
    label: "Colors",
    patterns: [
      {
        id: "black",
        label: "Black",
        kind: "solid",
        bg: "#000000",
        meta: "#000000",
      },
      {
        id: "white",
        label: "White",
        kind: "solid",
        bg: "#ffffff",
        meta: "#ffffff",
      },
      {
        id: "red",
        label: "Red",
        kind: "solid",
        bg: "#ff0000",
        meta: "#ff0000",
      },
      {
        id: "green",
        label: "Green",
        kind: "solid",
        bg: "#00ff00",
        meta: "#00ff00",
      },
      {
        id: "blue",
        label: "Blue",
        kind: "solid",
        bg: "#0000ff",
        meta: "#0000ff",
      },
      {
        id: "cyan",
        label: "Cyan",
        kind: "solid",
        bg: "#00ffff",
        meta: "#00ffff",
      },
      {
        id: "magenta",
        label: "Magenta",
        kind: "solid",
        bg: "#ff00ff",
        meta: "#ff00ff",
      },
      {
        id: "yellow",
        label: "Yellow",
        kind: "solid",
        bg: "#ffff00",
        meta: "#ffff00",
      },
    ],
  },
  {
    label: "Greys",
    patterns: [
      {
        id: "gray-5",
        label: "5%",
        kind: "solid",
        bg: "oklch(5% 0 0)",
        meta: "oklch(5% 0 0)",
      },
      {
        id: "gray-15",
        label: "15%",
        kind: "solid",
        bg: "oklch(15% 0 0)",
        meta: "oklch(15% 0 0)",
      },
      {
        id: "gray-25",
        label: "25%",
        kind: "solid",
        bg: "oklch(25% 0 0)",
        meta: "oklch(25% 0 0)",
      },
      {
        id: "gray-35",
        label: "35%",
        kind: "solid",
        bg: "oklch(35% 0 0)",
        meta: "oklch(35% 0 0)",
      },
      {
        id: "gray-45",
        label: "45%",
        kind: "solid",
        bg: "oklch(45% 0 0)",
        meta: "oklch(45% 0 0)",
      },
      {
        id: "gray-50-srgb",
        label: "50% sRGB",
        kind: "solid",
        bg: "#808080",
        meta: "#808080",
      },
      {
        id: "gray-55",
        label: "55%",
        kind: "solid",
        bg: "oklch(55% 0 0)",
        meta: "oklch(55% 0 0)",
      },
      {
        id: "gray-65",
        label: "65%",
        kind: "solid",
        bg: "oklch(65% 0 0)",
        meta: "oklch(65% 0 0)",
      },
      {
        id: "gray-75",
        label: "75%",
        kind: "solid",
        bg: "oklch(75% 0 0)",
        meta: "oklch(75% 0 0)",
      },
      {
        id: "gray-85",
        label: "85%",
        kind: "solid",
        bg: "oklch(85% 0 0)",
        meta: "oklch(85% 0 0)",
      },
      {
        id: "gray-95",
        label: "95%",
        kind: "solid",
        bg: "oklch(95% 0 0)",
        meta: "oklch(95% 0 0)",
      },
    ],
  },
  {
    label: "Gradients",
    patterns: [
      {
        id: "radial-gray",
        label: "Radial Grey",
        kind: "gradient-radial",
        bg: "#808080",
        swatch: "radial-gradient(circle, #fff, #777, #000)",
        meta: "radial grey",
      },
      {
        id: "radial-red",
        label: "Radial Red",
        kind: "gradient-radial-red",
        bg: "#4d0000",
        swatch: "radial-gradient(circle, #ff0000, #4d0000, #000)",
        meta: "radial red",
      },
      {
        id: "radial-green",
        label: "Radial Green",
        kind: "gradient-radial-green",
        bg: "#004d00",
        swatch: "radial-gradient(circle, #00ff00, #004d00, #000)",
        meta: "radial green",
      },
      {
        id: "radial-blue",
        label: "Radial Blue",
        kind: "gradient-radial-blue",
        bg: "#00004d",
        swatch: "radial-gradient(circle, #0000ff, #00004d, #000)",
        meta: "radial blue",
      },
      {
        id: "gray-ramp",
        label: "Grey Ramp",
        kind: "gradient-gray-ramp",
        bg: "#808080",
        swatch: "linear-gradient(90deg, #000, #fff)",
        meta: "#000000 -> #ffffff",
      },
      {
        id: "red-ramp",
        label: "Red Ramp",
        kind: "gradient-red-ramp",
        bg: "#800000",
        swatch: "linear-gradient(90deg, #000, #ff0000)",
        meta: "#000000 -> #ff0000",
      },
      {
        id: "green-ramp",
        label: "Green Ramp",
        kind: "gradient-green-ramp",
        bg: "#008000",
        swatch: "linear-gradient(90deg, #000, #00ff00)",
        meta: "#000000 -> #00ff00",
      },
      {
        id: "blue-ramp",
        label: "Blue Ramp",
        kind: "gradient-blue-ramp",
        bg: "#000080",
        swatch: "linear-gradient(90deg, #000, #0000ff)",
        meta: "#000000 -> #0000ff",
      },
      {
        id: "hue-spectrum",
        label: "Hue Spectrum",
        kind: "gradient-hue",
        bg: "#ff0000",
        swatch:
          "linear-gradient(90deg, red, yellow, lime, cyan, blue, magenta, red)",
        meta: "hue ramp",
      },
      {
        id: "saturation-grid",
        label: "Saturation Grid",
        kind: "saturation-grid",
        bg: "#808080",
        swatch: "linear-gradient(90deg, #fff, #f00, #0f0, #00f)",
        meta: "hue x saturation",
      },
    ],
  },
  {
    label: "Patterns",
    patterns: [
      {
        id: "edges",
        label: "Edge Frame",
        kind: "edges",
        bg: "#000000",
        swatch:
          "linear-gradient(#fff,#fff) 0 0/100% 2px no-repeat,linear-gradient(#fff,#fff) 0 100%/100% 2px no-repeat,linear-gradient(#fff,#fff) 0 0/2px 100% no-repeat,linear-gradient(#fff,#fff) 100% 0/2px 100% no-repeat,#000",
        meta: "edge frame",
      },
      {
        id: "checker-ansi",
        label: "ANSI 4x4",
        kind: "checker-ansi",
        bg: "#000000",
        swatch:
          "conic-gradient(from 90deg,#fff 0 25%,#000 0 50%,#fff 0 75%,#000 0) center/50% 50%",
        meta: "4x4 checker",
      },
      {
        id: "crosshatch",
        label: "Crosshatch Grid",
        kind: "crosshatch-grid",
        bg: "#000000",
        swatch:
          "repeating-linear-gradient(0deg,#fff 0 1px,transparent 1px 4px),repeating-linear-gradient(90deg,#fff 0 1px,transparent 1px 4px),#000",
