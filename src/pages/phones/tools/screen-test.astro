        bg: "#000000",
        swatch:
          "linear-gradient(90deg,#000 0 12%,#050505 12% 24%,#0a0a0a 24% 36%,#101010 36% 48%,#161616 48% 60%,#1c1c1c 60% 72%,#222 72% 84%,#2a2a2a 84% 100%)",
        meta: "OKLCH L 0-14%",
