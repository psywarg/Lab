      },
      {
        id: "lines-vertical",
        label: "Vertical Stripes",
        kind: "lines-vertical",
        bg: "#000000",
        swatch: "repeating-linear-gradient(90deg,#fff 0 2px,#000 2px 4px)",
        meta: "1 device px per stripe",
      },
      {
        id: "lines-horizontal",
        label: "Horizontal Stripes",
        kind: "lines-horizontal",
        bg: "#000000",
        swatch: "repeating-linear-gradient(180deg,#fff 0 2px,#000 2px 4px)",
        meta: "1 device px per stripe",
      },
      {
        id: "lines-diagonal",
        label: "Diagonal Lines",
        kind: "lines-diagonal",
        bg: "#000000",
        swatch: "repeating-linear-gradient(135deg,#fff 0 2px,#000 2px 5px)",
        meta: "1 device px period",
      },
      {
        id: "checker-1",
        label: "1px Checker",
        kind: "checker-1",
        bg: "#000000",
        swatch:
          "conic-gradient(from 90deg,#fff 0 25%,#000 0 50%,#fff 0 75%,#000 0) center/4px 4px",
        meta: "1 device px cell",
      },
      {
        id: "checker-2",
        label: "2px Checker",
        kind: "checker-2",
        bg: "#000000",
        swatch:
          "conic-gradient(from 90deg,#fff 0 25%,#000 0 50%,#fff 0 75%,#000 0) center/8px 8px",
        meta: "2 device px cell",
      },
    ],
  },
  {
    label: "Banding",
    patterns: [
      {
        id: "steps-16",
        label: "16 Steps",
        kind: "steps-16",
        bg: "#000000",
        swatch:
          "linear-gradient(90deg,#000 0 6.25%,#111 6.25% 12.5%,#222 12.5% 18.75%,#333 18.75% 25%,#444 25% 31.25%,#555 31.25% 37.5%,#666 37.5% 43.75%,#777 43.75% 50%,#888 50% 56.25%,#999 56.25% 62.5%,#aaa 62.5% 68.75%,#bbb 68.75% 75%,#ccc 75% 81.25%,#ddd 81.25% 87.5%,#eee 87.5% 93.75%,#fff 93.75% 100%)",
        meta: "16 levels",
      },
      {
        id: "steps-32",
        label: "32 Steps",
        kind: "steps-32",
        bg: "#000000",
        swatch:
          "repeating-linear-gradient(90deg,#0a0a0a 0 3.125%,#171717 3.125% 6.25%,#242424 6.25% 9.375%,#313131 9.375% 12.5%,#3f3f3f 12.5% 15.625%,#4c4c4c 15.625% 18.75%,#595959 18.75% 21.875%,#666 21.875% 25%,#737373 25% 28.125%,#808080 28.125% 31.25%,#8d8d8d 31.25% 34.375%,#9a9a9a 34.375% 37.5%,#a7a7a7 37.5% 40.625%,#b4b4b4 40.625% 43.75%,#c1c1c1 43.75% 46.875%,#cecece 46.875% 50%)",
        meta: "32 levels",
      },
      {
        id: "steps-64",
        label: "64 Steps",
        kind: "steps-64",
        bg: "#000000",
        swatch:
          "repeating-linear-gradient(90deg,#000 0 2px,#111 2px 4px,#222 4px 6px,#333 6px 8px,#444 8px 10px,#555 10px 12px,#666 12px 14px,#777 14px 16px)",
        meta: "64 levels",
      },
    ],
  },
  {
    label: "Sharpness",
    patterns: [
      {
        id: "text-sharpness",
        label: "Text Sharpness",
        kind: "text-sharpness",
        bg: "#ffffff",
        swatch: "#ffffff",
        swatchText: "T",
        swatchTextColor: "#111111",
        meta: "small text",
      },
    ],
