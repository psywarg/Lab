{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.ts",
    "eslint.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*"
  ],
  "exclude": ["dist", "node_modules", ".wrangler"]
}
